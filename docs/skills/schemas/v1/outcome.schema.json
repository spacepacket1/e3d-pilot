{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome.schema.json",
  "title": "Outcome v1 (calibration)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_id",
    "use_id",
    "result",
    "tier",
    "reported_by",
    "evidence_ref",
    "supersedes",
    "reported_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "e3d.outcome/v1",
      "x-code": "skill_schema_version_unsupported"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^out_[0-9a-zA-Z]{4,40}$"
    },
    "use_id": {
      "type": "string",
      "pattern": "^use_[0-9a-zA-Z]{4,40}$"
    },
    "result": {
      "enum": [
        "worked",
        "failed",
        "unknown"
      ]
    },
    "tier": {
      "enum": [
        "verified",
        "user_marked",
        "host_reported",
        "inferred"
      ]
    },
    "reported_by": {
      "enum": [
        "user",
        "host",
        "system"
      ]
    },
    "evidence_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^out_[0-9a-zA-Z]{4,40}$"
        }
      ]
    },
    "reported_at": {
      "$ref": "common.schema.json#/$defs/time"
    }
  }
}
