{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spacepacket1/e3d-pilot/blob/main/docs/external-auth/settle.response.schema.json",
  "title": "settle response",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ok",
        "code"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "const": "conflict"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  ]
}
