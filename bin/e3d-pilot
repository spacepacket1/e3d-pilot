#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SCHEMA_FILE="$REPO_ROOT/config.schema.json"
DISCOVER_PREVIOUS_RUN_ID=""
PILOT_FOCUS=""
FOCUS_DEFAULT="default"
NEGOTIATE_EXIT_NEEDS_HUMAN=3
EXECUTE_EXIT_NEEDS_HUMAN=4
REVIEW_EXIT_VERIFY_FAILED=5

# shellcheck source=lib/providers/common.sh
source "$REPO_ROOT/lib/providers/common.sh"
# shellcheck source=lib/ideas/ledger.sh
source "$REPO_ROOT/lib/ideas/ledger.sh"
# shellcheck source=lib/ideas/materialize.sh
source "$REPO_ROOT/lib/ideas/materialize.sh"
# shellcheck source=lib/ideas/project_tracking.sh
source "$REPO_ROOT/lib/ideas/project_tracking.sh"
# shellcheck source=lib/training/export.sh
source "$REPO_ROOT/lib/training/export.sh"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
e3d-pilot

Usage:
  e3d-pilot --help
  e3d-pilot config validate <repo>
  e3d-pilot run --repo <path> --stage <name> [--run-id <id>] [--focus default|revenue]
  e3d-pilot ideas ingest --repo <path> --run-id <id> --candidate-id <id> --candidate-json <file>
  e3d-pilot ideas transition --repo <path> <idea-id> <event> [--actor <actor>] [--note <text>] [--targets-json <file>] [--head-sha <sha>]
  e3d-pilot ideas rebuild --repo <path>
  e3d-pilot ideas list --repo <path> [--status <status>] [--json]
  e3d-pilot ideas show --repo <path> <idea-id> [--json]
  e3d-pilot ideas approve --repo <path> <idea-id> [--actor <actor>] [--note <text>]
  e3d-pilot ideas reject --repo <path> <idea-id> --reason <text> [--actor <actor>]
  e3d-pilot ideas request-changes --repo <path> <idea-id> --reason <text> [--actor <actor>]
  e3d-pilot ideas sync --repo <path> [<idea-id>]
  e3d-pilot ideas outcome --repo <path> <idea-id> --window <7d|30d|custom> --metric <key=value>... [--note <text>]
  e3d-pilot ideas mark-reverted --repo <path> <idea-id> --reason <text>
  e3d-pilot ideas implement --repo <path> <idea-id>
  e3d-pilot ideas implement-approved --repo <path>
  e3d-pilot ideas repair-run --repo <path> --run-id <run-id> [--from-stage <stage>] <idea-id>
  e3d-pilot ideas approve-merge --repo <path> <idea-id> [--actor <actor>] [--note <text>]
  e3d-pilot ideas merge --repo <path> <idea-id>
  e3d-pilot providers list
  e3d-pilot fleet <repos.json>
  e3d-pilot fleet discover <repos.json> [--run-id <id>] [--focus default|revenue] [--config <path>]
  e3d-pilot fleet ideas <fleet.json> ingest --run-id <id> --candidate-id <id> --candidate-json <file>
  e3d-pilot fleet ideas <fleet.json> transition <idea-id> <event> [--actor <actor>] [--note <text>] [--targets-json <file>] [--head-sha <sha>]
  e3d-pilot fleet ideas <fleet.json> rebuild
  e3d-pilot fleet ideas <fleet.json> list [--status <status>] [--json]
  e3d-pilot fleet ideas <fleet.json> show <idea-id> [--json]
  e3d-pilot fleet ideas <fleet.json> approve <idea-id> [--actor <actor>] [--note <text>]
  e3d-pilot fleet ideas <fleet.json> reject <idea-id> --reason <text> [--actor <actor>]
  e3d-pilot fleet ideas <fleet.json> request-changes <idea-id> --reason <text> [--actor <actor>]
  e3d-pilot fleet ideas <fleet.json> sync [<idea-id>]
  e3d-pilot fleet ideas <fleet.json> outcome <idea-id> --window <7d|30d|custom> --metric <key=value>... [--note <text>]
  e3d-pilot fleet ideas <fleet.json> implement <idea-id> [--continue-on-target-failure]
  e3d-pilot fleet ideas <fleet.json> implement-approved [--continue-on-target-failure]
  e3d-pilot fleet ideas <fleet.json> approve-merge <idea-id> [--actor <actor>] [--note <text>]
  e3d-pilot fleet ideas <fleet.json> merge <idea-id>
  e3d-pilot fleet ideas <fleet.json> merge-approved
  e3d-pilot fleet train readiness <fleet.json> [--since <RFC3339>]
  e3d-pilot fleet train export <fleet.json> [--week <YYYY-Www>] [--output <dir>]
  e3d-pilot fleet prs [<repos.json>]
  e3d-pilot fleet prs --approve <repo>
  e3d-pilot fleet prs --merge   <repo>
  e3d-pilot fleet prs --close   <repo>
  e3d-pilot web --repo <path> [--repo <path> ...] [--port <n>]

Run stages:
  discover
  ideate
  draft
  negotiate
  execute
  review
  publish
  all

Runs are isolated, negotiated, verified, and published through a configured
forge backend. Use `fleet` to process multiple repositories independently.

--focus revenue switches discover/ideate to a revenue-first pass: discover
adds a Monetization Signals subsection, ideate ranks candidates by Revenue
potential first (Attraction/Retention as tiebreak only, Revenue required).
Defaults to "default" (attraction/retention-first) and is inherited by later
stages of the same run unless passed again explicitly.

`fleet discover <repos.json>` is a portfolio-level pass across every repo in
the fleet file at once, looking specifically for ideas that require 2+ of
those repos together. It needs its own config (providers.discover/ideate) at
<dir of repos.json>/.e3d-pilot-fleet/config.json, or pass --config <path>.
State is written under .e3d-pilot-fleet/runs/<run-id>/ next to the fleet
file. This is discover+ideate only -- no draft/negotiate/execute/publish.

`web` is an optional dashboard across one or more repos' own idea ledgers
(not the fleet cross-repo ledger). Requires Node.js on PATH and
E3D_PILOT_WEB_AUTH_USER/E3D_PILOT_WEB_AUTH_PASS -- every other command needs
only Bash/git/jq/curl. See README for details.
EOF
}

slugify() {
  local input="$1"
  input="$(printf '%s' "$input" | tr '[:upper:]' '[:lower:]')"
  input="${input//[^a-z0-9._-]/-}"
  input="${input//--/-}"
  input="${input##[-.]}"
  input="${input%%[-.]}"
  if [[ -z "$input" ]]; then
    printf 'repo'
  else
    printf '%s' "$input"
  fi
}

repo_abs_path() {
  local repo="$1"
  [[ -d "$repo" ]] || die "repository not found: $repo"
  (cd "$repo" && pwd -P)
}

repo_paused_file() {
  printf '%s/.e3d-pilot/paused' "$1"
}

repo_is_paused() {
  [[ -f "$(repo_paused_file "$1")" ]]
}

ensure_repo_not_paused() {
  local repo="$1" stage="${2:-stage}"
  if repo_is_paused "$repo"; then
    die "$stage is paused because $(repo_paused_file "$repo") exists"
  fi
}

config_path_for_repo() {
  printf '%s/.e3d-pilot/config.json' "$1"
}

latest_run_path_for_repo() {
  printf '%s/.e3d-pilot/latest-run' "$1"
}

runs_dir_for_repo() {
  printf '%s/.e3d-pilot/runs' "$1"
}

repo_slug() {
  slugify "$(basename "$1")"
}

new_run_id() {
  local repo="$1"
  local base candidate counter runs_dir
  runs_dir="$(runs_dir_for_repo "$repo")"
  base="$(date +%Y-%m-%d)-$(repo_slug "$repo")"
  candidate="$base"
  counter=2
  while [[ -e "$runs_dir/$candidate" ]]; do
    candidate="${base}-${counter}"
    counter=$((counter + 1))
  done
  printf '%s' "$candidate"
}

write_latest_run() {
  local repo="$1" run_id="$2"
  mkdir -p "$(dirname "$(latest_run_path_for_repo "$repo")")"
  printf '%s\n' "$run_id" > "$(latest_run_path_for_repo "$repo")"
}

start_new_run() {
  local repo="$1" run_id run_dir
  run_id="$(new_run_id "$repo")"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"
  write_latest_run "$repo" "$run_id"
  printf '%s\n' "$run_id"
}

resolve_run_id() {
  local repo="$1" requested="${2:-}"
  if [[ -n "$requested" ]]; then
    mkdir -p "$(runs_dir_for_repo "$repo")/$requested"
    printf '%s\n' "$requested"
    return 0
  fi
  local latest_file
  latest_file="$(latest_run_path_for_repo "$repo")"
  [[ -f "$latest_file" ]] || die "no latest run recorded at $latest_file"
  local run_id
  run_id="$(<"$latest_file")"
  [[ -n "$run_id" ]] || die "latest run file is empty: $latest_file"
  printf '%s\n' "$run_id"
}

validate_focus_value() {
  local focus="$1"
  case "$focus" in
    default|revenue) return 0 ;;
    *) die "invalid --focus value: $focus (expected: default or revenue)" ;;
  esac
}

focus_file_for_run_dir() {
  printf '%s/focus' "$1"
}

# Focus is per-run, not per-invocation: a run's focus is decided once (by
# whichever stage runs first for that run-id, normally discover) and every
# later stage of the same run -- even invoked from a separate CLI call, e.g.
# a standalone `--stage ideate` -- inherits it silently unless --focus is
# passed again explicitly, in which case it overwrites what's on disk.
resolve_focus() {
  local run_dir="$1" requested="${2:-}" focus_file
  mkdir -p "$run_dir"
  focus_file="$(focus_file_for_run_dir "$run_dir")"
  if [[ -n "$requested" ]]; then
    validate_focus_value "$requested"
    printf '%s\n' "$requested" > "$focus_file"
    printf '%s' "$requested"
    return 0
  fi
  if [[ -f "$focus_file" ]]; then
    printf '%s' "$(<"$focus_file")"
    return 0
  fi
  printf '%s\n' "$FOCUS_DEFAULT" > "$focus_file"
  printf '%s' "$FOCUS_DEFAULT"
}

ensure_git_repo() {
  local repo="$1"
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository: $repo"
}

repo_head_sha() {
  local repo="$1"
  git -C "$repo" rev-parse HEAD 2>/dev/null || die "repository has no HEAD commit: $repo"
}

config_value() {
  local file="$1" filter="$2"
  jq -r "$filter" "$file"
}

findings_head_sha() {
  local file="$1"
  awk -F': ' '/^head_sha: / { print $2; exit }' "$file"
}

read_repo_text_file() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  cat "$file"
}

load_repo_docs_content() {
  local repo="$1" config_file="$2" docs_path doc candidate
  docs_path="$(config_value "$config_file" '.docs // empty')"
  if [[ -n "$docs_path" && "$docs_path" != "null" ]]; then
    if [[ -f "$repo/$docs_path" ]]; then
      printf '### %s\n' "$docs_path"
      printf '```text\n'
      read_repo_text_file "$repo/$docs_path"
      printf '\n```\n'
    else
      printf '### %s\n- skipped: configured docs file not found\n' "$docs_path"
    fi
    return 0
  fi

  for candidate in AGENTS.md CLAUDE.md README.md; do
    doc="$repo/$candidate"
    if [[ -f "$doc" ]]; then
      printf '### %s\n' "$candidate"
      printf '```text\n'
      read_repo_text_file "$doc"
      printf '\n```\n'
    fi
  done
}

load_repo_todo_fixes() {
  local repo="$1" matches
  matches="$(grep -rn \
    --exclude-dir=.git --exclude-dir=.e3d-pilot \
    --exclude-dir=node_modules --exclude-dir=build --exclude-dir=dist \
    --exclude-dir=.next --exclude-dir=out --exclude-dir=coverage \
    --exclude-dir=vendor --exclude-dir=target \
    --exclude-dir=.venv --exclude-dir=venv --exclude-dir=__pycache__ \
    -e 'TODO' -e 'FIXME' "$repo" 2>/dev/null \
    | awk '{ if (length($0) > 300) print substr($0, 1, 300) " ... [truncated]"; else print }' \
    | head -n 200 || true)"
  if [[ -n "$matches" ]]; then
    printf '```text\n%s\n```\n' "$matches"
  else
    printf -- '- none found\n'
  fi
}

load_git_branch_summary() {
  local repo="$1" branches
  branches="$(git -C "$repo" branch --all --no-color --verbose 2>/dev/null || true)"
  if [[ -n "$branches" ]]; then
    printf '```text\n%s\n```\n' "$branches"
  else
    printf -- '- none found\n'
  fi
}

load_git_log_summary() {
  local repo="$1" previous_findings="$2" lookback="$3" head_sha previous_sha range_desc log_output
  head_sha="$(repo_head_sha "$repo")"
  if [[ -n "$previous_findings" && -f "$previous_findings" ]]; then
    previous_sha="$(findings_head_sha "$previous_findings")"
    if [[ -n "$previous_sha" ]]; then
      range_desc="${previous_sha}..HEAD"
      log_output="$(git -C "$repo" log --format='%h %s' "$range_desc" 2>/dev/null || true)"
      if [[ -n "$log_output" ]]; then
        printf 'range: `%s`\n' "$range_desc"
        printf '```text\n%s\n```\n' "$log_output"
        return 0
      fi
    fi
  fi

  range_desc="last ${lookback} commits"
  log_output="$(git -C "$repo" log --format='%h %s' -n "$lookback" 2>/dev/null || true)"
  printf 'range: %s\n' "$range_desc"
  if [[ -n "$log_output" ]]; then
    printf '```text\n%s\n```\n' "$log_output"
  else
    printf -- '- no commits found\n'
  fi
}

repo_has_remote() {
  local repo="$1"
  git -C "$repo" remote | grep -q '.'
}

provider_availability_probe() {
  local script="$1" output status
  set +e
  output="$(E3D_PILOT_CHECK=1 "$script" 2>&1)"
  status=$?
  set -e
  printf '%s' "$output"
  return "$status"
}

gh_local_facts() {
  local repo="$1" output issues prs
  if ! repo_has_remote "$repo"; then
    printf 'skipped: no git remote configured\n'
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    printf 'skipped: gh CLI not available\n'
    return 0
  fi
  if ! gh auth status >/dev/null 2>&1; then
    printf 'skipped: gh is not authenticated\n'
    return 0
  fi
  if ! (cd "$repo" && gh repo view >/dev/null 2>&1); then
    printf 'skipped: git remote is not recognized by gh\n'
    return 0
  fi

  issues="$(cd "$repo" && gh issue list --limit 20 2>/dev/null || true)"
  prs="$(cd "$repo" && gh pr list --limit 20 2>/dev/null || true)"
  printf '### gh issue list\n'
  if [[ -n "$issues" ]]; then
    printf '```text\n%s\n```\n' "$issues"
  else
    printf -- '- none found\n'
  fi
  printf '### gh pr list\n'
  if [[ -n "$prs" ]]; then
    printf '```text\n%s\n```\n' "$prs"
  else
    printf -- '- none found\n'
  fi
}

discover_previous_run_findings_path() {
  local repo="$1" previous_run_id="${DISCOVER_PREVIOUS_RUN_ID:-}"
  [[ -n "$previous_run_id" ]] || return 1
  local path
  path="$(runs_dir_for_repo "$repo")/$previous_run_id/findings.md"
  [[ -f "$path" ]] || return 1
  printf '%s' "$path"
}

DEFAULT_ANALOGY_DOMAINS=(
  "game progression and reward loops"
  "social feed and notification mechanics"
  "marketplace liquidity and two-sided matching"
  "developer-tool CLI ergonomics"
  "fintech trust and verification UX"
)

# Config carries analogy_domains as data (like research_topics); this just
# resolves it to a newline-separated list, falling back to the built-in
# default when the target repo's config omits or empties the field.
analogy_domains_list() {
  local config_file="$1" raw
  raw="$(jq -r 'if (has("analogy_domains") and (.analogy_domains | length) > 0) then (.analogy_domains | join("\n")) else empty end' "$config_file")"
  if [[ -n "$raw" ]]; then
    printf '%s\n' "$raw"
  else
    printf '%s\n' "${DEFAULT_ANALOGY_DOMAINS[@]}"
  fi
}

build_discover_facts_markdown() {
  local repo="$1" config_file="$2" facts_file="$3" previous_findings="$4"
  local head_sha research_topics
  head_sha="$(repo_head_sha "$repo")"
  research_topics="$(config_value "$config_file" '.research_topics')"
  {
    printf 'Repo head sha: %s\n\n' "$head_sha"
    printf 'Research topics: %s\n\n' "$research_topics"
    printf 'Analogy domains to consider: %s\n\n' "$(analogy_domains_list "$config_file" | paste -sd ';' - | sed 's/;/; /g')"
    printf '## Git history\n'
    load_git_log_summary "$repo" "$previous_findings" "${HISTORY_LOOKBACK_COMMITS:-20}"
    printf '\n## Branches\n'
    load_git_branch_summary "$repo"
    printf '\n## GH issues and PRs\n'
    gh_local_facts "$repo"
    printf '\n## Repo docs\n'
    load_repo_docs_content "$repo" "$config_file"
    printf '\n## TODO/FIXME matches\n'
    load_repo_todo_fixes "$repo"
  } > "$facts_file"
}

build_discover_prompt() {
  local facts_file="$1" prompt_file="$2" focus="${3:-$FOCUS_DEFAULT}"
  {
    printf 'You are producing the "External Context" section of a repo findings report.\n'
    printf 'Keep it short and focused on the current state of the art relevant to the repo.\n\n'
    printf 'Return markdown bullet points or short paragraphs only.\n\n'
    printf 'Also include a distinct "### Analogous Patterns" subsection: pick the 2-3\n'
    printf 'most transferable entries from the "Analogy domains to consider" line in the\n'
    printf 'local facts below for this specific repo, and for each one name the source\n'
    printf 'domain, the mechanic being borrowed, and one concrete sentence on how it\n'
    printf 'could apply here. The goal is to seed ideation with cross-domain metaphors,\n'
    printf 'not just incremental extensions of what the repo already does.\n\n'
    if [[ "$focus" == "revenue" ]]; then
      printf 'This is a revenue-focused discover pass: also include a distinct\n'
      printf '"### Monetization Signals" subsection covering (a) any monetization\n'
      printf 'mechanisms already visible in this repo'"'"'s code, config, or docs (payment\n'
      printf 'flows, pricing tiers, credits, subscriptions, tokens, fees) and (b) 2-3\n'
      printf 'monetization models from adjacent industries that could extend or combine\n'
      printf 'with what already exists here. Be concrete about the mechanism, not generic\n'
      printf '("freemium") -- name how it would actually plug into this repo.\n\n'
    fi
    printf 'Local facts:\n\n'
    cat "$facts_file"
  } > "$prompt_file"
}

write_findings_markdown() {
  local head_sha="$1" facts_file="$2" external_context_file="$3" findings_file="$4" focus="${5:-$FOCUS_DEFAULT}"
  {
    printf -- '---\n'
    printf 'head_sha: %s\n' "$head_sha"
    printf 'focus: %s\n' "$focus"
    printf -- '---\n\n'
    printf '# Findings\n\n'
    printf '## Local State\n\n'
    cat "$facts_file"
    printf '\n## External Context\n\n'
    cat "$external_context_file"
    printf '\n'
  } > "$findings_file"
}

discover_stage() {
  local repo="$1" run_id="$2" run_dir config_file head_sha facts_file prompt_file external_context_file findings_file previous_findings provider provider_script provider_output provider_status provider_error focus
  ensure_git_repo "$repo"
  config_file="$(config_path_for_repo "$repo")"
  validate_config_file "$config_file"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"
  head_sha="$(repo_head_sha "$repo")"
  previous_findings=""
  if previous_findings="$(discover_previous_run_findings_path "$repo" 2>/dev/null)"; then
    :
  else
    previous_findings=""
  fi
  focus="$(resolve_focus "$run_dir" "${PILOT_FOCUS:-}")"

  facts_file="$run_dir/discover-local-state.md"
  prompt_file="$run_dir/discover-prompt.md"
  external_context_file="$run_dir/discover-external-context.md"
  findings_file="$run_dir/findings.md"

  build_discover_facts_markdown "$repo" "$config_file" "$facts_file" "$previous_findings"
  build_discover_prompt "$facts_file" "$prompt_file" "$focus"

  provider="$(config_value "$config_file" '.providers.discover')"
  provider_script="$REPO_ROOT/lib/providers/$provider"
  [[ -x "$provider_script" ]] || die "discover provider script missing or not executable: $provider_script"

  set +e
  provider_output="$(cd "$repo" && E3D_PILOT_DRY_RUN=0 "$provider_script" "$prompt_file" 2>"$run_dir/discover-provider.stderr")"
  provider_status=$?
  set -e
  if [[ $provider_status -ne 0 ]]; then
    provider_error=""
    if [[ -s "$run_dir/discover-provider.stderr" ]]; then
      provider_error="$(<"$run_dir/discover-provider.stderr")"
    fi
    if [[ $provider_status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
      die "discover provider unavailable: ${provider_error:-$provider}"
    fi
    die "discover provider failed: ${provider_error:-$provider}"
  fi

  printf '%s\n' "$provider_output" > "$external_context_file"
  write_findings_markdown "$head_sha" "$facts_file" "$external_context_file" "$findings_file" "$focus"
  printf '%s\n' "$run_id"
}

gh_availability_reason() {
  local repo="$1"
  if ! repo_has_remote "$repo"; then
    printf 'no git remote configured'
    return 1
  fi
  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh CLI not available'
    return 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    printf 'gh is not authenticated'
    return 1
  fi
  if ! (cd "$repo" && gh repo view >/dev/null 2>&1); then
    printf 'git remote is not recognized by gh'
    return 1
  fi
  return 0
}

ideate_gh_pr_list() {
  local repo="$1" reason prs
  if ! reason="$(gh_availability_reason "$repo")"; then
    printf 'skipped: %s\n' "$reason"
    return 0
  fi
  prs="$(cd "$repo" && gh pr list --state all --limit 50 2>/dev/null || true)"
  if [[ -n "$prs" ]]; then
    printf '```text\n%s\n```\n' "$prs"
  else
    printf -- '- none found\n'
  fi
}

load_prior_runs_content() {
  local repo="$1" current_run_id="$2" runs_dir dir run_name found
  runs_dir="$(runs_dir_for_repo "$repo")"
  found=0
  if [[ -d "$runs_dir" ]]; then
    for dir in "$runs_dir"/*/; do
      [[ -d "$dir" ]] || continue
      run_name="$(basename "$dir")"
      [[ "$run_name" == "$current_run_id" ]] && continue
      if [[ -f "$dir/candidates.md" ]]; then
        found=1
        printf '### %s/candidates.md\n```text\n' "$run_name"
        cat "$dir/candidates.md"
        printf '\n```\n'
      fi
      if [[ -f "$dir/spec-final.md" ]]; then
        found=1
        printf '### %s/spec-final.md\n```text\n' "$run_name"
        cat "$dir/spec-final.md"
        printf '\n```\n'
      fi
    done
  fi
  [[ $found -eq 1 ]] || printf -- '- none found\n'
}

build_ideate_facts_markdown() {
  local repo="$1" run_dir="$2" run_id="$3" facts_file="$4" findings_file
  findings_file="$run_dir/findings.md"
  {
    printf '## Current Findings\n\n```text\n'
    cat "$findings_file"
    printf '\n```\n'
    printf '\n## Git Branches\n'
    load_git_branch_summary "$repo"
    printf '\n## GH PR List (state: all)\n'
    ideate_gh_pr_list "$repo"
    printf '\n## Prior Runs (candidates.md / spec-final.md)\n'
    load_prior_runs_content "$repo" "$run_id"
  } > "$facts_file"
}

build_ideate_prompt() {
  local facts_file="$1" prompt_file="$2" focus="${3:-$FOCUS_DEFAULT}"
  {
    printf 'You are the ideate stage of an autonomous repo-improvement pipeline.\n'
    printf 'Propose 3-5 ranked candidate ideas (most valuable first) for what this repo\n'
    printf 'should work on next, based on the findings and dedup context below.\n\n'
    printf 'For EACH candidate you must explicitly check it against the git branches, the\n'
    printf 'PR list (when available), and past runs candidates/specs listed below, and\n'
    printf 'state plainly whether it duplicates something that already exists.\n\n'
    if [[ "$focus" == "revenue" ]]; then
      printf 'This ideate run is explicitly focused on revenue-generating ideas. Draw on\n'
      printf 'the findings'"'"' "Analogous Patterns" and (when present) "Monetization\n'
      printf 'Signals" subsections where they apply. Candidates may be net-new\n'
      printf 'monetization surfaces as well as extensions of existing functionality --\n'
      printf 'both are valid, and duplicate-checking still applies equally to either kind.\n\n'
    else
      printf 'This project'"'"'s primary goal is attracting and retaining users; revenue is\n'
      printf 'secondary. Draw on the findings'"'"' "Analogous Patterns" subsection where it\n'
      printf 'applies, and consider ideas spanning multiple categories (data usefulness,\n'
      printf 'workflow-in-UI, social, gamification, testing, marketing, selling) when good\n'
      printf 'ones exist for each -- but never force a weak or duplicate idea into a\n'
      printf 'category just for coverage.\n\n'
    fi
    printf 'Respond using exactly this format, one block per candidate:\n\n'
    printf '### Candidate <N>: <short title>\n'
    printf 'Duplicate: yes|no\n'
    printf 'Dedup rationale: <cite the specific branch/PR/run you checked, or say why not>\n'
    printf 'Category: data|workflow|social|gamification|testing|marketing|selling|other\n'
    printf 'Analogy: <source domain> -- <how it transfers, or "none" if not applicable>\n'
    printf 'Attraction (1-5): <score, new-user pull>\n'
    printf 'Retention (1-5): <score, repeat-engagement value>\n'
    printf 'Effort: low|medium|high\n'
    if [[ "$focus" == "revenue" ]]; then
      printf 'Revenue (1-5): <score, primary ranking signal for this revenue-focused run -- never answer "n/a">\n'
      printf 'Description: <what to build, the monetization mechanism, and why>\n\n'
      printf 'Rank non-duplicate candidates primarily by Revenue (highest first);\n'
      printf 'Attraction + Retention may only break ties between otherwise-equal Revenue\n'
      printf 'candidates and must never let a lower-Revenue candidate outrank a higher\n'
      printf 'one.\n\n'
    else
      printf 'Revenue (1-5|n/a): <score, secondary -- never outranks Attraction+Retention>\n'
      printf 'Description: <what to build and why>\n\n'
      printf 'Rank non-duplicate candidates primarily by Attraction + Retention (highest\n'
      printf 'first); Revenue may only break ties between otherwise-equal candidates and\n'
      printf 'must never let a lower Attraction + Retention candidate outrank a higher one.\n\n'
    fi
    printf 'After all candidates, end your response with exactly this block: choose the\n'
    printf 'highest-ranked candidate that is NOT a duplicate as "selected", using the\n'
    printf 'literal value "none" only if every candidate is a duplicate of existing work.\n\n'
    printf -- '---IDEATE-STATUS---\n'
    printf 'selected: candidate-<N> | none\n'
    printf 'reason: <one line>\n\n'
    printf 'Context:\n\n'
    cat "$facts_file"
  } > "$prompt_file"
}

write_candidates_markdown() {
  local selected="$1" reason="$2" facts_file="$3" response_file="$4" candidates_file="$5" warnings_file="${6:-}" focus="${7:-$FOCUS_DEFAULT}"
  {
    printf -- '---\n'
    printf 'selected: %s\n' "$selected"
    printf 'reason: %s\n' "$reason"
    printf 'focus: %s\n' "$focus"
    printf -- '---\n\n'
    printf '# Candidates\n\n'
    if [[ -n "$warnings_file" && -s "$warnings_file" ]]; then
      printf '## Validation Warnings\n\n'
      while IFS= read -r line; do
        [[ -n "$line" ]] && printf -- '- %s\n' "$line"
      done < "$warnings_file"
      printf '\n'
    fi
    printf '## Dedup Context\n\n'
    cat "$facts_file"
    printf '\n## Proposed Candidates\n\n'
    cat "$response_file"
    printf '\n'
  } > "$candidates_file"
}

# Prompt-only requirements ("propose 3-5 candidates", "each with a dedup
# rationale") aren't otherwise enforced anywhere, so a model that ignores them
# would go unnoticed. This is a soft check: it records warnings (surfaced in
# candidates.md and stdout) rather than failing the stage, since neither the
# spec nor Phase 4's acceptance criteria treat this as a hard rejection like
# Phase 5's protected_paths guard.
ideate_validate_candidates() {
  local response_file="$1" warnings_file="$2" focus="${3:-$FOCUS_DEFAULT}"
  : > "$warnings_file"

  local count
  count="$(grep -cE '^### Candidate [0-9]+:' "$response_file" || true)"
  if (( count < 3 || count > 5 )); then
    printf 'expected 3-5 candidates, got %s\n' "$count" >> "$warnings_file"
  fi

  local current_num="" current_rationale=""
  local has_category=0 has_analogy=0 has_attraction=0 has_retention=0 has_effort=0 has_revenue=0 line

  while IFS= read -r line; do
    if [[ "$line" =~ ^###\ Candidate\ ([0-9]+): ]]; then
      if [[ -n "$current_num" ]]; then
        [[ -n "$current_rationale" ]] || printf 'Candidate %s is missing a Dedup rationale\n' "$current_num" >> "$warnings_file"
        (( has_category )) || printf 'Candidate %s is missing a Category field\n' "$current_num" >> "$warnings_file"
        (( has_analogy )) || printf 'Candidate %s is missing an Analogy field\n' "$current_num" >> "$warnings_file"
        (( has_attraction )) || printf 'Candidate %s is missing an Attraction score\n' "$current_num" >> "$warnings_file"
        (( has_retention )) || printf 'Candidate %s is missing a Retention score\n' "$current_num" >> "$warnings_file"
        (( has_effort )) || printf 'Candidate %s is missing an Effort field\n' "$current_num" >> "$warnings_file"
        if [[ "$focus" == "revenue" ]]; then
          (( has_revenue )) || printf 'Candidate %s is missing a numeric Revenue score (required in a revenue-focused run)\n' "$current_num" >> "$warnings_file"
        fi
      fi
      current_num="${BASH_REMATCH[1]}"
      current_rationale=""
      has_category=0; has_analogy=0; has_attraction=0; has_retention=0; has_effort=0; has_revenue=0
    elif [[ -n "$current_num" ]]; then
      if [[ "$line" =~ ^Dedup\ rationale:[[:space:]]*(.*)$ ]]; then
        current_rationale="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^Category:[[:space:]]*(.+)$ ]]; then
        has_category=1
      elif [[ "$line" =~ ^Analogy:[[:space:]]*(.+)$ ]]; then
        has_analogy=1
      elif [[ "$line" =~ ^Attraction.*:[[:space:]]*[0-9] ]]; then
        has_attraction=1
      elif [[ "$line" =~ ^Retention.*:[[:space:]]*[0-9] ]]; then
        has_retention=1
      elif [[ "$line" =~ ^Effort:[[:space:]]*(.+)$ ]]; then
        has_effort=1
      elif [[ "$line" =~ ^Revenue.*:[[:space:]]*[0-9] ]]; then
        has_revenue=1
      fi
    fi
  done < "$response_file"
  if [[ -n "$current_num" ]]; then
    [[ -n "$current_rationale" ]] || printf 'Candidate %s is missing a Dedup rationale\n' "$current_num" >> "$warnings_file"
    (( has_category )) || printf 'Candidate %s is missing a Category field\n' "$current_num" >> "$warnings_file"
    (( has_analogy )) || printf 'Candidate %s is missing an Analogy field\n' "$current_num" >> "$warnings_file"
    (( has_attraction )) || printf 'Candidate %s is missing an Attraction score\n' "$current_num" >> "$warnings_file"
    (( has_retention )) || printf 'Candidate %s is missing a Retention score\n' "$current_num" >> "$warnings_file"
    (( has_effort )) || printf 'Candidate %s is missing an Effort field\n' "$current_num" >> "$warnings_file"
    if [[ "$focus" == "revenue" ]]; then
      (( has_revenue )) || printf 'Candidate %s is missing a numeric Revenue score (required in a revenue-focused run)\n' "$current_num" >> "$warnings_file"
    fi
  fi

  [[ ! -s "$warnings_file" ]]
}

ideate_stage() {
  local repo="$1" run_id="$2" run_dir config_file findings_file facts_file prompt_file focus
  local provider provider_script provider_output provider_status provider_error
  local candidates_file selected reason
  ensure_git_repo "$repo"
  config_file="$(config_path_for_repo "$repo")"
  validate_config_file "$config_file"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"

  findings_file="$run_dir/findings.md"
  [[ -f "$findings_file" ]] || die "ideate requires findings.md for run $run_id; run discover first"
  focus="$(resolve_focus "$run_dir" "${PILOT_FOCUS:-}")"

  facts_file="$run_dir/ideate-facts.md"
  prompt_file="$run_dir/ideate-prompt.md"
  candidates_file="$run_dir/candidates.md"

  build_ideate_facts_markdown "$repo" "$run_dir" "$run_id" "$facts_file"
  build_ideate_prompt "$facts_file" "$prompt_file" "$focus"

  provider="$(config_value "$config_file" '.providers.ideate')"
  provider_script="$REPO_ROOT/lib/providers/$provider"
  [[ -x "$provider_script" ]] || die "ideate provider script missing or not executable: $provider_script"

  set +e
  provider_output="$(cd "$repo" && E3D_PILOT_DRY_RUN=0 "$provider_script" "$prompt_file" 2>"$run_dir/ideate-provider.stderr")"
  provider_status=$?
  set -e
  if [[ $provider_status -ne 0 ]]; then
    provider_error=""
    if [[ -s "$run_dir/ideate-provider.stderr" ]]; then
      provider_error="$(<"$run_dir/ideate-provider.stderr")"
    fi
    if [[ $provider_status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
      die "ideate provider unavailable: ${provider_error:-$provider}"
    fi
    die "ideate provider failed: ${provider_error:-$provider}"
  fi

  printf '%s\n' "$provider_output" > "$run_dir/ideate-response.md"

  selected="$(ideate_status_field "selected" <<<"$provider_output" || true)"
  reason="$(ideate_status_field "reason" <<<"$provider_output" || true)"
  [[ -n "$selected" ]] || die "ideate provider response missing ---IDEATE-STATUS--- selected field"

  local warnings_file="$run_dir/ideate-warnings.txt"
  if ! ideate_validate_candidates "$run_dir/ideate-response.md" "$warnings_file" "$focus"; then
    printf 'ideate: warning: candidate response did not fully match the expected format:\n'
    while IFS= read -r line; do
      [[ -n "$line" ]] && printf '  - %s\n' "$line"
    done < "$warnings_file"
  fi

  write_candidates_markdown "$selected" "$reason" "$facts_file" "$run_dir/ideate-response.md" "$candidates_file" "$warnings_file" "$focus"
  materialize_single_repo_ideas "$repo" "$run_dir" "$run_id" "$focus" >/dev/null
  printf '%s\n' "$run_id"
}

candidates_selected_field() {
  local file="$1"
  awk -F': ' '/^selected: / { print $2; exit }' "$file"
}

status_block_field() {
  local marker="$1" field="$2" in_block=0 line value
  while IFS= read -r line; do
    if [[ "$line" == "$marker" ]]; then
      in_block=1
      continue
    fi
    if [[ $in_block -eq 1 && "$line" == "${field}: "* ]]; then
      value="${line#"${field}: "}"
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

ideate_status_field() {
  status_block_field "---IDEATE-STATUS---" "$1"
}

draft_status_field() {
  status_block_field "---DRAFT-STATUS---" "$1"
}

extract_spec_fence() {
  local response_file="$1"
  awk '
    /^```spec[[:space:]]*$/ { capture=1; next }
    capture && /^```[[:space:]]*$/ { capture=0; next }
    capture { print }
  ' "$response_file"
}

load_repo_structure() {
  local repo="$1" tracked
  tracked="$(git -C "$repo" ls-files 2>/dev/null | head -300 || true)"
  if [[ -n "$tracked" ]]; then
    printf '```text\n%s\n```\n' "$tracked"
  else
    printf -- '- no tracked files found\n'
  fi
}

build_draft_facts_markdown() {
  local repo="$1" config_file="$2" candidates_file="$3" facts_file="$4"
  {
    printf '## Selected Candidate (candidates.md)\n\n```text\n'
    cat "$candidates_file"
    printf '\n```\n'
    printf '\n## Target Repo Tracked Files (truncated to 300)\n'
    load_repo_structure "$repo"
    printf '\n## Repo Docs\n'
    load_repo_docs_content "$repo" "$config_file"
    printf '\n## Configured Verification Commands\n\n'
    if jq -e '.verify | length > 0' "$config_file" >/dev/null 2>&1; then
      jq -r '.verify[] | "- `" + . + "`"' "$config_file"
    else
      printf -- '- none configured; use a focused check that is demonstrably supported by the tracked repository\n'
    fi
  } > "$facts_file"
}

build_draft_prompt() {
  local facts_file="$1" prompt_file="$2" conventions_file="$3" protected_paths_list="$4" max_diff_files="$5" max_diff_lines="$6"
  {
    printf 'You are the draft stage of an autonomous repo-improvement pipeline.\n'
    printf 'Turn the selected candidate below into a complete, csr-shaped phased\n'
    printf 'Markdown spec that codex-spec-runner (csr) can run without any hand-editing.\n\n'
    printf 'Follow these csr spec conventions exactly:\n\n'
    cat "$conventions_file"
    printf '\nHard requirements for your output:\n'
    printf -- '- Start with a "# <Title>" heading, then "## Overview", "## Goals",\n'
    printf '  "## Non-Goals", "## Existing Files", and "## Shared Constraints" sections.\n'
    printf -- '- Follow those with one or more numbered "## Phase N - Title" sections,\n'
    printf '  starting at Phase 1, each with "### Requirements" and\n'
    printf '  "### Acceptance Criteria" subsections.\n'
    printf -- '- Immediately under each phase heading, include exactly one\n'
    printf '  "<!-- runner:model=PROVIDER:MODEL -->" annotation where PROVIDER is\n'
    printf '  literally "codex" or "claude" (never "local", never anything else, and\n'
    printf '  never omitted).\n'
    printf -- '- Also under each phase heading, include one or more\n'
    printf '  "<!-- pilot:touches=<glob> -->" annotations (one per line, one glob per\n'
    printf '  annotation) naming every file/path glob that phase'"'"'s Requirements will\n'
    printf '  touch. Every phase must have at least one.\n'
    printf -- '- Add "<!-- runner:read=... -->" / "<!-- runner:verify=... -->"\n'
    printf '  annotations where useful, per the conventions above.\n'
    printf -- '- When configured verification commands are listed in Context, use those\n'
    printf '  commands for runner:verify annotations; do not invent a broader package\n'
    printf '  script that may already be broken on the unchanged repository.\n'
    printf -- '- None of the pilot:touches globs for any phase may match any of these\n'
    printf '  protected paths -- never propose modifying them:\n'
    printf '%s\n' "$protected_paths_list"
    printf -- '- Keep the whole spec scoped to plausibly fit within %s changed files and\n' "$max_diff_files"
    printf '  %s changed lines total across all phases.\n\n' "$max_diff_lines"
    printf 'Respond in exactly this shape:\n\n'
    printf 'If, and only if, you can scope this candidate to satisfy every hard\n'
    printf 'requirement above, wrap the complete spec Markdown in a fenced block\n'
    printf 'starting with ```spec and ending with ```, then follow it with exactly:\n\n'
    printf -- '---DRAFT-STATUS---\n'
    printf 'status: ok\n'
    printf 'reason: <one line>\n\n'
    printf 'If you cannot scope it that small, or it would require touching a\n'
    printf 'protected path, do NOT emit a ```spec block at all: respond with only\n'
    printf 'exactly:\n\n'
    printf -- '---DRAFT-STATUS---\n'
    printf 'status: too-large\n'
    printf 'reason: <one line explaining why it cannot be scoped>\n\n'
    printf 'Context:\n\n'
    cat "$facts_file"
  } > "$prompt_file"
}

draft_phase_pairs() {
  local spec_file="$1"
  awk '
    /^#{1,6}[[:space:]]+.*[Pp]hase[[:space:]]+[0-9]+/ {
      line = $0
      if (match(line, /[Pp]hase[[:space:]]+([0-9]+)/)) {
        rest = substr(line, RSTART, RLENGTH)
        gsub(/[^0-9]/, "", rest)
        print rest "\t" NR
      }
    }
  ' "$spec_file" | sort -n -k1,1
}

draft_phase_body() {
  local spec_file="$1" start="$2" end="$3"
  if [[ -n "$end" ]]; then
    sed -n "${start},$((end - 1))p" "$spec_file"
  else
    sed -n "${start},\$p" "$spec_file"
  fi
}

strip_recursive_wildcard() {
  # Turns "foo/**" -> "foo" and "**/*.env" -> "*.env" so a leading/trailing
  # "**" segment is also tried as matching zero directories -- bash's plain
  # pattern matching (used below) treats "**" as just another "*" and never
  # matches "zero directories" on its own, unlike gitignore/glob conventions.
  local p="$1"
  p="${p%/\*\*}"
  p="${p#\*\*/}"
  printf '%s' "$p"
}

glob_variants() {
  local p="$1"
  printf '%s\n' "$p"
  [[ "$p" == '**/'* ]] && printf '%s\n' "${p#\*\*/}"
  [[ "$p" == *'/**' ]] && printf '%s\n' "${p%/\*\*}"
}

touches_glob_conflicts_with_protected() {
  local touches="$1" protected="$2"
  local tv pv
  while IFS= read -r tv; do
    [[ -n "$tv" ]] || continue
    while IFS= read -r pv; do
      [[ -n "$pv" ]] || continue
      [[ "$touches" == $pv ]] && return 0
      [[ "$protected" == $tv ]] && return 0
      [[ "$tv" == $pv ]] && return 0
    done < <(glob_variants "$protected")
  done < <(glob_variants "$touches")

  # Bare-directory containment: a protected_paths (or touches) entry with no
  # glob metacharacters is meant to also cover everything nested under it
  # (e.g. protected="src/config" must also protect "src/config/db.json"),
  # even though neither string is literally a glob pattern of the other.
  local touches_base protected_base
  touches_base="$(strip_recursive_wildcard "$touches")"
  protected_base="$(strip_recursive_wildcard "$protected")"
  if [[ "$touches_base" != *['*?[']* && "$protected_base" != *['*?[']* ]]; then
    [[ "$touches_base" == "$protected_base" ]] && return 0
    [[ "$touches_base" == "$protected_base"/* ]] && return 0
    [[ "$protected_base" == "$touches_base"/* ]] && return 0
  fi

  return 1
}

draft_validate_spec() {
  local spec_file="$1" config_file="$2" violations_file="$3"
  local protected_paths=() line

  while IFS= read -r line; do
    [[ -n "$line" ]] && protected_paths+=("$line")
  done < <(jq -r '.protected_paths[]' "$config_file")

  : > "$violations_file"

  local required_section
  for required_section in 'Overview' 'Goals' 'Non-Goals' 'Existing Files' 'Shared Constraints'; do
    grep -qiE "^#{1,6}[[:space:]]+${required_section}([[:space:]]|\$)" "$spec_file" \
      || printf 'Missing required "## %s" section\n' "$required_section" >> "$violations_file"
  done
  grep -qE '^#[[:space:]]+[^#]' "$spec_file" \
    || printf 'Missing top-level "# <Title>" heading\n' >> "$violations_file"

  local pairs total_phases
  pairs="$(draft_phase_pairs "$spec_file")"
  if [[ -z "$pairs" ]]; then
    printf 'no "## Phase N - Title" headings found in drafted spec\n' >> "$violations_file"
    [[ ! -s "$violations_file" ]]
    return
  fi
  total_phases="$(printf '%s\n' "$pairs" | wc -l | tr -d '[:space:]')"

  local index=0 phase_number start_line
  while IFS=$'\t' read -r phase_number start_line; do
    index=$((index + 1))
    local end_line=""
    if [[ $index -lt $total_phases ]]; then
      end_line="$(printf '%s\n' "$pairs" | sed -n "$((index + 1))p" | cut -f2)"
    fi

    local body
    body="$(draft_phase_body "$spec_file" "$start_line" "$end_line")"

    local touches_lines model_lines
    touches_lines="$(printf '%s\n' "$body" | grep -oE '<!--[[:space:]]*pilot:touches=[^ ]+[[:space:]]*-->' || true)"
    if [[ -z "$touches_lines" ]]; then
      printf 'Phase %s: missing a pilot:touches annotation\n' "$phase_number" >> "$violations_file"
    fi

    model_lines="$(printf '%s\n' "$body" | grep -oE '<!--[[:space:]]*runner:model=[^ ]+[[:space:]]*-->' || true)"
    if [[ -z "$model_lines" ]]; then
      printf 'Phase %s: missing a runner:model annotation (must be codex or claude)\n' "$phase_number" >> "$violations_file"
    else
      local model_line value
      while IFS= read -r model_line; do
        [[ -n "$model_line" ]] || continue
        value="$(printf '%s\n' "$model_line" | sed -E 's/^<!--[[:space:]]*runner:model=([^ ]+)[[:space:]]*-->$/\1/')"
        if [[ "$value" == "local" || "$value" == local:* ]]; then
          printf 'Phase %s: runner:model references unsupported provider "local" (csr only dispatches codex/claude)\n' "$phase_number" >> "$violations_file"
        fi
      done <<< "$model_lines"
    fi

    if [[ -n "$touches_lines" ]]; then
      local touch_line glob protected
      while IFS= read -r touch_line; do
        [[ -n "$touch_line" ]] || continue
        glob="$(printf '%s\n' "$touch_line" | sed -E 's/^<!--[[:space:]]*pilot:touches=([^ ]+)[[:space:]]*-->$/\1/')"
        if [[ ${#protected_paths[@]} -gt 0 ]]; then
          for protected in "${protected_paths[@]}"; do
            if touches_glob_conflicts_with_protected "$glob" "$protected"; then
              printf 'Phase %s: pilot:touches "%s" matches protected_paths entry "%s"\n' "$phase_number" "$glob" "$protected" >> "$violations_file"
            fi
          done
        fi
      done <<< "$touches_lines"
    fi
  done <<< "$pairs"

  [[ ! -s "$violations_file" ]]
}

# Draft-time-only proxy for max_diff_files/max_diff_lines: at draft time there
# is no real diff yet, so this estimates scope from the drafted spec itself
# (distinct pilot:touches paths as a file-count proxy, Requirements/Acceptance
# Criteria bullet count x a configurable per-bullet line estimate as a
# line-count signal) rather than leaving scope entirely up to the model's own
# self-reported status. The file-count proxy is enforced here because declared
# touches map directly to files. The line estimate is advisory by default: a
# prose bullet is not a reliable predictor of implementation size, and the
# real diff ceiling below is authoritative. Set DRAFT_ENFORCE_LINE_ESTIMATE=1
# to restore hard rejection from the estimate. Intentionally NOT reused by
# execute_spec_guard:
# that guard re-checks protected_paths against the final spec exactly, while
# the real max_diff_files/max_diff_lines ceiling is enforced by execute_stage
# after csr runs, against the actual git diff -- this is only a pre-execution
# estimate to catch an obviously-too-big candidate before negotiate/execute.
draft_check_scope_ceiling() {
  local spec_file="$1" config_file="$2" violations_file="$3" warnings_file="${4:-}"
  local max_diff_files max_diff_lines lines_per_bullet enforce_line_estimate
  max_diff_files="$(config_value "$config_file" '.max_diff_files')"
  max_diff_lines="$(config_value "$config_file" '.max_diff_lines')"
  lines_per_bullet="${DRAFT_LINES_PER_REQUIREMENT_BULLET:-20}"
  enforce_line_estimate="${DRAFT_ENFORCE_LINE_ESTIMATE:-0}"

  [[ "$lines_per_bullet" =~ ^[0-9]+$ ]] || die "DRAFT_LINES_PER_REQUIREMENT_BULLET must be a non-negative integer"
  [[ "$enforce_line_estimate" == "0" || "$enforce_line_estimate" == "1" ]] \
    || die "DRAFT_ENFORCE_LINE_ESTIMATE must be 0 or 1"

  local pairs total_phases
  pairs="$(draft_phase_pairs "$spec_file")"
  [[ -n "$pairs" ]] || return 0
  total_phases="$(printf '%s\n' "$pairs" | wc -l | tr -d '[:space:]')"

  local -A all_touches_seen=()
  local requirement_bullet_count=0
  local index=0 phase_number start_line
  while IFS=$'\t' read -r phase_number start_line; do
    index=$((index + 1))
    local end_line=""
    if [[ $index -lt $total_phases ]]; then
      end_line="$(printf '%s\n' "$pairs" | sed -n "$((index + 1))p" | cut -f2)"
    fi

    local body
    body="$(draft_phase_body "$spec_file" "$start_line" "$end_line")"
    requirement_bullet_count=$((requirement_bullet_count + $(printf '%s\n' "$body" | grep -cE '^[[:space:]]*[-*][[:space:]]' || true)))

    local glob
    while IFS= read -r glob; do
      [[ -n "$glob" ]] || continue
      all_touches_seen["$glob"]=1
    done < <(printf '%s\n' "$body" | grep -oE '<!--[[:space:]]*pilot:touches=[^ ]+[[:space:]]*-->' | sed -E 's/^<!--[[:space:]]*pilot:touches=([^ ]+)[[:space:]]*-->$/\1/' || true)
  done <<< "$pairs"

  local unique_touches_count=${#all_touches_seen[@]}
  if [[ "$max_diff_files" =~ ^[0-9]+$ ]] && (( unique_touches_count > max_diff_files )); then
    printf 'Drafted spec declares %s distinct pilot:touches paths, exceeding max_diff_files=%s\n' \
      "$unique_touches_count" "$max_diff_files" >> "$violations_file"
  fi

  local estimated_lines=$(( requirement_bullet_count * lines_per_bullet ))
  if [[ "$max_diff_lines" =~ ^[0-9]+$ ]] && (( estimated_lines > max_diff_lines )); then
    local estimate_message
    estimate_message="Drafted spec has an estimated ~$estimated_lines changed lines ($requirement_bullet_count requirement/acceptance bullets x $lines_per_bullet lines/bullet), exceeding max_diff_lines=$max_diff_lines"
    if [[ "$enforce_line_estimate" == "1" ]]; then
      printf '%s\n' "$estimate_message" >> "$violations_file"
    elif [[ -n "$warnings_file" ]]; then
      printf '%s; advisory only (the actual post-execution diff ceiling remains enforced)\n' \
        "$estimate_message" >> "$warnings_file"
    fi
  fi

  [[ ! -s "$violations_file" ]]
}

execute_spec_guard() {
  local spec_file="$1" config_file="$2" violations_file="$3"
  draft_validate_spec "$spec_file" "$config_file" "$violations_file"
}

ensure_worktree() {
  local repo="$1" run_dir="$2" run_id="$3" branch worktree_dir start_ref
  branch="e3d-pilot/$run_id"
  worktree_dir="$(mktemp -d "${TMPDIR:-/tmp}/e3d-pilot.${run_id}.XXXXXX")"
  start_ref="HEAD"

  if ! git -C "$repo" worktree add -b "$branch" "$worktree_dir" "$start_ref" >/dev/null 2>&1; then
    rm -rf "$worktree_dir"
    die "failed to create execute worktree for branch $branch"
  fi

  # Git worktrees intentionally omit ignored dependency directories. Reuse a
  # dependency installation already prepared in the primary clone so csr's
  # phase-level verification can run without downloading packages on every
  # autonomous execution. The ignored symlink never enters the branch diff.
  if [[ -d "$repo/node_modules" && ! -e "$worktree_dir/node_modules" ]] \
    && git -C "$repo" check-ignore -q node_modules; then
    ln -s "$repo/node_modules" "$worktree_dir/node_modules"
  fi

  printf '%s\t%s\n' "$branch" "$worktree_dir" > "$run_dir/execute-worktree.txt"
  printf '%s' "$worktree_dir"
}

prepare_execute_spec_in_worktree() {
  local worktree_dir="$1" run_id="$2" source_spec="$3" worktree_run_dir target_spec
  worktree_run_dir="$worktree_dir/.e3d-pilot/runs/$run_id"
  target_spec="$worktree_run_dir/spec-final.md"
  mkdir -p "$worktree_run_dir"
  cp "$source_spec" "$target_spec"
  printf '%s' "$target_spec"
}

count_git_diff() {
  local worktree_dir="$1" diff_output untracked files_changed=0 lines_changed=0 add del path
  diff_output="$(git -C "$worktree_dir" diff --numstat --no-renames -- . 2>/dev/null || true)"
  while IFS=$'\t' read -r add del path; do
    [[ -n "$path" ]] || continue
    files_changed=$((files_changed + 1))
    if [[ "$add" != "-" ]]; then
      lines_changed=$((lines_changed + add))
    fi
    if [[ "$del" != "-" ]]; then
      lines_changed=$((lines_changed + del))
    fi
  done <<< "$diff_output"
  untracked="$(git -C "$worktree_dir" ls-files --others --exclude-standard 2>/dev/null || true)"
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    files_changed=$((files_changed + 1))
    if [[ -f "$worktree_dir/$path" ]]; then
      lines_changed=$((lines_changed + $(wc -l < "$worktree_dir/$path")))
    fi
  done <<< "$untracked"
  printf '%s\t%s\n' "$files_changed" "$lines_changed"
}

copy_csr_state_artifacts() {
  local worktree_dir="$1" run_dir="$2" csr_state_dir
  csr_state_dir="$worktree_dir/.codex-spec-runner"
  if [[ -d "$csr_state_dir" ]]; then
    rm -rf "$run_dir/csr-state"
    cp -R "$csr_state_dir" "$run_dir/csr-state"
  fi
}

execute_stage() {
  local repo="$1" run_id="$2" run_dir config_file spec_final_file violations_file worktree_dir branch
  local max_diff_files max_diff_lines diff_counts diff_files diff_lines csr_bin csr_stdout csr_stderr csr_status
  local worktree_spec_file csr_command_file

  ensure_git_repo "$repo"
  config_file="$(config_path_for_repo "$repo")"
  validate_config_file "$config_file"
  require_valid_implementation_approval "$repo" "$run_id" "execute"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"

  spec_final_file="$run_dir/spec-final.md"
  [[ -f "$spec_final_file" ]] || die "execute requires spec-final.md for run $run_id; run negotiate first"

  violations_file="$run_dir/execute-guard-violations.txt"
  if ! execute_spec_guard "$spec_final_file" "$config_file" "$violations_file"; then
    {
      printf 'execute: rejected spec-final.md before csr was invoked because it violates protected_paths\n'
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        printf '  - %s\n' "$line"
      done < "$violations_file"
    }
    return "$EXECUTE_EXIT_NEEDS_HUMAN"
  fi

  worktree_dir="$(ensure_worktree "$repo" "$run_dir" "$run_id")"
  branch="e3d-pilot/$run_id"
  worktree_spec_file="$(prepare_execute_spec_in_worktree "$worktree_dir" "$run_id" "$spec_final_file")"
  max_diff_files="$(config_value "$config_file" '.max_diff_files')"
  max_diff_lines="$(config_value "$config_file" '.max_diff_lines')"

  csr_bin="$(command -v codex-spec-runner || true)"
  [[ -n "$csr_bin" ]] || die "codex-spec-runner not found on PATH"

  csr_stdout="$run_dir/execute-csr.stdout"
  csr_stderr="$run_dir/execute-csr.stderr"
  csr_command_file="$run_dir/execute-csr.command"
  printf 'cd %s && %s %s all\n' "$worktree_dir" "$csr_bin" "$worktree_spec_file" > "$csr_command_file"

  set +e
  ( cd "$worktree_dir" && "$csr_bin" "$worktree_spec_file" all ) >"$csr_stdout" 2>"$csr_stderr"
  csr_status=$?
  set -e

  copy_csr_state_artifacts "$worktree_dir" "$run_dir"

  if [[ $csr_status -ne 0 ]]; then
    if [[ -s "$csr_stderr" ]]; then
      die "execute csr run failed: $(tr '\n' ' ' < "$csr_stderr")"
    fi
    die "execute csr run failed with exit status $csr_status"
  fi

  diff_counts="$(count_git_diff "$worktree_dir")"
  diff_files="${diff_counts%%$'\t'*}"
  diff_lines="${diff_counts#*$'\t'}"
  {
    printf 'branch: %s\n' "$branch"
    printf 'worktree: %s\n' "$worktree_dir"
    printf 'diff_files: %s\n' "$diff_files"
    printf 'diff_lines: %s\n' "$diff_lines"
    printf 'max_diff_files: %s\n' "$max_diff_files"
    printf 'max_diff_lines: %s\n' "$max_diff_lines"
  } > "$run_dir/execute-diff-summary.txt"

  if (( diff_files > max_diff_files || diff_lines > max_diff_lines )); then
    {
      printf 'execute: diff exceeds configured ceiling; stopping before review/publish\n'
      printf '  branch: %s\n' "$branch"
      printf '  worktree: %s\n' "$worktree_dir"
      printf '  diff_files: %s (max %s)\n' "$diff_files" "$max_diff_files"
      printf '  diff_lines: %s (max %s)\n' "$diff_lines" "$max_diff_lines"
    }
    return "$EXECUTE_EXIT_NEEDS_HUMAN"
  fi

  printf 'execute: completed csr run on %s with diff_files=%s diff_lines=%s\n' "$branch" "$diff_files" "$diff_lines"
}

execute_worktree_fields() {
  local run_dir="$1" file="$run_dir/execute-worktree.txt"
  [[ -f "$file" ]] || die "missing execute worktree metadata: $file"
  cat "$file"
}

auto_verify_commands() {
  local worktree="$1"
  if [[ -f "$worktree/package.json" ]]; then
    if jq -e '.scripts.verify? | type == "string"' "$worktree/package.json" >/dev/null 2>&1; then
      printf 'npm run verify\n'
      return 0
    fi
    if jq -e '.scripts.test? | type == "string"' "$worktree/package.json" >/dev/null 2>&1; then
      printf 'npm test\n'
      return 0
    fi
  fi
  if [[ -f "$worktree/Makefile" || -f "$worktree/makefile" ]]; then
    if grep -Eq '^verify:' "$worktree"/Makefile 2>/dev/null || grep -Eq '^verify:' "$worktree"/makefile 2>/dev/null; then
      printf 'make verify\n'
      return 0
    fi
    if grep -Eq '^test:' "$worktree"/Makefile 2>/dev/null || grep -Eq '^test:' "$worktree"/makefile 2>/dev/null; then
      printf 'make test\n'
      return 0
    fi
  fi
  if [[ -f "$worktree/requirements.txt" || -f "$worktree/pyproject.toml" ]]; then
    printf 'pytest\n'
    return 0
  fi
  return 1
}

live_verify_command() {
  jq -r '.live_verify.command // empty' "$1"
}

repo_docs_mention_e3d_paid_api() {
  local repo="$1" config_file="$2" content
  content="$(load_repo_docs_content "$repo" "$config_file" || true)"
  grep -Eiq '(e3d-pod2vid|pod2vid).*(render|revise)|(render|revise).*(e3d-pod2vid|pod2vid)|e3d[[:space:]-]*maps' <<< "$content"
}

e3d_agent_available_for_command() {
  local command_text="$1"
  if [[ "$command_text" == npx\ e3d-agent* ]]; then command -v npx >/dev/null 2>&1
  else command -v e3d-agent >/dev/null 2>&1; fi
}

review_status_value() {
  local file="$1" field="$2"
  awk -F': ' -v key="$field" '$1 == key { print $2; exit }' "$file"
}

publish_backend_field_value() {
  local file="$1" field="$2"
  awk -F': ' -v key="$field" '$1 == key { print $2; exit }' "$file"
}

publish_backend_outcome_value() {
  publish_backend_field_value "$1" "outcome"
}

# Email is an opt-in, best-effort notification: it never blocks or fails
# publish (the branch/PR already exists by the time this runs), and it never
# assumes a specific mail transport -- it shells out to a configured command
# (or a plain `mail` fallback), exactly like verify/live_verify's commands do.
publish_notify_email_command() {
  local config_file="$1" configured
  configured="$(config_value "$config_file" '.notify.email.command')"
  if [[ -n "$configured" && "$configured" != "null" ]]; then
    printf '%s' "$configured"
    return 0
  fi
  command -v mail >/dev/null 2>&1 || return 1
  printf '%s' 'mail -s "$E3D_PILOT_EMAIL_SUBJECT" "$E3D_PILOT_EMAIL_TO"'
}

publish_notify_link_line() {
  local backend="$1" branch="$2" backend_out="$3" pr_url
  case "$backend" in
    github)
      pr_url="$(publish_backend_field_value "$backend_out" "pr_url")"
      if [[ -n "$pr_url" ]]; then
        printf 'View on GitHub: %s\n' "$pr_url"
      else
        printf 'Branch pushed: %s (see %s for the exact push/PR commands)\n' "$branch" "$backend_out"
      fi
      ;;
    *)
      printf 'Local review branch: %s (no remote configured; inspect it in your clone)\n' "$branch"
      ;;
  esac
}

publish_send_notification() {
  local config_file="$1" run_dir="$2" branch="$3" backend="$4" outcome="$5" summary_file="$6"
  local to
  to="$(config_value "$config_file" '.notify.email.to')"
  [[ -n "$to" && "$to" != "null" ]] || return 0

  local subject body command_str
  subject="e3d-pilot: new branch ready for review ($branch)"
  [[ "$outcome" == "needs-attention" ]] && subject="e3d-pilot: action needed for $branch"

  body="$( { publish_notify_link_line "$backend" "$branch" "$run_dir/publish-backend.out"; printf '\n'; cat "$summary_file"; } )"

  if ! command_str="$(publish_notify_email_command "$config_file")"; then
    printf 'publish: notify skipped: no mail command available and notify.email.command not set\n'
    return 0
  fi

  if E3D_PILOT_EMAIL_TO="$to" E3D_PILOT_EMAIL_SUBJECT="$subject" bash -c "$command_str" <<<"$body" >"$run_dir/publish-notify.stdout" 2>"$run_dir/publish-notify.stderr"; then
    printf 'publish: notified %s\n' "$to"
  else
    printf 'publish: notify failed: %s\n' "$(tr '\n' ' ' < "$run_dir/publish-notify.stderr")"
  fi
}

selected_candidate_excerpt() {
  local candidates_file="$1" selected number
  selected="$(candidates_selected_field "$candidates_file")"
  number="${selected##*-}"
  if [[ "$selected" == candidate-* && "$number" =~ ^[0-9]+$ ]]; then
    awk -v n="$number" '
      $0 ~ ("^### Candidate " n "([:[:space:]]|$)") && seen == 0 { seen=1; print; next }
      seen == 1 && /^### Candidate / { exit }
      seen == 1 { print }
    ' "$candidates_file"
  else
    awk '
      /^### Candidate / && seen == 0 { seen=1; print; next }
      seen == 1 && /^### Candidate / { exit }
      seen == 1 { print }
    ' "$candidates_file"
  fi
}

negotiation_outcome_excerpt() {
  local log_file="$1"
  awk '
    /^## Final Outcome/ { capture=1 }
    capture { print }
  ' "$log_file"
}

run_verify_command_in_worktree() {
  local worktree="$1" command_text="$2" stdout_file="$3" stderr_file="$4"
  (cd "$worktree" && bash -lc "$command_text") >"$stdout_file" 2>"$stderr_file"
}

build_review_prompt() {
  local diff_file="$1" prompt_file="$2"
  {
    printf 'You are the review stage of an autonomous repo-improvement pipeline.\n'
    printf 'Read the executed diff below and comment on correctness, regressions,\n'
    printf 'and scope-creep. Keep the response concise and actionable.\n\n'
    printf 'Executed diff:\n\n```diff\n'
    cat "$diff_file"
    printf '\n```\n'
  } > "$prompt_file"
}

manifest_copy_name() {
  local manifest_source="$1"
  case "$(basename "$manifest_source")" in
    manifest.jsonl) printf 'csr-manifest-rows.jsonl' ;;
    manifest.json) printf 'csr-manifest-rows.json' ;;
    manifest.tsv) printf 'csr-manifest-rows.tsv' ;;
    *) printf 'csr-manifest-rows.txt' ;;
  esac
}

audit_artifact_relative_paths() {
  local run_id="$1" manifest_name="$2"
  printf '.e3d-pilot/runs/%s/findings.md\n' "$run_id"
  printf '.e3d-pilot/runs/%s/candidates.md\n' "$run_id"
  printf '.e3d-pilot/runs/%s/negotiation-log.md\n' "$run_id"
  printf '.e3d-pilot/runs/%s/spec-final.md\n' "$run_id"
  printf '.e3d-pilot/runs/%s/%s\n' "$run_id" "$manifest_name"
}

review_stage() {
  local repo="$1" run_id="$2" run_dir config_file metadata branch worktree verify_summary review_status_file
  local provider provider_script prompt response diff_text command status command_index live_command live_reason
  local include_live_verify=0
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"; config_file="$(config_path_for_repo "$repo")"
  ensure_git_repo "$repo"
  validate_config_file "$config_file"
  require_valid_implementation_approval "$repo" "$run_id" "review"
  metadata="$(execute_worktree_fields "$run_dir")"; branch="${metadata%%$'\t'*}"; worktree="${metadata#*$'\t'}"
  [[ -d "$worktree" ]] || die "execute worktree no longer exists: $worktree"
  verify_summary="$run_dir/review-verify-summary.md"
  review_status_file="$run_dir/review-status.txt"
  {
    printf '# Verify Summary\n\n'
    printf 'Branch: `%s`\n\n' "$branch"
    printf 'Worktree: `%s`\n\n' "$worktree"
  } > "$verify_summary"
  mapfile -t commands < <(jq -r '.verify[]?' "$config_file")
  if [[ ${#commands[@]} -eq 0 ]]; then mapfile -t commands < <(auto_verify_commands "$worktree"); fi
  [[ ${#commands[@]} -gt 0 ]] || die "review could not determine any verify commands; configure .verify or add a detectable test command"
  live_command="$(live_verify_command "$config_file")"
  if [[ -n "$live_command" ]]; then
    if repo_docs_mention_e3d_paid_api "$repo" "$config_file" && e3d_agent_available_for_command "$live_command"; then
      commands+=("$live_command")
      include_live_verify=1
      live_reason="included"
    elif ! repo_docs_mention_e3d_paid_api "$repo" "$config_file"; then
      live_reason="skipped: repo docs do not mention E3D paid-API surfaces"
    else
      live_reason="skipped: e3d-agent is not available"
    fi
  else
    live_reason="not configured"
  fi
  command_index=0
  for command in "${commands[@]}"; do
    command_index=$((command_index + 1))
    printf '## Command %s\n\nCommand: `%s`\n\n' "$command_index" "$command" >> "$verify_summary"
    set +e
    run_verify_command_in_worktree "$worktree" "$command" "$run_dir/review-verify-${command_index}.stdout" "$run_dir/review-verify-${command_index}.stderr"
    status=$?
    set -e
    printf 'Exit Status: `%s`\n\n' "$status" >> "$verify_summary"
    if [[ $status -ne 0 ]]; then
      printf 'verify_status: failed\nbranch: %s\nworktree: %s\nlive_verify: %s\n' "$branch" "$worktree" "$live_reason" > "$review_status_file"
      printf 'review: verify failed for command %s: %s\n' "$command_index" "$command"
      return "$REVIEW_EXIT_VERIFY_FAILED"
    fi
  done
  diff_text="$run_dir/review-diff.patch"; git -C "$worktree" diff --no-ext-diff --binary > "$diff_text"
  prompt="$run_dir/review-prompt.md"; response="$run_dir/review-comment.md"
  build_review_prompt "$diff_text" "$prompt"
  provider="$(config_value "$config_file" '.providers.review')"; provider_script="$REPO_ROOT/lib/providers/$provider"
  [[ -x "$provider_script" ]] || die "review provider script missing or not executable: $provider_script"
  if ! (cd "$worktree" && E3D_PILOT_DRY_RUN=0 "$provider_script" "$prompt" > "$response" 2> "$run_dir/review-provider.stderr"); then
    printf 'verify_status: failed\nbranch: %s\nworktree: %s\nlive_verify: %s\n' "$branch" "$worktree" "$live_reason" > "$review_status_file"
    die "review provider failed: $provider"
  fi
  printf 'verify_status: passed\nbranch: %s\nworktree: %s\nlive_verify: %s\n' "$branch" "$worktree" "$live_reason" > "$review_status_file"
  if (( include_live_verify )); then
    printf 'review: verify passed on %s, including live verification, and wrote review-comment.md\n' "$branch"
  else
    printf 'review: verification and independent review passed for %s\n' "$branch"
  fi
}

prepare_publish_audit() {
  local run_dir="$1" worktree="$2" run_id="$3" dest="$worktree/.e3d-pilot/runs/$run_id" name source manifest_source manifest_name
  mkdir -p "$dest"
  for name in findings.md candidates.md negotiation-log.md spec-final.md; do
    source="$run_dir/$name"; [[ -f "$source" ]] || die "publish requires audit artifact: $source"
    cp "$source" "$dest/$name"
  done
  manifest_source=""
  if [[ -f "$run_dir/csr-state/manifest.jsonl" ]]; then
    manifest_source="$run_dir/csr-state/manifest.jsonl"
  elif [[ -f "$run_dir/csr-state/manifest.json" ]]; then
    manifest_source="$run_dir/csr-state/manifest.json"
  elif [[ -f "$run_dir/csr-state/manifest.tsv" ]]; then
    manifest_source="$run_dir/csr-state/manifest.tsv"
  fi
  [[ -n "$manifest_source" ]] || die "publish requires csr manifest copy under $run_dir/csr-state"
  manifest_name="$(manifest_copy_name "$manifest_source")"
  cp "$manifest_source" "$dest/$manifest_name"
  printf '%s\t%s\n' "$dest" "$manifest_name"
}

build_publish_summary() {
  local run_dir="$1" run_id="$2" branch="$3" manifest_name="$4" summary="$5"
  {
    printf '# e3d-pilot Publish Summary\n\n'
    printf 'Branch: `%s`\n\n' "$branch"
    printf '## Findings\n\n'; sed -n '1,24p' "$run_dir/findings.md"
    printf '\n## Selected Candidate\n\n'; selected_candidate_excerpt "$run_dir/candidates.md"
    printf '\n## Negotiation Outcome\n\n'; negotiation_outcome_excerpt "$run_dir/negotiation-log.md"
    printf '\n## Approved Spec\n\nSpec ready at `.e3d-pilot/runs/%s/spec-final.md`.\n' "$run_id"
    printf '\n## Audit Artifacts\n\n'
    while IFS= read -r rel; do
      [[ -n "$rel" ]] || continue
      printf -- '- [%s](%s)\n' "$rel" "$rel"
    done < <(audit_artifact_relative_paths "$run_id" "$manifest_name")
  } > "$summary"
}

publish_backend_for_repo() {
  local repo="$1" configured="$2" remote_name remote_url
  if [[ "$configured" != auto ]]; then printf '%s' "$configured"; return; fi
  if ! repo_has_remote "$repo"; then printf local; return; fi
  remote_name="$(git -C "$repo" remote | head -n1)"
  remote_url="$(git -C "$repo" remote get-url "$remote_name" 2>/dev/null || true)"
  if [[ "$remote_url" == *github.com* ]]; then printf github; else printf local; fi
}

publish_stage() {
  local repo="$1" run_id="$2" run_dir config_file metadata branch worktree audit_info audit_dir manifest_name summary backend backend_script base output backend_status
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"; config_file="$(config_path_for_repo "$repo")"
  ensure_git_repo "$repo"
  validate_config_file "$config_file"
  require_valid_implementation_approval "$repo" "$run_id" "publish"
  [[ -f "$run_dir/review-status.txt" ]] || die "publish requires a completed review stage; missing $run_dir/review-status.txt"
  [[ "$(review_status_value "$run_dir/review-status.txt" verify_status)" == passed ]] || die "publish refused because verify did not pass for run $run_id"
  metadata="$(execute_worktree_fields "$run_dir")"; branch="${metadata%%$'\t'*}"; worktree="${metadata#*$'\t'}"
  base="$(config_value "$config_file" '.pr.base_branch')"
  [[ "$branch" != "$base" ]] || die "publish refuses to operate on base branch $base"
  audit_info="$(prepare_publish_audit "$run_dir" "$worktree" "$run_id")"
  audit_dir="${audit_info%%$'\t'*}"
  manifest_name="${audit_info#*$'\t'}"
  summary="$run_dir/publish-summary.md"; build_publish_summary "$run_dir" "$run_id" "$branch" "$manifest_name" "$summary"

  # Prefer the idea's human-readable title for the PR title (matches what
  # project-board tracking already shows) over the opaque run-id branch name,
  # which otherwise leaves every PR in the GitHub PR list looking identical.
  local pr_title="e3d-pilot: $branch" idea_info idea_kind idea_workspace idea_id idea_status idea_approved idea_title
  if idea_info="$(resolve_run_idea_info "$repo" "$run_id" 2>/dev/null)"; then
    IFS=$'\t' read -r idea_kind idea_workspace idea_id idea_status idea_approved <<<"$idea_info"
    idea_title="$(jq -r '.title // empty' "$(ideas_snapshots_dir "$idea_kind" "$idea_workspace")/$idea_id/idea.json" 2>/dev/null || true)"
    [[ -n "$idea_title" ]] && pr_title="e3d-pilot: $idea_title"
  fi
  git -C "$worktree" add -A
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    git -C "$worktree" add -f -- "$rel"
  done < <(audit_artifact_relative_paths "$run_id" "$manifest_name")
  if [[ -n "$(git -C "$worktree" status --short)" ]]; then
    git -C "$worktree" commit -q -m "e3d-pilot: apply run $run_id"
  fi
  backend="$(publish_backend_for_repo "$repo" "$(config_value "$config_file" '.pr.backend')")"
  backend_script="$REPO_ROOT/lib/publish/$backend"; [[ -x "$backend_script" ]] || die "publish backend unavailable: $backend"
  set +e
  output="$("$backend_script" "$repo" "$run_id" "$branch" "$summary" "$worktree" "$base" "$pr_title" 2>"$run_dir/publish-backend.stderr")"
  backend_status=$?
  set -e
  [[ $backend_status -eq 0 ]] || die "publish backend failed: $(tr '\n' ' ' < "$run_dir/publish-backend.stderr" 2>/dev/null)"
  printf '%s\n' "$output" > "$run_dir/publish-backend.out"

  local outcome
  outcome="$(publish_backend_outcome_value "$run_dir/publish-backend.out")"
  case "$outcome" in
    published|needs-attention) ;;
    error) die "publish backend $backend reported outcome: error: $(tr '\n' ' ' < "$run_dir/publish-backend.out")" ;;
    *) die "publish backend $backend did not report a recognized outcome (published/needs-attention/error): $(tr '\n' ' ' < "$run_dir/publish-backend.out")" ;;
  esac

  publish_send_notification "$config_file" "$run_dir" "$branch" "$backend" "$outcome" "$summary"

  printf '%s\n' "$output"
}

draft_stage() {
  local repo="$1" run_id="$2" run_dir config_file candidates_file selected
  ensure_git_repo "$repo"
  config_file="$(config_path_for_repo "$repo")"
  validate_config_file "$config_file"
  require_valid_implementation_approval "$repo" "$run_id" "draft"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"

  candidates_file="$run_dir/candidates.md"
  [[ -f "$candidates_file" ]] || die "draft requires candidates.md for run $run_id; run ideate first"

  selected="$(candidates_selected_field "$candidates_file")"
  [[ -n "$selected" && "$selected" != "none" ]] || die "draft requires a selected candidate in candidates.md (got '${selected:-<empty>}'); run ideate first"

  local facts_file="$run_dir/draft-facts.md"
  local prompt_file="$run_dir/draft-prompt.md"
  local response_file="$run_dir/draft-response.md"
  local spec_file="$run_dir/spec-draft.md"
  local rejected_file="$run_dir/draft-rejected.md"
  local conventions_file="${CSR_SPEC_CONVENTIONS_FILE:-$REPO_ROOT/lib/draft/csr-spec-conventions.md}"
  [[ -s "$conventions_file" ]] || die "missing csr spec conventions file: $conventions_file"

  local protected_paths_list max_diff_files max_diff_lines
  protected_paths_list="$(jq -r '.protected_paths[] | "- " + .' "$config_file")"
  [[ -n "$protected_paths_list" ]] || protected_paths_list="- (none configured)"
  max_diff_files="$(config_value "$config_file" '.max_diff_files')"
  max_diff_lines="$(config_value "$config_file" '.max_diff_lines')"

  build_draft_facts_markdown "$repo" "$config_file" "$candidates_file" "$facts_file"
  build_draft_prompt "$facts_file" "$prompt_file" "$conventions_file" "$protected_paths_list" "$max_diff_files" "$max_diff_lines"

  local provider provider_script provider_output provider_status provider_error
  provider="$(config_value "$config_file" '.providers.draft')"
  provider_script="$REPO_ROOT/lib/providers/$provider"
  [[ -x "$provider_script" ]] || die "draft provider script missing or not executable: $provider_script"

  set +e
  provider_output="$(cd "$repo" && E3D_PILOT_DRY_RUN=0 "$provider_script" "$prompt_file" 2>"$run_dir/draft-provider.stderr")"
  provider_status=$?
  set -e
  if [[ $provider_status -ne 0 ]]; then
    provider_error=""
    if [[ -s "$run_dir/draft-provider.stderr" ]]; then
      provider_error="$(<"$run_dir/draft-provider.stderr")"
    fi
    if [[ $provider_status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
      die "draft provider unavailable: ${provider_error:-$provider}"
    fi
    die "draft provider failed: ${provider_error:-$provider}"
  fi

  printf '%s\n' "$provider_output" > "$response_file"

  local status reason
  status="$(draft_status_field "status" <<<"$provider_output" || true)"
  reason="$(draft_status_field "reason" <<<"$provider_output" || true)"
  [[ -n "$status" ]] || die "draft provider response missing ---DRAFT-STATUS--- status field"

  if [[ "$status" == "too-large" ]]; then
    {
      printf -- '---\n'
      printf 'status: too-large\n'
      printf 'reason: %s\n' "${reason:-not specified}"
      printf -- '---\n\n'
      printf '# Draft Rejected\n\n'
      printf 'The draft provider judged candidate "%s" could not be scoped within\n' "$selected"
      printf 'max_diff_files=%s / max_diff_lines=%s. No spec-draft.md was written.\n\n' "$max_diff_files" "$max_diff_lines"
      printf '## Raw response\n\n```text\n%s\n```\n' "$provider_output"
    } > "$rejected_file"
    printf 'draft: candidate cannot be scoped within configured limits (%s); no spec-draft.md written\n' "${reason:-not specified}"
    return 0
  fi

  [[ "$status" == "ok" ]] || die "draft provider response has unrecognized status: $status (expected ok or too-large)"

  local spec_block
  spec_block="$(extract_spec_fence "$response_file")"
  [[ -n "$spec_block" ]] || die "draft provider reported status: ok but response is missing a fenced \`\`\`spec block"

  local candidate_spec_file="$run_dir/.spec-draft.candidate.md"
  printf '%s\n' "$spec_block" > "$candidate_spec_file"

  local violations_file="$run_dir/draft-violations.txt"
  local warnings_file="$run_dir/draft-scope-warnings.txt"
  draft_validate_spec "$candidate_spec_file" "$config_file" "$violations_file" || true
  : > "$warnings_file"
  draft_check_scope_ceiling "$candidate_spec_file" "$config_file" "$violations_file" "$warnings_file" || true
  if [[ -s "$violations_file" ]]; then
    {
      printf -- '---\n'
      printf 'status: protected-path-conflict\n'
      printf 'reason: drafted spec failed protected_paths / annotation / scope validation\n'
      printf -- '---\n\n'
      printf '# Draft Rejected\n\n'
      printf 'The drafted spec was rejected before being written because it violates\n'
      printf 'configured constraints:\n\n'
      cat "$violations_file"
      printf '\n## Rejected spec (not written as spec-draft.md)\n\n```text\n%s\n```\n' "$spec_block"
    } > "$rejected_file"
    rm -f "$candidate_spec_file"
    printf 'draft: rejected drafted spec (see %s)\n' "$rejected_file"
    while IFS= read -r line; do
      printf '  - %s\n' "$line"
    done < "$violations_file"
    return 0
  fi

  rm -f "$violations_file"
  if [[ -s "$warnings_file" ]]; then
    printf 'draft: scope estimate warning recorded in %s; continuing to negotiation (actual diff ceiling remains enforced)\n' "$warnings_file"
  else
    rm -f "$warnings_file"
  fi
  mv "$candidate_spec_file" "$spec_file"
  rm -f "$rejected_file" 2>/dev/null || true
  printf '%s\n' "$run_id"
}

build_negotiate_prompt() {
  local reviewer="$1" round="$2" draft_file="$3" prompt_file="$4"
  {
    printf 'You are reviewer %s in round %s of the negotiate loop.\n' "$reviewer" "$round"
    printf 'Read the current draft below as the only source of truth.\n\n'
    printf 'Respond using exactly this format, with no other text before or after it,\n'
    printf 'no markdown heading, comment, or bold syntax around any of these lines:\n\n'
    printf -- '---STATUS---\n'
    printf 'status: approved\n'
    printf 'reason: <one-line reason>\n\n'
    printf 'Use "status: revise" in place of "status: approved" if the draft needs changes.\n'
    printf 'When status is revise, put a fenced ```spec block directly after the reason line,\n'
    printf 'containing the full replacement spec (not a diff or a summary of changes), then\n'
    printf 'nothing else.\n\n'
    printf 'The line "---STATUS---" must appear verbatim and on its own line; it is a fixed\n'
    printf 'parser marker, not a section title to be reworded or restyled.\n\n'
    printf 'Current draft:\n\n'
    cat "$draft_file"
    printf '\n'
  } > "$prompt_file"
}

init_negotiation_log() {
  local log_file="$1" run_id="$2"
  if [[ ! -f "$log_file" ]]; then
    {
      printf -- '---\n'
      printf 'run_id: %s\n' "$run_id"
      printf -- '---\n\n'
      printf '# Negotiation Log\n\n'
    } > "$log_file"
  fi
}

append_negotiation_round_log() {
  local log_file="$1" round_log_file="$2"
  cat "$round_log_file" >> "$log_file"
}

negotiate_stage() {
  local repo="$1" run_id="$2" run_dir config_file spec_draft_file negotiation_log_file max_rounds
  local provider provider_script availability_output provider_status round reviewer_index
  local round_log_file round_prompt_file round_response_file provider_output status reason replacement_spec
  local parse_rc attempt attempt_suffix parse_failed provider_stderr_file
  local -a providers statuses

  ensure_git_repo "$repo"
  config_file="$(config_path_for_repo "$repo")"
  validate_config_file "$config_file"
  require_valid_implementation_approval "$repo" "$run_id" "negotiate"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"

  spec_draft_file="$run_dir/spec-draft.md"
  [[ -f "$spec_draft_file" ]] || die "negotiate requires spec-draft.md for run $run_id; run draft first"

  negotiation_log_file="$run_dir/negotiation-log.md"
  init_negotiation_log "$negotiation_log_file" "$run_id"
  max_rounds="${NEGOTIATE_MAX_ROUNDS:-4}"

  mapfile -t providers < <(jq -r '.providers.negotiate[]' "$config_file")

  for provider in "${providers[@]}"; do
    provider_script="$REPO_ROOT/lib/providers/$provider"
    [[ -x "$provider_script" ]] || die "negotiate provider script missing or not executable: $provider_script"
    if availability_output="$(provider_availability_probe "$provider_script")"; then
      :
    else
      provider_status=$?
      if [[ $provider_status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
        die "negotiate reviewer \"$provider\" unavailable: ${availability_output:-no availability details}"
      fi
      die "negotiate reviewer \"$provider\" availability check failed: ${availability_output:-unknown error}"
    fi
  done

  for ((round=1; round<=max_rounds; round++)); do
    round_log_file="$run_dir/.negotiation-round-${round}.md"
    : > "$round_log_file"
    {
      printf '## Round %s\n\n' "$round"
      printf '### Draft Before Round\n\n```text\n'
      cat "$spec_draft_file"
      printf '\n```\n\n'
    } >> "$round_log_file"

    statuses=()
    reviewer_index=0

    for provider in "${providers[@]}"; do
      reviewer_index=$((reviewer_index + 1))
      provider_script="$REPO_ROOT/lib/providers/$provider"

      for attempt in 1 2; do
        attempt_suffix=""
        [[ $attempt -eq 1 ]] || attempt_suffix="-attempt${attempt}"
        round_prompt_file="$run_dir/negotiate-round-${round}-reviewer-${reviewer_index}-${provider}${attempt_suffix}-prompt.md"
        round_response_file="$run_dir/negotiate-round-${round}-reviewer-${reviewer_index}-${provider}${attempt_suffix}-response.md"
        provider_stderr_file="$run_dir/negotiate-round-${round}-reviewer-${reviewer_index}-${provider}${attempt_suffix}.stderr"

        build_negotiate_prompt "$provider" "$round" "$spec_draft_file" "$round_prompt_file"

        set +e
        provider_output="$(cd "$repo" && E3D_PILOT_DRY_RUN=0 "$provider_script" "$round_prompt_file" 2>"$provider_stderr_file")"
        provider_status=$?
        set -e
        if [[ $provider_status -ne 0 ]]; then
          local provider_error=""
          if [[ -s "$provider_stderr_file" ]]; then
            provider_error="$(<"$provider_stderr_file")"
          fi
          if [[ $provider_status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
            die "negotiate reviewer \"$provider\" became unavailable mid-round: ${provider_error:-no availability details}"
          fi
          die "negotiate reviewer \"$provider\" failed: ${provider_error:-no stderr captured}"
        fi

        printf '%s\n' "$provider_output" > "$round_response_file"

        parse_failed=0
        set +e
        status="$("$REPO_ROOT/lib/negotiate/parse-status" "$round_response_file" status)"
        parse_rc=$?
        set -e
        [[ $parse_rc -eq 0 ]] || parse_failed=1

        if [[ $parse_failed -eq 0 ]]; then
          set +e
          reason="$("$REPO_ROOT/lib/negotiate/parse-status" "$round_response_file" reason)"
          parse_rc=$?
          set -e
          [[ $parse_rc -eq 0 ]] || parse_failed=1
        fi

        replacement_spec=""
        if [[ $parse_failed -eq 0 && "$status" == "revise" ]]; then
          set +e
          replacement_spec="$("$REPO_ROOT/lib/negotiate/parse-status" "$round_response_file" spec)"
          parse_rc=$?
          set -e
          [[ $parse_rc -eq 0 ]] || parse_failed=1
        fi

        [[ $parse_failed -eq 0 ]] && break
        if [[ $attempt -eq 2 ]]; then
          die "negotiate reviewer \"$provider\" (round $round) response failed to parse as a status block after a retry; see $round_response_file"
        fi
        printf 'negotiate: reviewer "%s" (round %s) response failed to parse; retrying once\n' "$provider" "$round" >&2
      done

      if [[ "$status" == "revise" ]]; then
        printf '%s\n' "$replacement_spec" > "$spec_draft_file"
      fi
      statuses+=("$status")

      {
        printf '### Reviewer %s: %s\n\n' "$reviewer_index" "$provider"
        printf 'Status: %s\n\n' "$status"
        printf 'Reason: %s\n\n' "$reason"
        if [[ "$status" == "revise" ]]; then
          printf 'Replacement Spec:\n\n```spec\n%s\n```\n\n' "$replacement_spec"
        fi
        printf 'Raw Response:\n\n```text\n%s\n```\n\n' "$provider_output"
      } >> "$round_log_file"
    done

    if "$REPO_ROOT/lib/negotiate/convergence" "${statuses[@]}" >/dev/null; then
      append_negotiation_round_log "$negotiation_log_file" "$round_log_file"
      cp "$spec_draft_file" "$run_dir/spec-final.md"
      {
        printf '## Final Outcome\n\n'
        printf 'Converged in round %s.\n' "$round"
      } >> "$negotiation_log_file"
      printf 'negotiate: converged in round %s; wrote spec-final.md\n' "$round"
      return 0
    fi

    {
      printf 'Round Result: not converged\n\n'
      printf 'At least one reviewer requested revision in round %s.\n\n' "$round"
    } >> "$round_log_file"
    append_negotiation_round_log "$negotiation_log_file" "$round_log_file"
  done

  {
    printf '## Final Outcome\n\n'
    printf 'Needs human review after %s rounds; spec-draft.md left in place.\n' "$max_rounds"
  } >> "$negotiation_log_file"
  printf 'negotiate: needs human after %s rounds; spec-draft.md and negotiation-log.md left in place\n' "$max_rounds"
  return "$NEGOTIATE_EXIT_NEEDS_HUMAN"
}

json_type_check() {
  local file="$1" filter="$2" message="$3"
  if ! jq -e "$filter" "$file" >/dev/null; then
    die "$message"
  fi
}

validate_config_file() {
  local file="$1"
  [[ -f "$file" ]] || die "missing config file: $file"
  [[ -s "$SCHEMA_FILE" ]] || die "missing schema file: $SCHEMA_FILE"
  jq -e . "$file" >/dev/null || die "invalid JSON: $file"

  json_type_check "$file" 'type == "object"' "config must be a JSON object: $file"
  json_type_check "$file" 'has("verify")' "config.verify is required"
  json_type_check "$file" '.verify | type == "array"' "config.verify must be an array"
  json_type_check "$file" '.verify | all(.[]; type == "string")' "config.verify must be an array of strings"
  json_type_check "$file" 'has("protected_paths")' "config.protected_paths is required"
  json_type_check "$file" '.protected_paths | type == "array"' "config.protected_paths must be an array"
  json_type_check "$file" '.protected_paths | all(.[]; type == "string")' "config.protected_paths must be an array of strings"
  json_type_check "$file" 'has("research_topics")' "config.research_topics is required"
  json_type_check "$file" '.research_topics | type == "string"' "config.research_topics must be a string"
  json_type_check "$file" 'if has("analogy_domains") then (.analogy_domains | type == "array") else true end' "config.analogy_domains must be an array when provided"
  json_type_check "$file" 'if has("analogy_domains") then (.analogy_domains | all(.[]; type == "string")) else true end' "config.analogy_domains must be an array of strings when provided"
  json_type_check "$file" 'has("pr")' "config.pr is required"
  json_type_check "$file" '.pr | type == "object"' "config.pr must be an object"
  json_type_check "$file" '.pr | has("base_branch") and has("draft") and has("labels") and has("backend")' "config.pr must include base_branch, draft, labels, and backend"
  json_type_check "$file" '.pr.base_branch | type == "string"' "config.pr.base_branch must be a string"
  json_type_check "$file" '.pr.draft | type == "boolean"' "config.pr.draft must be a boolean"
  json_type_check "$file" '.pr.labels | type == "array"' "config.pr.labels must be an array"
  json_type_check "$file" '.pr.labels | all(.[]; type == "string")' "config.pr.labels must be an array of strings"
  json_type_check "$file" '.pr.backend | type == "string"' "config.pr.backend must be a string"
  json_type_check "$file" '.pr.backend == "auto" or .pr.backend == "github" or .pr.backend == "local"' "config.pr.backend must be auto, github, or local"
  json_type_check "$file" 'has("providers")' "config.providers is required"
  json_type_check "$file" '.providers | type == "object"' "config.providers must be an object"
  json_type_check "$file" '.providers | has("discover") and has("ideate") and has("draft") and has("negotiate") and has("review")' "config.providers must include discover, ideate, draft, negotiate, and review"
  json_type_check "$file" '.providers.discover | type == "string"' "config.providers.discover must be a string"
  json_type_check "$file" '.providers.ideate | type == "string"' "config.providers.ideate must be a string"
  json_type_check "$file" '.providers.draft | type == "string"' "config.providers.draft must be a string"
  json_type_check "$file" '.providers.negotiate | type == "array"' "config.providers.negotiate must be an array"
  json_type_check "$file" '.providers.negotiate | length >= 1' "config.providers.negotiate must be a non-empty array"
  json_type_check "$file" '.providers.negotiate | all(.[]; type == "string")' "config.providers.negotiate must be a non-empty array of strings"
  json_type_check "$file" '.providers.review | type == "string"' "config.providers.review must be a string"
  json_type_check "$file" '.max_diff_files | type == "number"' "config.max_diff_files must be a number"
  json_type_check "$file" '.max_diff_files == (.max_diff_files | floor)' "config.max_diff_files must be an integer value"
  json_type_check "$file" '.max_diff_files >= 0' "config.max_diff_files must be a non-negative integer"
  json_type_check "$file" '.max_diff_lines | type == "number"' "config.max_diff_lines must be a number"
  json_type_check "$file" '.max_diff_lines == (.max_diff_lines | floor)' "config.max_diff_lines must be an integer value"
  json_type_check "$file" '.max_diff_lines >= 0' "config.max_diff_lines must be a non-negative integer"
  json_type_check "$file" 'if has("docs") then (.docs | type == "string") else true end' "config.docs must be a string when provided"
  json_type_check "$file" 'if has("live_verify") then (.live_verify | type == "object") else true end' "config.live_verify must be an object when provided"
  json_type_check "$file" 'if has("live_verify") then (.live_verify | has("command")) else true end' "config.live_verify.command is required when live_verify is provided"
  json_type_check "$file" 'if has("live_verify") then (.live_verify.command | type == "string") else true end' "config.live_verify.command must be a string"
  json_type_check "$file" 'if has("notify") then (.notify | type == "object") else true end' "config.notify must be an object when provided"
  json_type_check "$file" 'if (has("notify") and (.notify | has("email"))) then (.notify.email | type == "object") else true end' "config.notify.email must be an object when provided"
  json_type_check "$file" 'if (has("notify") and (.notify | has("email"))) then (.notify.email | has("to")) else true end' "config.notify.email.to is required when notify.email is provided"
  json_type_check "$file" 'if (has("notify") and (.notify | has("email"))) then (.notify.email.to | type == "string") else true end' "config.notify.email.to must be a string"
  json_type_check "$file" 'if (has("notify") and (.notify | has("email")) and (.notify.email | has("command"))) then (.notify.email.command | type == "string") else true end' "config.notify.email.command must be a string when provided"
  json_type_check "$file" 'if has("approval") then (.approval | type == "object") else true end' "config.approval must be an object when provided"
  json_type_check "$file" 'if has("approval") then (.approval | has("implementation_required") and has("merge_required")) else true end' "config.approval must include implementation_required and merge_required when provided"
  json_type_check "$file" 'if has("approval") then (.approval.implementation_required | type == "boolean") else true end' "config.approval.implementation_required must be a boolean"
  json_type_check "$file" 'if has("approval") then (.approval.merge_required | type == "boolean") else true end' "config.approval.merge_required must be a boolean"
  json_type_check "$file" 'if has("tracking") then (.tracking | type == "object") else true end' "config.tracking must be an object when provided"
  json_type_check "$file" 'if (has("tracking") and (.tracking | has("project_url"))) then (.tracking.project_url | type == "string") else true end' "config.tracking.project_url must be a string when provided"
  printf 'config valid: %s\n' "$file"
}

cmd_config() {
  local subcommand="${1:-}"
  shift || true
  case "$subcommand" in
    validate)
      [[ $# -eq 1 ]] || die "usage: e3d-pilot config validate <repo>"
      local repo
      repo="$(repo_abs_path "$1")"
      validate_config_file "$(config_path_for_repo "$repo")"
      ;;
    ""|-h|--help)
      usage
      ;;
    *)
      die "unknown config subcommand: $subcommand"
      ;;
  esac
}

run_single_stage() {
  local stage="$1" repo="$2" run_id="$3"
  local run_dir
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"
  ensure_repo_not_paused "$repo" "$stage"
  case "$stage" in
    discover)
      discover_stage "$repo" "$run_id"
      ;;
    ideate)
      ideate_stage "$repo" "$run_id"
      ;;
    draft)
      draft_stage "$repo" "$run_id"
      ;;
    negotiate)
      negotiate_stage "$repo" "$run_id"
      ;;
    execute)
      execute_stage "$repo" "$run_id"
      ;;
    review)
      review_stage "$repo" "$run_id"
      ;;
    publish)
      publish_stage "$repo" "$run_id"
      ;;
    all)
      local ordered=(discover ideate draft negotiate execute review publish)
      local current current_status
      for current in "${ordered[@]}"; do
        # Deliberately an `if`, not `set +e; ...; set -e`: several substages
        # (discover/ideate/draft/negotiate/execute/review) internally do
        # their own `set +e; provider call; set -e` bracketing before
        # returning a non-zero "needs human" status, which would otherwise
        # re-enable errexit and make bash abort this whole script the moment
        # that non-zero status is returned -- silently skipping every check
        # below, including the "stopping before X" messages. Errexit is
        # unconditionally suspended for the duration of an `if` condition
        # regardless of what the callee does with `set -e` internally, so
        # this is immune to that.
        if run_single_stage "$current" "$repo" "$run_id"; then
          current_status=0
        else
          current_status=$?
        fi
        if [[ $current_status -eq "$NEGOTIATE_EXIT_NEEDS_HUMAN" ]]; then
          printf 'negotiate: needs human; stopping before execute\n'
          return "$current_status"
        fi
        if [[ $current_status -eq "$EXECUTE_EXIT_NEEDS_HUMAN" ]]; then
          printf 'execute: human review required; stopping before review\n'
          return "$current_status"
        fi
        if [[ $current_status -eq "$REVIEW_EXIT_VERIFY_FAILED" ]]; then
          printf 'review: verify failed; stopping before publish\n'
          return "$current_status"
        fi
        [[ $current_status -eq 0 ]] || return "$current_status"
        if [[ "$current" == "ideate" ]]; then
          local candidates_file="$run_dir/candidates.md" selected
          if [[ -f "$candidates_file" ]]; then
            selected="$(candidates_selected_field "$candidates_file")"
            if [[ "$selected" == "none" ]]; then
              printf 'ideate: nothing to do (all candidates duplicate existing work); stopping before draft\n'
              return 0
            fi
            local approval_required
            approval_required="$(config_approval_implementation_required "$(config_path_for_repo "$repo")")"
            if [[ "$approval_required" == "true" ]]; then
              local approval_info a_kind a_workspace a_idea_id a_status a_approved
              if approval_info="$(resolve_run_idea_info "$repo" "$run_id")"; then
                IFS=$'\t' read -r a_kind a_workspace a_idea_id a_status a_approved <<<"$approval_info"
                if ! idea_stage_approval_ok "draft" "$a_status" "$a_approved"; then
                  printf 'ideate: idea %s is not approved for implementation (status: %s); stopping before draft\n' "$a_idea_id" "$a_status"
                  printf 'pilot: pending-approval idea=%s status=%s\n' "$a_idea_id" "$a_status"
                  printf '  approve with: e3d-pilot ideas approve --repo %s %s\n' "$repo" "$a_idea_id"
                  return 0
                fi
              else
                printf 'ideate: no idea record resolved for selected candidate %s; stopping before draft\n' "$selected"
                printf 'pilot: pending-approval idea=(unresolved) status=none\n'
                return 0
              fi
            fi
          fi
        fi
        if [[ "$current" == "draft" ]]; then
          local spec_draft_file="$run_dir/spec-draft.md"
          if [[ ! -f "$spec_draft_file" ]]; then
            printf 'draft: no spec-draft.md produced; stopping before negotiate\n'
            return 0
          fi
        fi
      done
      ;;
    *)
      die "unknown stage: $stage"
      ;;
  esac
}

cmd_run() {
  local repo="" stage="" run_id="" focus=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo="${2:-}"
        shift 2
        ;;
      --stage)
        stage="${2:-}"
        shift 2
        ;;
      --run-id)
        run_id="${2:-}"
        shift 2
        ;;
      --focus)
        focus="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown run argument: $1"
        ;;
    esac
  done
  [[ -n "$repo" ]] || die "--repo is required"
  [[ -n "$stage" ]] || die "--stage is required"
  [[ -z "$focus" ]] || validate_focus_value "$focus"
  PILOT_FOCUS="$focus"
  repo="$(repo_abs_path "$repo")"
  if [[ "$stage" == "discover" || "$stage" == "all" ]]; then
    if [[ -z "$run_id" ]]; then
      if [[ -f "$(latest_run_path_for_repo "$repo")" ]]; then
        DISCOVER_PREVIOUS_RUN_ID="$(<"$(latest_run_path_for_repo "$repo")")"
      else
        DISCOVER_PREVIOUS_RUN_ID=""
      fi
      run_id="$(start_new_run "$repo")"
    else
      mkdir -p "$(runs_dir_for_repo "$repo")/$run_id"
      write_latest_run "$repo" "$run_id"
      DISCOVER_PREVIOUS_RUN_ID=""
    fi
  else
    run_id="$(resolve_run_id "$repo" "$run_id")"
  fi

  run_single_stage "$stage" "$repo" "$run_id"
}

# ─── ideas CLI helpers (shared between `ideas` and `fleet ideas`) ────────────

ideas_snapshot_files() {
  local kind="$1" workspace="$2" dir
  dir="$(ideas_snapshots_dir "$kind" "$workspace")" || return 1
  [[ -d "$dir" ]] || return 0
  find "$dir" -mindepth 2 -maxdepth 2 -name idea.json 2>/dev/null
}

ideas_age_from_timestamp() {
  local created="$1" now_epoch created_epoch
  now_epoch="$(date -u +%s)"
  if created_epoch="$(date -u -d "$created" +%s 2>/dev/null)"; then
    :
  elif created_epoch="$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$created" +%s 2>/dev/null)"; then
    :
  else
    printf '?'
    return 0
  fi
  printf '%sd' $(( (now_epoch - created_epoch) / 86400 ))
}

ideas_events_for_idea_json() {
  local kind="$1" workspace="$2" idea_id="$3" events_file
  events_file="$(ideas_events_file "$kind" "$workspace")" || return 1
  [[ -f "$events_file" ]] || { printf '[]'; return 0; }
  jq -R -s --arg id "$idea_id" '[split("\n")[] | select(length>0) | fromjson | select(.idea_id==$id)]' "$events_file"
}

ideas_do_list() {
  local kind="$1" workspace="$2" status_filter="$3" json_flag="$4"
  local canonical dir files=() rows='[]'
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  dir="$(ideas_snapshots_dir "$kind" "$canonical")"
  if [[ -d "$dir" ]]; then
    mapfile -t files < <(ideas_snapshot_files "$kind" "$canonical")
    if [[ ${#files[@]} -gt 0 ]]; then
      rows="$(jq -cS -s '.' "${files[@]}")"
    fi
  fi
  if [[ -n "$status_filter" ]]; then
    rows="$(jq -cS --arg s "$status_filter" '[.[] | select(.status == $s)]' <<<"$rows")"
  fi
  rows="$(jq -cS 'sort_by(.idea_id) | reverse | sort_by(.created_at) | reverse' <<<"$rows")"
  if [[ "$json_flag" == "1" ]]; then
    printf '%s\n' "$rows"
    return 0
  fi
  local count
  count="$(jq 'length' <<<"$rows")"
  if [[ "$count" -eq 0 ]]; then
    printf 'no ideas found\n'
    return 0
  fi
  printf '%-16s  %-26s  %-3s  %-36s  %-20s  %3s %3s %3s  %5s  %s\n' \
    "ID" "STATUS" "SEL" "TITLE" "REPOS" "ATT" "RET" "REV" "AGE" "LATEST ACTOR"
  local line id status sel title repos_s att ret rev created actor
  while IFS=$'\t' read -r id status sel title repos_s att ret rev created actor; do
    printf '%-16s  %-26s  %-3s  %-36s  %-20s  %3s %3s %3s  %5s  %s\n' \
      "$id" "$status" "$sel" "${title:0:36}" "${repos_s:0:20}" "$att" "$ret" "$rev" \
      "$(ideas_age_from_timestamp "$created")" "$actor"
  done < <(jq -r '.[] | [
      .idea_id, .status,
      (if .selected_by_model then "yes" else "-" end),
      (.title // "-"),
      ((.repos // []) | map(split("/") | last) | join(",")),
      ((.scores.attraction // "-") | tostring),
      ((.scores.retention // "-") | tostring),
      ((.scores.revenue // "-") | tostring),
      .created_at,
      (.last_decision_actor // "-")
    ] | @tsv' <<<"$rows")
}

ideas_do_show() {
  local kind="$1" workspace="$2" idea_id="$3" json_flag="$4"
  local canonical file events_json
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  file="$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")"
  events_json="$(ideas_events_for_idea_json "$kind" "$canonical" "$idea_id")"
  if [[ "$json_flag" == "1" ]]; then
    jq -cS --argjson events "$events_json" '. + {events: $events}' "$file"
    return 0
  fi
  jq -r '
    "idea:                    " + .idea_id,
    "status:                  " + .status,
    "workspace:                " + .workspace_kind + " " + .workspace_path,
    "source:                  run=" + .source_run_id + " candidate=" + .source_candidate,
    "title:                   " + (.title // "-"),
    "summary:                 " + (.summary // "-"),
    "repos:                   " + ((.repos // []) | join(", ")),
    "category:                " + (.category // "-"),
    "analogy:                 " + (.analogy // "-"),
    "dedup_rationale:         " + (.dedup_rationale // "-"),
    "scores:                  attraction=" + ((.scores.attraction // "-")|tostring) +
      " retention=" + ((.scores.retention // "-")|tostring) +
      " revenue=" + ((.scores.revenue // "-")|tostring) +
      " effort=" + ((.scores.effort // "-")|tostring),
    "approvable:              " + (.validation.approvable | tostring) +
      (if (.validation.eligibility_reason // null) != null then " (" + .validation.eligibility_reason + ")" else "" end),
    "warnings:                " + ((.validation.warnings // []) | join("; ")),
    "created_at:              " + .created_at,
    "updated_at:              " + .updated_at
  ' "$file"
  printf 'implementation_approval: %s\n' "$(jq -c '.implementation_approval' "$file")"
  printf 'implementation.targets:  %s\n' "$(jq -c '.implementation.targets' "$file")"
  printf 'merge_approval:          %s\n' "$(jq -c '.merge_approval' "$file")"
  printf 'outcomes:                %s\n' "$(jq -c '.outcomes' "$file")"
  printf '\nevent history:\n'
  jq -r '.[] | "  " + .timestamp + "  " + .event + "  actor=" + .actor + (if (.note // null) != null then "  note=" + .note else "" end)' <<<"$events_json"
}

# Builds the ordered per-repo implementation target plan for a fleet idea at
# approval time: canonical path, role, base SHA/branch as of *now* (approval
# time, not proposal time), and shared candidate context. Feeding this into
# ideas_transition binds it into the same approval event/digest.
ideas_build_fleet_targets_json() {
  local idea_file="$1" title summary category repo idx=0 role base_sha base_branch cfg first=1
  title="$(jq -r '.title // ""' "$idea_file")"
  summary="$(jq -r '.summary // ""' "$idea_file")"
  category="$(jq -r '.category // ""' "$idea_file")"
  printf '['
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    idx=$((idx + 1))
    [[ $idx -eq 1 ]] && role="primary" || role="secondary"
    base_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || printf '')"
    [[ -n "$base_sha" ]] || die "fleet target repo has no HEAD commit: $repo"
    cfg="$(config_path_for_repo "$repo")"
    if [[ -f "$cfg" ]]; then
      base_branch="$(jq -r '.pr.base_branch // "main"' "$cfg")"
    else
      base_branch="main"
    fi
    (( first == 0 )) && printf ','
    first=0
    jq -ncS \
      --arg path "$repo" --arg role "$role" --arg base_sha "$base_sha" --arg base_branch "$base_branch" \
      --arg title "$title" --arg summary "$summary" --arg category "$category" \
      '{path:$path,role:$role,base_sha:$base_sha,base_branch:$base_branch,candidate_context:{title:$title,summary:$summary,category:$category}}'
  done < <(jq -r '.repos[]? // empty' "$idea_file")
  printf ']'
}

ideas_do_approve() {
  local kind="$1" workspace="$2" context_dir="$3" idea_id="$4" actor_explicit="$5" note="$6"
  local canonical file actor status targets_file="" existing_digest new_digest
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  file="$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")"
  actor="$(ideas_resolve_actor "$context_dir" "$actor_explicit")"
  status="$(jq -r '.status' "$file")"

  if [[ "$kind" == "fleet" ]]; then
    targets_file="$(mktemp "${TMPDIR:-/tmp}/e3d-idea-targets.XXXXXX")"
    ideas_build_fleet_targets_json "$file" > "$targets_file"
  fi

  if [[ "$status" == "approved_for_implementation" ]]; then
    existing_digest="$(jq -r '.implementation_approval.digest // empty' "$file")"
    new_digest="$(ideas_decision_digest_effective "$file" "$targets_file")"
    rm -f "$targets_file"
    if [[ "$existing_digest" == "$new_digest" ]]; then
      printf 'ideas: %s already approved for implementation (idempotent, digest %s)\n' "$idea_id" "$new_digest"
      return 0
    fi
    die "idea $idea_id was already approved but its decision-bearing content (or, for fleet ideas, a target repo's HEAD) has since changed; a fresh proposal/revision is required before approving again"
  fi

  if [[ "$status" != "proposed" ]]; then
    rm -f "$targets_file"
    die "idea $idea_id is not eligible for approval (status: $status)"
  fi

  ideas_transition "$kind" "$canonical" "$idea_id" implementation_approved "$actor" "$note" "$targets_file" ""
  project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
  rm -f "$targets_file"
}

ideas_do_reject() {
  local kind="$1" workspace="$2" context_dir="$3" idea_id="$4" actor_explicit="$5" reason="$6"
  [[ -n "$reason" ]] || die "reject requires --reason <text>"
  local canonical actor
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  actor="$(ideas_resolve_actor "$context_dir" "$actor_explicit")"
  ideas_transition "$kind" "$canonical" "$idea_id" idea_rejected "$actor" "$reason" "" ""
  project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
}

ideas_do_request_changes() {
  local kind="$1" workspace="$2" context_dir="$3" idea_id="$4" actor_explicit="$5" reason="$6"
  [[ -n "$reason" ]] || die "request-changes requires --reason <text>"
  local canonical actor idea_file status targets_tmp reviewed_head
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  actor="$(ideas_resolve_actor "$context_dir" "$actor_explicit")"
  idea_file="$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")"
  status="$(jq -r '.status' "$idea_file")"
  case "$status" in
    implemented|approved_for_merge) ;;
    *) die "idea $idea_id cannot request changes from status: $status" ;;
  esac
  targets_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-request-changes-targets.XXXXXX")"
  jq -cS '
    if (.merge_approval.targets // [] | length) > 0 then
      .merge_approval.targets
      | map({
          repo,
          pr_url,
          pr_number,
          reviewed_head_sha: (.head_sha // null)
        })
    else
      ((.outcomes // [])
      | map(select(.type=="implementation" and .status=="succeeded"))
      | .[-1].targets // [])
      | map(select(.publish_backend == "github" and (.pr_url // null) != null) | {
          repo,
          pr_url,
          pr_number,
          reviewed_head_sha: (.final_pr_head_sha // null)
        })
    end
  ' "$idea_file" > "$targets_tmp"
  reviewed_head="$(jq -r '.[0].reviewed_head_sha // empty' "$targets_tmp")"
  ideas_transition "$kind" "$canonical" "$idea_id" changes_requested "$actor" "$reason" "$targets_tmp" "$reviewed_head" >/dev/null
  project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
  rm -f "$targets_tmp"
}

gh_pr_check_summary_json() {
  local metadata="$1"
  jq -cS '
    (.statusCheckRollup // null) as $rollup
    | if ($rollup == null) then
        null
      else
        ($rollup | if type == "array" then . else [.] end) as $items
        | {
            total: ($items | length),
            passed: ($items | map(select((.conclusion // .state // .status // "") | ascii_upcase | test("SUCCESS|PASSED"))) | length),
            failed: ($items | map(select((.conclusion // .state // .status // "") | ascii_upcase | test("FAIL|ERROR|CANCEL|TIMED_OUT"))) | length),
            pending: ($items | map(select((.conclusion // "") == null or (.status // .state // "" | ascii_upcase | test("QUEUED|IN_PROGRESS|PENDING|EXPECTED")))) | length)
          }
      end
  ' <<<"$metadata"
}

forge_observation_from_metadata() {
  local target_json="$1" metadata="$2"
  local check_summary
  check_summary="$(gh_pr_check_summary_json "$metadata")"
  jq -ncS \
    --argjson target "$target_json" \
    --argjson metadata "$metadata" \
    --argjson checks "$check_summary" '
    {
      repo: ($target.repo // null),
      publish_backend: ($target.publish_backend // "github"),
      pr_url: ($metadata.url // $target.pr_url // null),
      pr_number: ($metadata.number // $target.pr_number // null),
      base_branch: ($metadata.baseRefName // $target.base_branch // null),
      head_sha: ($metadata.headRefOid // $target.head_sha // null),
      pr_state: ($metadata.state // null),
      is_draft: ($metadata.isDraft // null),
      merge_sha: ($metadata.mergeCommit.oid // $metadata.mergeCommit.sha // null),
      close_reason: ($metadata.closeReason // null),
      checks: $checks
    }'
}

idea_target_baseline_json() {
  local idea_file="$1" repo="$2" pr_url="$3" pr_number="$4"
  jq -cS \
    --arg repo "$repo" \
    --arg pr_url "$pr_url" \
    --arg pr_number "$pr_number" '
      (
        .forge.targets[]? | select(.repo == $repo and (.pr_url // "") == $pr_url)
      ) // (
        .merge_approval.targets[]? | select(.repo == $repo and (.pr_url // "") == $pr_url)
        | {
            repo,
            publish_backend,
            pr_url,
            pr_number,
            base_branch,
            head_sha,
            pr_state:"OPEN",
            is_draft:null,
            merge_sha:null,
            close_reason:null,
            checks:null
          }
      ) // (
        (.outcomes // [])
        | map(select(.type=="implementation" and .status=="succeeded"))
        | .[-1].targets[]?
        | select(.repo == $repo and (.pr_url // "") == $pr_url)
        | {
            repo,
            publish_backend,
            pr_url,
            pr_number,
            base_branch,
            head_sha:(.final_pr_head_sha // null),
            pr_state:"OPEN",
            is_draft:null,
            merge_sha:null,
            close_reason:null,
            checks:null
          }
      ) // null
    ' "$idea_file" | head -n1
}

idea_sync_targets_json() {
  local idea_file="$1"
  jq -cS '
    [
      (.merge_approval.targets[]? | select(.publish_backend == "github")),
      (
        (.outcomes // [])
        | map(select(.type=="implementation" and .status=="succeeded"))
        | .[-1].targets[]?
        | select(.publish_backend == "github" and (.pr_url // null) != null)
        | {
            repo,
            publish_backend,
            pr_url,
            pr_number,
            base_branch,
            head_sha:(.final_pr_head_sha // null)
          }
      ),
      (.forge.targets[]? | select(.publish_backend == "github" and (.pr_url // null) != null))
    ]
    | map(select(.repo != null and (.pr_url // null) != null))
    | unique_by(.repo + "|" + .pr_url + "|" + ((.pr_number // null) | tostring))
  ' "$idea_file"
}

sync_summary_output() {
  local scope="$1" scanned="$2" changed="$3" noop="$4" failures="${5:-0}"
  printf '%s ideas sync: scanned=%s changed=%s noop=%s failures=%s\n' "$scope" "$scanned" "$changed" "$noop" "$failures"
}

ideas_collect_sync_changes() {
  local kind="$1" workspace="$2" idea_id="$3" idea_file="$4"
  local targets_json count idx target metadata obs baseline approval_head source_status current_status restore_status matched_count merged_count closed_count
  local generic_tmp invalidation_tmp merged_tmp closed_tmp
  current_status="$(jq -r '.status' "$idea_file")"
  targets_json="$(idea_sync_targets_json "$idea_file")"
  count="$(jq 'length' <<<"$targets_json")"
  generic_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-sync-generic.XXXXXX")"
  invalidation_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-sync-invalidation.XXXXXX")"
  merged_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-sync-merged.XXXXXX")"
  closed_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-sync-closed.XXXXXX")"
  : > "$generic_tmp"
  : > "$invalidation_tmp"
  : > "$merged_tmp"
  : > "$closed_tmp"

  for ((idx=0; idx<count; idx++)); do
    target="$(jq -cS --argjson i "$idx" '.[$i]' <<<"$targets_json")"
    metadata="$(gh_pr_view_json "$(jq -r '.repo' <<<"$target")" "$(jq -r '.pr_url' <<<"$target")" "number,url,isDraft,headRefOid,baseRefName,state,mergeCommit,closeReason,statusCheckRollup")"
    obs="$(forge_observation_from_metadata "$target" "$metadata")"
    baseline="$(idea_target_baseline_json "$idea_file" "$(jq -r '.repo' <<<"$obs")" "$(jq -r '.pr_url' <<<"$obs")" "$(jq -r '(.pr_number // "") | tostring' <<<"$obs")")"
    if [[ -z "$baseline" || "$baseline" == "null" ]]; then
      printf '%s\n' "$obs" >> "$generic_tmp"
      continue
    fi

    if [[ "$(jq -cS . <<<"$baseline")" != "$(jq -cS . <<<"$obs")" ]]; then
      if [[ "$current_status" == "approved_for_merge" && "$(jq -r '.head_sha // empty' <<<"$obs")" != "$(jq -r '.head_sha // empty' <<<"$baseline")" ]]; then
        printf '%s\n' "$obs" >> "$invalidation_tmp"
      elif [[ "$(jq -r '.pr_state // empty' <<<"$obs")" == "MERGED" ]]; then
        printf '%s\n' "$obs" >> "$merged_tmp"
      elif [[ "$(jq -r '.pr_state // empty' <<<"$obs")" == "CLOSED" ]]; then
        printf '%s\n' "$obs" >> "$closed_tmp"
      else
        printf '%s\n' "$obs" >> "$generic_tmp"
      fi
    fi
  done

  if [[ -s "$invalidation_tmp" ]]; then
    source_status="$(jq -r '.merge_approval.source_status // "implemented"' "$idea_file")"
    case "$source_status" in
      changes_requested) restore_status="changes_requested" ;;
      *) restore_status="implemented" ;;
    esac
    jq -ncS \
      --arg restore_status "$restore_status" \
      --slurpfile observations "$invalidation_tmp" \
      '{
        restore_status:$restore_status,
        observations:$observations
      }'
    rm -f "$generic_tmp" "$invalidation_tmp" "$merged_tmp" "$closed_tmp"
    return 0
  fi

  if [[ -s "$merged_tmp" ]]; then
    jq -ncS \
      --argjson approval_present "$(jq '(.merge_approval.targets // []) | length > 0' "$idea_file")" \
      --argjson matched_head "$(
        jq -n --slurpfile merged "$merged_tmp" --slurpfile idea "$idea_file" '
          any($merged[]; . as $obs | any($idea[0].merge_approval.targets[]?; (.repo == $obs.repo) and ((.pr_url // "") == ($obs.pr_url // "")) and ((.head_sha // "") == ($obs.head_sha // ""))))
        '
      )" \
      --slurpfile observations "$merged_tmp" '
      {
        observations:$observations,
        outcome:{
          type:"merge_external",
          status:"merged_external",
          approval_present:$approval_present,
          approval_matched_head:$matched_head,
          targets:$observations
        }
      }'
    rm -f "$generic_tmp" "$invalidation_tmp" "$merged_tmp" "$closed_tmp"
    return 0
  fi

  if [[ -s "$closed_tmp" ]]; then
    jq -ncS \
      --arg prior_status "$current_status" \
      --slurpfile observations "$closed_tmp" '
      {
        outcome:{
          type:"closed",
          prior_status:$prior_status,
          targets:$observations
        }
      }'
    rm -f "$generic_tmp" "$invalidation_tmp" "$merged_tmp" "$closed_tmp"
    return 0
  fi

  if [[ -s "$generic_tmp" ]]; then
    jq -ncS --slurpfile observations "$generic_tmp" '{observations:$observations}'
    rm -f "$generic_tmp" "$invalidation_tmp" "$merged_tmp" "$closed_tmp"
    return 0
  fi

  rm -f "$generic_tmp" "$invalidation_tmp" "$merged_tmp" "$closed_tmp"
  printf '{}'
}

ideas_do_sync() {
  local kind="$1" workspace="$2" idea_id="${3:-}" canonical actor files=() file scanned=0 changed=0 noop=0
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  actor="system-sync"
  if [[ -n "$idea_id" ]]; then
    files=("$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")")
  else
    mapfile -t files < <(ideas_snapshot_files "$kind" "$canonical")
  fi
  for file in "${files[@]}"; do
    [[ -n "$file" ]] || continue
    scanned=$((scanned + 1))
    local this_id extra_json extra_file event note status this_status
    this_id="$(jq -r '.idea_id' "$file")"
    this_status="$(jq -r '.status' "$file")"
    # Terminal statuses have no allowed forge_sync/merge_observed_external/
    # idea_closed transition in the lifecycle validator (only outcome_recorded
    # and their specific retry events are), so scanning them would just
    # rediscover the same already-terminal forge state on every future sync
    # call and die on a rejected transition. Nothing meaningful for sync to
    # observe once an idea is done.
    case "$this_status" in
      merged|reverted|closed|implementation_failed|merge_failed)
        noop=$((noop + 1))
        continue
        ;;
    esac
    extra_json="$(ideas_collect_sync_changes "$kind" "$canonical" "$this_id" "$file")"
    if [[ "$extra_json" == "{}" ]]; then
      noop=$((noop + 1))
      continue
    fi
    extra_file="$(mktemp "${TMPDIR:-/tmp}/e3d-sync-extra.XXXXXX")"
    printf '%s\n' "$extra_json" > "$extra_file"
    if jq -e '.restore_status? != null' "$extra_file" >/dev/null; then
      note="sync observed new PR head; merge approval invalidated"
      ideas_append_custom_event "$kind" "$canonical" "$this_id" merge_approval_invalidated "$actor" "$note" "$extra_file" >/dev/null
    elif jq -e '.outcome?.type == "merge_external"' "$extra_file" >/dev/null; then
      note="sync observed external merge"
      ideas_append_custom_event "$kind" "$canonical" "$this_id" merge_observed_external "$actor" "$note" "$extra_file" >/dev/null
    elif jq -e '.outcome?.type == "closed"' "$extra_file" >/dev/null; then
      note="sync observed PR closure"
      ideas_append_custom_event "$kind" "$canonical" "$this_id" idea_closed "$actor" "$note" "$extra_file" >/dev/null
    else
      note="sync observed forge updates"
      ideas_append_custom_event "$kind" "$canonical" "$this_id" forge_sync "$actor" "$note" "$extra_file" >/dev/null
    fi
    project_tracking_sync_idea "$kind" "$canonical" "$this_id"
    rm -f "$extra_file"
    changed=$((changed + 1))
  done
  sync_summary_output "$kind" "$scanned" "$changed" "$noop" 0
}

parse_metric_value_json() {
  local raw="$1"
  if [[ "$raw" == "true" || "$raw" == "false" ]]; then
    printf '%s' "$raw"
  elif [[ "$raw" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s' "$raw"
  else
    jq -Rn --arg v "$raw" '$v'
  fi
}

ideas_do_outcome() {
  local kind="$1" workspace="$2" context_dir="$3" idea_id="$4" window="$5" note="$6"; shift 6
  local canonical actor metrics=("$@") metrics_tmp extra_file
  [[ "$window" == "7d" || "$window" == "30d" || "$window" == "custom" ]] || die "outcome requires --window <7d|30d|custom>"
  [[ ${#metrics[@]} -gt 0 ]] || die "outcome requires at least one --metric <key=value>"
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  actor="$(ideas_resolve_actor "$context_dir" "")"
  metrics_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-outcome-metrics.XXXXXX")"
  : > "$metrics_tmp"
  local pair key value type_json value_json keys_tmp
  keys_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-outcome-keys.XXXXXX")"
  : > "$keys_tmp"
  for pair in "${metrics[@]}"; do
    [[ "$pair" == *=* ]] || { rm -f "$metrics_tmp" "$keys_tmp"; die "invalid --metric value: $pair"; }
    key="${pair%%=*}"
    value="${pair#*=}"
    [[ -n "$key" ]] || { rm -f "$metrics_tmp" "$keys_tmp"; die "invalid --metric key in: $pair"; }
    printf '%s\n' "$key" >> "$keys_tmp"
    value_json="$(parse_metric_value_json "$value")"
    type_json="$(jq -nr --argjson v "$value_json" '($v | type)')"
    jq -ncS \
      --arg key "$key" \
      --arg window "$window" \
      --arg note "$note" \
      --arg observed_at "$(ideas_utc_now)" \
      --arg type "$type_json" \
      --argjson value "$value_json" '
      {
        key:$key,
        type:$type,
        value:$value,
        window:$window,
        observed_at:$observed_at,
        note:(if $note == "" then null else $note end)
      }' >> "$metrics_tmp"
  done
  if [[ "$(sort "$keys_tmp" | uniq -d | wc -l | tr -d ' ')" != "0" ]]; then
    rm -f "$metrics_tmp" "$keys_tmp"
    die "outcome rejects duplicate metric keys in one invocation"
  fi
  extra_file="$(mktemp "${TMPDIR:-/tmp}/e3d-outcome-extra.XXXXXX")"
  jq -s -cS --arg window "$window" --arg note "$note" '
    {
      outcome:{
        type:"metrics",
        window:$window,
        note:(if $note == "" then null else $note end),
        metrics:.
      }
    }' "$metrics_tmp" > "$extra_file"
  ideas_append_custom_event "$kind" "$canonical" "$idea_id" outcome_recorded "$actor" "$note" "$extra_file" >/dev/null
  rm -f "$metrics_tmp" "$keys_tmp" "$extra_file"
  printf 'ideas: recorded outcomes for %s window=%s metrics=%s\n' "$idea_id" "$window" "${#metrics[@]}"
}

ideas_find_revert_commit() {
  local repo="$1" idea_file="$2" merge_sha
  while IFS= read -r merge_sha; do
    [[ -n "$merge_sha" && "$merge_sha" != "null" ]] || continue
    git -C "$repo" log --format='%H %s' --grep="$merge_sha" -i 2>/dev/null \
      | awk '/revert/i {print $1; exit}'
  done < <(jq -r '.outcomes[]?.targets[]?.merge_sha // empty' "$idea_file")
}

ideas_do_mark_reverted() {
  local repo="$1" idea_id="$2" reason="$3"
  local canonical actor idea_file revert_commit extra_file
  [[ -n "$reason" ]] || die "mark-reverted requires --reason <text>"
  canonical="$(ideas_canonical_path "$repo")" || die "workspace not found: $repo"
  actor="$(ideas_resolve_actor "$repo" "")"
  idea_file="$(ideas_require_snapshot repo "$canonical" "$idea_id")"
  [[ "$(jq -r '.status' "$idea_file")" == "merged" ]] || die "mark-reverted requires a merged idea"
  revert_commit="$(ideas_find_revert_commit "$repo" "$idea_file" || true)"
  extra_file="$(mktemp "${TMPDIR:-/tmp}/e3d-revert-extra.XXXXXX")"
  jq -ncS \
    --arg reason "$reason" \
    --arg revert_commit "$revert_commit" '
    {
      outcome:{
        type:"revert",
        reason:$reason,
        revert_commit:(if $revert_commit == "" then null else $revert_commit end)
      }
    }' > "$extra_file"
  ideas_append_custom_event repo "$canonical" "$idea_id" idea_reverted "$actor" "$reason" "$extra_file" >/dev/null
  project_tracking_sync_idea repo "$canonical" "$idea_id"
  rm -f "$extra_file"
  printf 'ideas: marked reverted %s%s\n' "$idea_id" "$(if [[ -n "$revert_commit" ]]; then printf ' revert_commit=%s' "$revert_commit"; fi)"
}

# ─── approval gate (Phase 4) ──────────────────────────────────────────────────

config_approval_implementation_required() {
  local config_file="$1"
  jq -r 'if has("approval") then (.approval.implementation_required | tostring) else "true" end' "$config_file"
}

config_approval_merge_required() {
  local config_file="$1"
  jq -r 'if has("approval") then (.approval.merge_required | tostring) else "true" end' "$config_file"
}

IDEA_IMPLEMENTATION_CONTINUATION_STATUSES="approved_for_implementation implementing changes_requested implemented"

idea_stage_approval_ok() {
  local stage_name="$1" status="$2" approved="$3" s
  [[ "$approved" == "1" ]] || return 1
  case "$stage_name" in
    draft|negotiate|execute|review|publish)
      for s in $IDEA_IMPLEMENTATION_CONTINUATION_STATUSES; do
        [[ "$status" == "$s" ]] && return 0
      done
      return 1
      ;;
    *)
      [[ "$status" == "approved_for_implementation" ]]
      ;;
  esac
}

# Resolves the idea linked to a run and reports whether its implementation
# approval is still valid. Prints "kind\tworkspace\tidea_id\tstatus\tapproved"
# and returns 0 when an idea record was found at all (regardless of whether
# it is approved -- callers check status/approved themselves); returns 1 only
# when no idea can be resolved (legacy run, or nothing selected yet).
#
# Linkage is resolved two ways: an explicit .e3d-pilot/runs/<id>/idea-link.txt
# (kind\tworkspace\tidea_id) written by `ideas implement` for runs it creates
# itself, or -- for the default discover/ideate/draft/... pipeline, where no
# such file exists -- deterministically from the run's own selected candidate
# via the same stable-ID formula ideate-time materialization already used, so
# no separate linking step is required for the common path.
resolve_run_idea_info() {
  local repo="$1" run_id="$2"
  local run_dir kind workspace idea_id link_file candidates_file selected
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  link_file="$run_dir/idea-link.txt"
  if [[ -f "$link_file" ]]; then
    IFS=$'\t' read -r kind workspace idea_id < "$link_file"
  else
    kind="repo"
    workspace="$(ideas_canonical_path "$repo")" || return 1
    candidates_file="$run_dir/candidates.md"
    [[ -f "$candidates_file" ]] || return 1
    selected="$(candidates_selected_field "$candidates_file" 2>/dev/null || true)"
    [[ -n "$selected" && "$selected" != "none" ]] || return 1
    idea_id="$(ideas_stable_id "$kind" "$workspace" "$run_id" "$selected")"
  fi

  local snapshot status approval_digest current_digest approved=0
  snapshot="$(ideas_snapshots_dir "$kind" "$workspace")/$idea_id/idea.json"
  if [[ ! -f "$snapshot" ]]; then
    ideas_rebuild "$kind" "$workspace" >/dev/null 2>&1 || true
    snapshot="$(ideas_snapshots_dir "$kind" "$workspace")/$idea_id/idea.json"
  fi
  [[ -f "$snapshot" ]] || return 1

  status="$(jq -r '.status' "$snapshot")"
  approval_digest="$(jq -r '.implementation_approval.digest // empty' "$snapshot")"
  if [[ -n "$approval_digest" ]]; then
    current_digest="$(ideas_decision_digest_from_json "$snapshot")"
    [[ "$approval_digest" == "$current_digest" ]] && approved=1
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$workspace" "$idea_id" "$status" "$approved"
}

# Defense-in-depth: called at the top of draft/negotiate/execute/review/
# publish so that a mutating stage can never run against source code without
# a currently-valid implementation approval, whether reached via `run --stage
# all` or a direct single-stage invocation. Respects the per-repo
# approval.implementation_required escape hatch (default true).
require_valid_implementation_approval() {
  local repo="$1" run_id="$2" stage_name="$3" config_file required info kind workspace idea_id status approved
  config_file="$(config_path_for_repo "$repo")"
  required="$(config_approval_implementation_required "$config_file")"
  [[ "$required" == "true" ]] || return 0

  if ! info="$(resolve_run_idea_info "$repo" "$run_id")"; then
    die "$stage_name refuses to run: no idea record is linked to run $run_id. Legacy runs created before approval-gated ideas have no implicit approval and are never silently grandfathered in. Re-run 'e3d-pilot run --repo $repo --stage ideate --run-id $run_id' to materialize idea records for this run's candidates, then approve the one you want with 'e3d-pilot ideas approve --repo $repo <idea-id>' before retrying $stage_name."
  fi
  IFS=$'\t' read -r kind workspace idea_id status approved <<<"$info"
  if ! idea_stage_approval_ok "$stage_name" "$status" "$approved"; then
    if [[ "$approved" != "1" && "$status" == approved_for_implementation ]]; then
      die "$stage_name refuses to run: idea $idea_id's implementation approval digest no longer matches its current decision-bearing content (it changed after approval). Re-review and approve again: e3d-pilot ideas approve --repo $repo $idea_id"
    fi
    die "$stage_name refuses to run: idea $idea_id is not approved for implementation (status: $status). Approve it first: e3d-pilot ideas approve --repo $repo $idea_id"
  fi
}

# ─── implementation orchestration (Phase 5) ─────────────────────────────────

idea_approval_digest_valid() {
  local file="$1" approval_digest current_digest
  approval_digest="$(jq -r '.implementation_approval.digest // empty' "$file")"
  [[ -n "$approval_digest" ]] || return 1
  current_digest="$(ideas_decision_digest_from_json "$file")"
  [[ "$approval_digest" == "$current_digest" ]]
}

idea_status_can_start_implementation() {
  local status="$1"
  case "$status" in
    approved_for_implementation|changes_requested|implementation_failed) return 0 ;;
    *) return 1 ;;
  esac
}

idea_single_approved_base_sha() {
  local repo="$1" idea_file="$2" source_run_id approved_base=""
  approved_base="$(jq -r '.implementation.targets[0].base_sha // empty' "$idea_file")"
  if [[ -z "$approved_base" ]]; then
    source_run_id="$(jq -r '.source_run_id // empty' "$idea_file")"
    if [[ -n "$source_run_id" && -f "$(runs_dir_for_repo "$repo")/$source_run_id/findings.md" ]]; then
      approved_base="$(findings_head_sha "$(runs_dir_for_repo "$repo")/$source_run_id/findings.md" || true)"
    fi
  fi
  if [[ -z "$approved_base" ]]; then
    approved_base="$(repo_head_sha "$repo")"
  fi
  printf '%s' "$approved_base"
}

git_material_changes_since_base() {
  local repo="$1" base_sha="$2" path rel material=0
  [[ -n "$base_sha" ]] || return 1
  git -C "$repo" cat-file -e "$base_sha^{commit}" 2>/dev/null || return 1
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    rel="${path#./}"
    case "$rel" in
      .e3d-pilot|.e3d-pilot/*|.e3d-pilot-fleet|.e3d-pilot-fleet/*) ;;
      *) material=1 ;;
    esac
  done < <(git -C "$repo" diff --name-only "$base_sha"..HEAD -- . 2>/dev/null || true)
  [[ $material -eq 1 ]]
}

implementation_next_run_id() {
  local repo="$1" idea_id="$2" target_label="$3" base candidate counter
  base="impl-${idea_id#idea-}-${target_label}-$(date -u '+%Y%m%d%H%M%S')"
  candidate="$base"
  counter=2
  while [[ -e "$(runs_dir_for_repo "$repo")/$candidate" ]]; do
    candidate="${base}-${counter}"
    counter=$((counter + 1))
  done
  printf '%s' "$candidate"
}

write_idea_link() {
  local run_dir="$1" kind="$2" workspace="$3" idea_id="$4"
  printf '%s\t%s\t%s\n' "$kind" "$workspace" "$idea_id" > "$run_dir/idea-link.txt"
}

synthesize_run_candidate_artifacts() {
  local repo="$1" run_dir="$2" run_id="$3" idea_file="$4" approved_base="$5" selected="${6:-candidate-1}"
  local title summary dedup category analogy attraction retention revenue effort focus
  title="$(jq -r '.title // "Approved idea"' "$idea_file")"
  summary="$(jq -r '.summary // "Implement the approved idea."' "$idea_file")"
  dedup="$(jq -r '.dedup_rationale // "approved by human decision"' "$idea_file")"
  category="$(jq -r '.category // "other"' "$idea_file")"
  analogy="$(jq -r '.analogy // "none"' "$idea_file")"
  attraction="$(jq -r '(.scores.attraction // "-") | tostring' "$idea_file")"
  retention="$(jq -r '(.scores.retention // "-") | tostring' "$idea_file")"
  revenue="$(jq -r '(.scores.revenue // "-") | tostring' "$idea_file")"
  effort="$(jq -r '(.scores.effort // "medium") | tostring' "$idea_file")"
  focus="$(jq -r '.focus // "default"' "$idea_file")"
  printf '%s\n' "$focus" > "$run_dir/focus"
  {
    printf -- '---\n'
    printf 'head_sha: %s\n' "$approved_base"
    printf 'focus: %s\n' "$focus"
    printf 'implementation_run_id: %s\n' "$run_id"
    printf -- '---\n\n'
    printf '# Findings\n\n'
    printf '## Local State\n\n'
    printf 'Approved idea `%s` is being implemented for `%s`.\n\n' "$(jq -r '.idea_id' "$idea_file")" "$repo"
    printf '## External Context\n\n'
    printf '%s\n' "$summary"
  } > "$run_dir/findings.md"
  {
    printf -- '---\n'
    printf 'selected: %s\n' "$selected"
    printf 'reason: approved idea implementation\n'
    printf 'focus: %s\n' "$focus"
    printf -- '---\n\n'
    printf '# Candidates\n\n'
    printf '## Proposed Candidates\n\n'
    printf '### Candidate %s: %s\n' "${selected##candidate-}" "$title"
    printf 'Duplicate: no\n'
    printf 'Dedup rationale: %s\n' "$dedup"
    printf 'Category: %s\n' "$category"
    printf 'Analogy: %s\n' "$analogy"
    printf 'Attraction (1-5): %s\n' "$attraction"
    printf 'Retention (1-5): %s\n' "$retention"
    printf 'Effort: %s\n' "$effort"
    printf 'Revenue (1-5|n/a): %s\n' "$revenue"
    printf 'Description: %s\n' "$summary"
  } > "$run_dir/candidates.md"
}

prepare_repo_implementation_run() {
  local repo="$1" run_id="$2" idea_file="$3" approved_base="$4" kind="$5" workspace="$6" idea_id="$7" selected="${8:-}"
  local run_dir source_run source_dir name
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  mkdir -p "$run_dir"
  write_latest_run "$repo" "$run_id"
  write_idea_link "$run_dir" "$kind" "$workspace" "$idea_id"
  source_run="$(jq -r '.source_run_id // empty' "$idea_file")"
  source_dir="$(runs_dir_for_repo "$repo")/$source_run"
  if [[ -z "$selected" ]]; then
    selected="$(jq -r '.source_candidate // "candidate-1"' "$idea_file")"
  fi
  if [[ "$kind" == "repo" && -d "$source_dir" && -f "$source_dir/candidates.md" ]]; then
    for name in findings.md candidates.md focus discover-local-state.md discover-prompt.md discover-external-context.md ideate-facts.md ideate-prompt.md ideate-response.md; do
      [[ -f "$source_dir/$name" ]] && cp "$source_dir/$name" "$run_dir/$name"
    done
    [[ -f "$run_dir/findings.md" ]] || synthesize_run_candidate_artifacts "$repo" "$run_dir" "$run_id" "$idea_file" "$approved_base" "$selected"
  else
    synthesize_run_candidate_artifacts "$repo" "$run_dir" "$run_id" "$idea_file" "$approved_base" "$selected"
  fi
}

json_array_from_lines() {
  jq -R -s 'split("\n") | map(select(length > 0))'
}

implementation_verification_json() {
  local summary_file="$1" cmd="" status="" first=1 tick=$'\x60'
  printf '['
  [[ -f "$summary_file" ]] || { printf ']'; return 0; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      Command:\ *)
        cmd="${line#Command: }"
        cmd="${cmd#"$tick"}"
        cmd="${cmd%"$tick"}"
        ;;
      Exit\ Status:\ *)
        status="${line#Exit Status: }"
        status="${status#"$tick"}"
        status="${status%"$tick"}"
        if [[ -n "$cmd" ]]; then
          (( first == 0 )) && printf ','
          first=0
          jq -ncS --arg command "$cmd" --argjson exit_status "$status" '{command:$command,exit_status:$exit_status}'
          cmd=""
        fi
        ;;
    esac
  done < "$summary_file"
  printf ']'
}

publish_pr_number_from_url() {
  local url="$1"
  [[ "$url" =~ /pull/([0-9]+) ]] && printf '%s' "${BASH_REMATCH[1]}"
}

implementation_target_outcome_json() {
  local repo="$1" run_id="$2" approved_base="$3" actual_start="$4" status="$5" failure_stage="$6" failure_reason="$7" role="${8:-primary}" base_branch="${9:-}"
  local run_dir branch="" worktree="" diff_files="" diff_lines="" final_head="" backend="" pr_url="" pr_number="" review_outcome=""
  local commits_json changed_files_json verification_json failure_reason_file
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  if [[ -f "$run_dir/execute-worktree.txt" ]]; then
    branch="$(cut -f1 "$run_dir/execute-worktree.txt")"
    worktree="$(cut -f2 "$run_dir/execute-worktree.txt")"
  fi
  if [[ -f "$run_dir/execute-diff-summary.txt" ]]; then
    diff_files="$(publish_backend_field_value "$run_dir/execute-diff-summary.txt" "diff_files")"
    diff_lines="$(publish_backend_field_value "$run_dir/execute-diff-summary.txt" "diff_lines")"
  fi
  if [[ -f "$run_dir/review-status.txt" ]]; then
    review_outcome="$(review_status_value "$run_dir/review-status.txt" verify_status)"
  fi
  if [[ -f "$run_dir/publish-backend.out" ]]; then
    backend="$(publish_backend_field_value "$run_dir/publish-backend.out" "mode")"
    pr_url="$(publish_backend_field_value "$run_dir/publish-backend.out" "pr_url")"
    pr_number="$(publish_pr_number_from_url "$pr_url")"
  fi
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    final_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  fi
  commits_json="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-commits.XXXXXX")"
  changed_files_json="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-files.XXXXXX")"
  verification_json="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-verify.XXXXXX")"
  if [[ -n "$worktree" && -d "$worktree" && -n "$approved_base" ]]; then
    git -C "$worktree" rev-list --reverse "$approved_base"..HEAD 2>/dev/null | json_array_from_lines > "$commits_json"
    git -C "$worktree" diff --name-only "$approved_base"..HEAD -- . 2>/dev/null | json_array_from_lines > "$changed_files_json"
  else
    printf '[]\n' > "$commits_json"
    printf '[]\n' > "$changed_files_json"
  fi
  implementation_verification_json "$run_dir/review-verify-summary.md" > "$verification_json"
  # failure_reason can be an entire captured stage's stdout+stderr (e.g. a
  # verbose provider CLI transcript on execute failure) -- potentially
  # hundreds of KB. Passing that as a jq --arg risks "Argument list too
  # long" (E2BIG) on exec. Route it through a capped temp file instead.
  failure_reason_file="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-failure-reason.XXXXXX")"
  if [[ ${#failure_reason} -gt 8000 ]]; then
    printf '... (truncated, showing last 8000 of %d chars)\n' "${#failure_reason}" > "$failure_reason_file"
    printf '%s' "$failure_reason" | tail -c 8000 >> "$failure_reason_file"
  else
    printf '%s' "$failure_reason" > "$failure_reason_file"
  fi
  jq -ncS \
    --arg repo "$repo" \
    --arg run_id "$run_id" \
    --arg approved_base_sha "$approved_base" \
    --arg actual_start_sha "$actual_start" \
    --arg role "$role" \
    --arg base_branch "$base_branch" \
    --arg status "$status" \
    --arg branch "$branch" \
    --arg worktree "$worktree" \
    --arg failure_stage "$failure_stage" \
    --rawfile failure_reason "$failure_reason_file" \
    --arg final_head "$final_head" \
    --arg publish_backend "$backend" \
    --arg pr_url "$pr_url" \
    --arg pr_number "$pr_number" \
    --arg review_outcome "$review_outcome" \
    --argjson diff_files "${diff_files:-0}" \
    --argjson diff_lines "${diff_lines:-0}" \
    --slurpfile commits "$commits_json" \
    --slurpfile changed_files "$changed_files_json" \
    --slurpfile verification "$verification_json" \
    '{
      repo:$repo,
      role:$role,
      run_id:$run_id,
      approved_base_sha:$approved_base_sha,
      actual_start_sha:$actual_start_sha,
      base_branch:(if $base_branch == "" then null else $base_branch end),
      branch:(if $branch == "" then null else $branch end),
      worktree:(if $worktree == "" then null else $worktree end),
      commit_shas:$commits[0],
      changed_files:$changed_files[0],
      changed_lines:$diff_lines,
      changed_file_count:$diff_files,
      verification:$verification[0],
      review_outcome:(if $review_outcome == "" then null else $review_outcome end),
      publish_backend:(if $publish_backend == "" then null else $publish_backend end),
      pr_url:(if $pr_url == "" then null else $pr_url end),
      pr_number:(if $pr_number == "" then null else ($pr_number | tonumber) end),
      final_pr_head_sha:(if $final_head == "" then null else $final_head end),
      status:$status
    }
    | if $status == "failed" then .failure={stage:$failure_stage,reason:$failure_reason} else . end'
  rm -f "$commits_json" "$changed_files_json" "$verification_json" "$failure_reason_file"
}

implementation_outcome_file() {
  local idea_id="$1" overall_status="$2" targets_file="$3" failure_reason="${4:-}" out_file
  out_file="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-outcome.XXXXXX")"
  jq -ncS \
    --arg idea_id "$idea_id" \
    --arg status "$overall_status" \
    --arg failure_reason "$failure_reason" \
    --slurpfile targets "$targets_file" \
    '{
      type:"implementation",
      idea_id:$idea_id,
      status:$status,
      targets:$targets
    }
    | if $failure_reason != "" then .failure_reason=$failure_reason else . end' > "$out_file"
  printf '%s' "$out_file"
}

IMPLEMENTATION_STAGE_ORDER="draft negotiate execute review publish"

# Whether $stage's expected on-disk artifact for $run_dir already reflects a
# successful run of that stage. Shared by the fresh-implement pipeline (as a
# post-stage sanity check) and `ideas repair-run` (as a pre-flight check that
# every stage before the resume point genuinely already succeeded, rather
# than trusting run_id ownership alone).
implementation_stage_artifact_ok() {
  local run_dir="$1" stage="$2"
  case "$stage" in
    draft) [[ -f "$run_dir/spec-draft.md" ]] ;;
    negotiate) [[ -f "$run_dir/spec-final.md" ]] ;;
    execute) [[ -f "$run_dir/execute-worktree.txt" ]] ;;
    review) [[ "$(review_status_value "$run_dir/review-status.txt" verify_status 2>/dev/null || true)" == passed ]] ;;
    publish) [[ -f "$run_dir/publish-backend.out" ]] ;;
    *) return 1 ;;
  esac
}

implementation_stage_artifact_failure_reason() {
  local stage="$1"
  case "$stage" in
    draft) printf 'draft did not produce spec-draft.md' ;;
    negotiate) printf 'negotiate did not produce spec-final.md' ;;
    execute) printf 'execute did not produce worktree metadata' ;;
    review) printf 'review verification did not pass' ;;
    publish) printf 'publish did not produce backend output' ;;
  esac
}

# Runs stages $from_stage..publish (default: the full draft..publish
# pipeline) for $run_id, appending a stage log entry per attempt. A fresh
# draft-stage run truncates any prior stage log; resuming from a later stage
# (via `ideas repair-run`) appends, preserving the original run's history
# instead of erasing evidence of what already succeeded.
run_repo_implementation_pipeline() {
  local repo="$1" run_id="$2" approved_base="$3" actual_start="$4" target_out_file="$5" role="${6:-primary}" base_branch="${7:-}" from_stage="${8:-draft}"
  local stage output status run_dir started=0
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  if [[ "$from_stage" == "draft" ]]; then
    : > "$run_dir/implementation-stage-log.md"
  else
    printf '\n## resuming from %s\n\n' "$from_stage" >> "$run_dir/implementation-stage-log.md"
  fi
  for stage in $IMPLEMENTATION_STAGE_ORDER; do
    if [[ $started -eq 0 ]]; then
      [[ "$stage" == "$from_stage" ]] || continue
      started=1
    fi
    set +e
    output="$("$0" run --repo "$repo" --stage "$stage" --run-id "$run_id" 2>&1)"
    status=$?
    set -e
    {
      printf '## %s\n\n' "$stage"
      printf 'exit_status: %s\n\n```text\n%s\n```\n\n' "$status" "$output"
    } >> "$run_dir/implementation-stage-log.md"
    if [[ $status -ne 0 ]]; then
      implementation_target_outcome_json "$repo" "$run_id" "$approved_base" "$actual_start" failed "$stage" "$output" "$role" "$base_branch" > "$target_out_file"
      return 1
    fi
    implementation_stage_artifact_ok "$run_dir" "$stage" || {
      implementation_target_outcome_json "$repo" "$run_id" "$approved_base" "$actual_start" failed "$stage" "$(implementation_stage_artifact_failure_reason "$stage")" "$role" "$base_branch" > "$target_out_file"
      return 1
    }
  done
  implementation_target_outcome_json "$repo" "$run_id" "$approved_base" "$actual_start" succeeded "" "" "$role" "$base_branch" > "$target_out_file"
  return 0
}

ideas_do_implement_repo() {
  local repo="$1" idea_id="$2" canonical idea_file status approved_base actual_start run_id run_dir actor targets_tmp target_tmp outcome_tmp base_branch
  repo="$(repo_abs_path "$repo")"
  canonical="$(ideas_canonical_path "$repo")" || die "workspace not found: $repo"
  idea_file="$(ideas_require_snapshot repo "$canonical" "$idea_id")"
  status="$(jq -r '.status' "$idea_file")"
  idea_status_can_start_implementation "$status" || die "idea $idea_id cannot enter implementation from status: $status"
  idea_approval_digest_valid "$idea_file" || die "idea $idea_id does not have a current valid implementation approval"
  approved_base="$(idea_single_approved_base_sha "$repo" "$idea_file")"
  base_branch="$(config_value "$(config_path_for_repo "$repo")" '.pr.base_branch')"
  actual_start="$(repo_head_sha "$repo")"
  if [[ "$actual_start" != "$approved_base" ]] && git_material_changes_since_base "$repo" "$approved_base"; then
    die "idea $idea_id base SHA changed since approval ($approved_base -> $actual_start); refresh human approval before implementation"
  fi
  actor="$(ideas_resolve_actor "$repo" "")"
  case "$status" in
    implementation_failed)
      ideas_transition repo "$canonical" "$idea_id" implementation_retry_approved "$actor" "retry implementation" "" "" >/dev/null
      ;;
    *)
      ideas_transition repo "$canonical" "$idea_id" implementation_started "$actor" "implementation started" "" "" >/dev/null
      ;;
  esac
  project_tracking_sync_idea repo "$canonical" "$idea_id"
  run_id="$(implementation_next_run_id "$repo" "$idea_id" "repo")"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  prepare_repo_implementation_run "$repo" "$run_id" "$idea_file" "$approved_base" repo "$canonical" "$idea_id"
  targets_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-targets.XXXXXX")"
  target_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-target.XXXXXX")"
  if run_repo_implementation_pipeline "$repo" "$run_id" "$approved_base" "$actual_start" "$target_tmp" "primary" "$base_branch"; then
    cat "$target_tmp" > "$targets_tmp"
    outcome_tmp="$(implementation_outcome_file "$idea_id" succeeded "$targets_tmp")"
    ideas_transition repo "$canonical" "$idea_id" implementation_completed "$actor" "implementation completed" "" "" "$outcome_tmp" >/dev/null
    project_tracking_sync_idea repo "$canonical" "$idea_id"
    rm -f "$targets_tmp" "$target_tmp" "$outcome_tmp"
    printf 'ideas: implemented %s run=%s\n' "$idea_id" "$run_id"
    return 0
  fi
  cat "$target_tmp" > "$targets_tmp"
  outcome_tmp="$(implementation_outcome_file "$idea_id" failed "$targets_tmp" "target failed")"
  ideas_transition repo "$canonical" "$idea_id" implementation_failed "$actor" "implementation failed" "" "" "$outcome_tmp" >/dev/null
  project_tracking_sync_idea repo "$canonical" "$idea_id"
  rm -f "$targets_tmp" "$target_tmp" "$outcome_tmp"
  printf 'ideas: implementation failed for %s run=%s\n' "$idea_id" "$run_id"
  return 1
}

# Resumes a SPECIFIC prior run from a given stage (default: publish) instead
# of starting a brand-new run from draft. `ideas implement` always creates a
# fresh run_id and redoes draft/negotiate/execute from scratch on every
# retry, including when only the last stage (typically publish, e.g. after a
# missing forge label or a transient network error) failed on an otherwise
# fully verified and reviewed run -- discarding real, already-good work and
# re-spending real provider calls on stages whose output was never the
# problem. This repairs that one run in place: every stage strictly before
# `from_stage` must already have its expected success artifact on disk (not
# just be assumed), so this can't be used to skip real work, only to avoid
# redoing work that is already provably done.
ideas_do_repair_run() {
  local repo="$1" idea_id="$2" run_id="$3" from_stage="${4:-publish}"
  local canonical idea_file status approved_base actual_start run_dir actor
  local targets_tmp target_tmp outcome_tmp base_branch link_kind link_workspace link_idea stage
  case " $IMPLEMENTATION_STAGE_ORDER " in
    *" $from_stage "*) ;;
    *) die "unknown --from-stage: $from_stage (expected one of: $IMPLEMENTATION_STAGE_ORDER)" ;;
  esac

  repo="$(repo_abs_path "$repo")"
  canonical="$(ideas_canonical_path "$repo")" || die "workspace not found: $repo"
  idea_file="$(ideas_require_snapshot repo "$canonical" "$idea_id")"
  run_dir="$(runs_dir_for_repo "$repo")/$run_id"
  [[ -d "$run_dir" ]] || die "run not found: $run_id"

  [[ -f "$run_dir/idea-link.txt" ]] || die "run $run_id has no idea-link.txt; it was not created by 'ideas implement' and cannot be repaired"
  IFS=$'\t' read -r link_kind link_workspace link_idea < "$run_dir/idea-link.txt"
  [[ "$link_kind" == "repo" && "$link_idea" == "$idea_id" ]] || die "run $run_id is linked to idea $link_idea, not $idea_id; refusing to repair"

  status="$(jq -r '.status' "$idea_file")"
  [[ "$status" == "implementation_failed" ]] || die "ideas repair-run only applies to an idea currently in implementation_failed (status: $status); use 'ideas implement' for a fresh attempt"
  idea_approval_digest_valid "$idea_file" || die "idea $idea_id does not have a current valid implementation approval; approve again before repairing"

  for stage in $IMPLEMENTATION_STAGE_ORDER; do
    [[ "$stage" == "$from_stage" ]] && break
    implementation_stage_artifact_ok "$run_dir" "$stage" || die "run $run_id has no successful $stage output on disk; cannot resume from $from_stage. Use 'ideas implement' for a fresh attempt."
  done

  approved_base="$(idea_single_approved_base_sha "$repo" "$idea_file")"
  base_branch="$(config_value "$(config_path_for_repo "$repo")" '.pr.base_branch')"
  actual_start="$(repo_head_sha "$repo")"
  if [[ "$actual_start" != "$approved_base" ]] && git_material_changes_since_base "$repo" "$approved_base"; then
    die "idea $idea_id base SHA changed since approval ($approved_base -> $actual_start); refresh human approval before repairing"
  fi

  actor="$(ideas_resolve_actor "$repo" "")"
  ideas_transition repo "$canonical" "$idea_id" implementation_retry_approved "$actor" "repair run $run_id from $from_stage" "" "" >/dev/null
  project_tracking_sync_idea repo "$canonical" "$idea_id"

  targets_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-targets.XXXXXX")"
  target_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-implementation-target.XXXXXX")"
  if run_repo_implementation_pipeline "$repo" "$run_id" "$approved_base" "$actual_start" "$target_tmp" "primary" "$base_branch" "$from_stage"; then
    cat "$target_tmp" > "$targets_tmp"
    outcome_tmp="$(implementation_outcome_file "$idea_id" succeeded "$targets_tmp")"
    ideas_transition repo "$canonical" "$idea_id" implementation_completed "$actor" "implementation completed (repaired run $run_id from $from_stage)" "" "" "$outcome_tmp" >/dev/null
    project_tracking_sync_idea repo "$canonical" "$idea_id"
    rm -f "$targets_tmp" "$target_tmp" "$outcome_tmp"
    printf 'ideas: repaired %s run=%s from=%s\n' "$idea_id" "$run_id" "$from_stage"
    return 0
  fi
  cat "$target_tmp" > "$targets_tmp"
  outcome_tmp="$(implementation_outcome_file "$idea_id" failed "$targets_tmp" "target failed during repair")"
  ideas_transition repo "$canonical" "$idea_id" implementation_failed "$actor" "implementation failed (repair run $run_id from $from_stage)" "" "" "$outcome_tmp" >/dev/null
  project_tracking_sync_idea repo "$canonical" "$idea_id"
  rm -f "$targets_tmp" "$target_tmp" "$outcome_tmp"
  printf 'ideas: repair failed for %s run=%s from=%s\n' "$idea_id" "$run_id" "$from_stage"
  return 1
}

implementation_skipped_target_json() {
  local repo="$1" approved_base="$2" role="$3" base_branch="$4" reason="$5"
  jq -ncS \
    --arg repo "$repo" \
    --arg approved_base_sha "$approved_base" \
    --arg role "$role" \
    --arg base_branch "$base_branch" \
    --arg reason "$reason" \
    '{
      repo:$repo,
      role:$role,
      run_id:null,
      approved_base_sha:$approved_base_sha,
      actual_start_sha:null,
      base_branch:(if $base_branch == "" then null else $base_branch end),
      branch:null,
      worktree:null,
      commit_shas:[],
      changed_files:[],
      changed_lines:0,
      changed_file_count:0,
      verification:[],
      review_outcome:null,
      publish_backend:null,
      pr_url:null,
      pr_number:null,
      final_pr_head_sha:null,
      status:"skipped",
      failure:{stage:"not_started",reason:$reason}
    }'
}

ideas_do_implement_fleet() {
  local fleet_file="$1" idea_id="$2" continue_on_failure="${3:-0}"
  local workspace idea_file status actor targets_count targets_tmp target_tmp outcome_tmp idx failed=0 stop_remaining=0 failure_reason=""
  [[ -f "$fleet_file" ]] || die "fleet file not found: $fleet_file"
  workspace="$(cd "$(dirname "$fleet_file")" && pwd -P)"
  idea_file="$(ideas_require_snapshot fleet "$workspace" "$idea_id")"
  status="$(jq -r '.status' "$idea_file")"
  idea_status_can_start_implementation "$status" || die "fleet idea $idea_id cannot enter implementation from status: $status"
  idea_approval_digest_valid "$idea_file" || die "fleet idea $idea_id does not have a current valid implementation approval"
  targets_count="$(jq '.implementation.targets | length' "$idea_file")"
  (( targets_count > 0 )) || die "fleet idea $idea_id has no approved implementation targets"
  actor="$(ideas_resolve_actor "$workspace" "")"
  case "$status" in
    implementation_failed)
      ideas_transition fleet "$workspace" "$idea_id" implementation_retry_approved "$actor" "retry implementation" "" "" >/dev/null
      ;;
    *)
      ideas_transition fleet "$workspace" "$idea_id" implementation_started "$actor" "implementation started" "" "" >/dev/null
      ;;
  esac
  project_tracking_sync_idea fleet "$workspace" "$idea_id"

  targets_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-fleet-implementation-targets.XXXXXX")"
  : > "$targets_tmp"
  for ((idx=0; idx<targets_count; idx++)); do
    local repo role approved_base base_branch actual_start run_id
    repo="$(jq -r --argjson i "$idx" '.implementation.targets[$i].path' "$idea_file")"
    role="$(jq -r --argjson i "$idx" '.implementation.targets[$i].role // "target"' "$idea_file")"
    approved_base="$(jq -r --argjson i "$idx" '.implementation.targets[$i].base_sha' "$idea_file")"
    base_branch="$(jq -r --argjson i "$idx" '.implementation.targets[$i].base_branch // empty' "$idea_file")"
    if (( stop_remaining )); then
      implementation_skipped_target_json "$repo" "$approved_base" "$role" "$base_branch" "previous target failed" >> "$targets_tmp"
      continue
    fi
    repo="$(repo_abs_path "$repo")"
    actual_start="$(repo_head_sha "$repo")"
    run_id="$(implementation_next_run_id "$repo" "$idea_id" "target-$((idx + 1))")"
    target_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-fleet-implementation-target.XXXXXX")"
    if [[ "$actual_start" != "$approved_base" ]] && git_material_changes_since_base "$repo" "$approved_base"; then
      implementation_target_outcome_json "$repo" "$run_id" "$approved_base" "$actual_start" failed "base-check" "target base SHA changed since approval" "$role" "$base_branch" > "$target_tmp"
      cat "$target_tmp" >> "$targets_tmp"
      failed=1
      failure_reason="target failed"
      (( continue_on_failure )) || stop_remaining=1
      rm -f "$target_tmp"
      continue
    fi
    prepare_repo_implementation_run "$repo" "$run_id" "$idea_file" "$approved_base" fleet "$workspace" "$idea_id" "candidate-1"
    if run_repo_implementation_pipeline "$repo" "$run_id" "$approved_base" "$actual_start" "$target_tmp" "$role" "$base_branch"; then
      cat "$target_tmp" >> "$targets_tmp"
    else
      cat "$target_tmp" >> "$targets_tmp"
      failed=1
      failure_reason="target failed"
      (( continue_on_failure )) || stop_remaining=1
    fi
    rm -f "$target_tmp"
  done

  if (( failed )); then
    outcome_tmp="$(implementation_outcome_file "$idea_id" failed "$targets_tmp" "$failure_reason")"
    ideas_transition fleet "$workspace" "$idea_id" implementation_failed "$actor" "implementation failed" "" "" "$outcome_tmp" >/dev/null
    project_tracking_sync_idea fleet "$workspace" "$idea_id"
    rm -f "$targets_tmp" "$outcome_tmp"
    printf 'fleet ideas: implementation failed for %s\n' "$idea_id"
    return 1
  fi
  outcome_tmp="$(implementation_outcome_file "$idea_id" succeeded "$targets_tmp")"
  ideas_transition fleet "$workspace" "$idea_id" implementation_completed "$actor" "implementation completed" "" "" "$outcome_tmp" >/dev/null
  project_tracking_sync_idea fleet "$workspace" "$idea_id"
  rm -f "$targets_tmp" "$outcome_tmp"
  printf 'fleet ideas: implemented %s targets=%s\n' "$idea_id" "$targets_count"
}

ideas_approved_queue() {
  local kind="$1" workspace="$2" canonical dir
  canonical="$(ideas_canonical_path "$workspace")" || return 1
  dir="$(ideas_snapshots_dir "$kind" "$canonical")"
  [[ -d "$dir" ]] || return 0
  find "$dir" -mindepth 2 -maxdepth 2 -name idea.json -print0 \
    | xargs -0 jq -r 'select(.status=="approved_for_implementation") | [.created_at,.idea_id] | @tsv' 2>/dev/null \
    | sort -k1,1 -k2,2 \
    | cut -f2
}

ideas_do_implement_approved_repo() {
  local repo="$1" idea_id failures=0 any=0 status
  repo="$(repo_abs_path "$repo")"
  while IFS= read -r idea_id; do
    [[ -n "$idea_id" ]] || continue
    any=1
    set +e
    "$0" ideas implement --repo "$repo" "$idea_id"
    status=$?
    set -e
    [[ $status -eq 0 ]] || failures=$((failures + 1))
  done < <(ideas_approved_queue repo "$repo")
  [[ $any -eq 1 ]] || printf 'ideas: no approved ideas to implement\n'
  [[ $failures -eq 0 ]]
}

ideas_do_implement_approved_fleet() {
  local fleet_file="$1" continue_on_failure="${2:-0}" workspace idea_id failures=0 any=0 status
  [[ -f "$fleet_file" ]] || die "fleet file not found: $fleet_file"
  workspace="$(cd "$(dirname "$fleet_file")" && pwd -P)"
  while IFS= read -r idea_id; do
    [[ -n "$idea_id" ]] || continue
    any=1
    set +e
    "$0" fleet ideas "$fleet_file" implement "$idea_id" $( (( continue_on_failure )) && printf '%s' "--continue-on-target-failure" )
    status=$?
    set -e
    [[ $status -eq 0 ]] || failures=$((failures + 1))
  done < <(ideas_approved_queue fleet "$workspace")
  [[ $any -eq 1 ]] || printf 'fleet ideas: no approved ideas to implement\n'
  [[ $failures -eq 0 ]]
}

# ─── merge approval and merge orchestration (Phase 6) ─────────────────────────

idea_status_can_approve_merge() {
  local status="$1"
  case "$status" in
    implemented|changes_requested) return 0 ;;
    *) return 1 ;;
  esac
}

implementation_success_targets_json() {
  local idea_file="$1"
  jq -cS '
    (.outcomes // [])
    | (map(select(.type=="implementation" and .status=="succeeded")) | .[-1].targets) // []
    | map(select(.status=="succeeded"))
  ' "$idea_file"
}

gh_pr_view_json() {
  local repo="$1" pr_ref="$2" fields="$3"
  command -v gh >/dev/null 2>&1 || die "gh CLI unavailable for GitHub merge operations"
  (cd "$repo" && gh pr view "$pr_ref" --json "$fields")
}

gh_pr_json_field() {
  local json="$1" filter="$2"
  jq -r "$filter // empty" <<<"$json"
}

merge_pr_number_from_metadata() {
  local metadata="$1" fallback="$2"
  local number
  number="$(gh_pr_json_field "$metadata" '.number')"
  [[ -n "$number" && "$number" != "null" ]] && { printf '%s' "$number"; return 0; }
  printf '%s' "$fallback"
}

merge_require_target_ready_for_approval() {
  local target_json="$1" idx="$2"
  local status review_count verify_count backend pr_url branch
  status="$(jq -r '.status // empty' <<<"$target_json")"
  review_count="$(jq '[.verification[]? | select((.exit_status // 1) == 0)] | length' <<<"$target_json")"
  verify_count="$review_count"
  backend="$(jq -r '.publish_backend // empty' <<<"$target_json")"
  pr_url="$(jq -r '.pr_url // empty' <<<"$target_json")"
  branch="$(jq -r '.branch // empty' <<<"$target_json")"
  [[ "$status" == "succeeded" ]] || die "merge approval requires target $((idx + 1)) to have succeeded implementation"
  (( verify_count > 0 )) || die "merge approval requires target $((idx + 1)) to have passing verification"
  case "$backend" in
    github) [[ -n "$pr_url" ]] || die "merge approval requires target $((idx + 1)) to have an open GitHub PR" ;;
    local) [[ -n "$branch" ]] || die "merge approval requires target $((idx + 1)) to have a local review branch" ;;
    *) die "merge approval requires target $((idx + 1)) to have a supported publish backend" ;;
  esac
}

build_merge_approval_targets_json() {
  local idea_file="$1" out_file="$2" actor="$3"
  local targets_json count idx target_tmp lines_tmp repo backend pr_url pr_number branch base_branch head_sha metadata state is_draft ready_marked role
  targets_json="$(implementation_success_targets_json "$idea_file")"
  count="$(jq 'length' <<<"$targets_json")"
  (( count > 0 )) || die "idea $(jq -r '.idea_id' "$idea_file") has no successful implementation targets to approve for merge"
  lines_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-approval-lines.XXXXXX")"
  : > "$lines_tmp"
  for ((idx=0; idx<count; idx++)); do
    target_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-target.XXXXXX")"
    jq -cS --argjson i "$idx" '.[$i]' <<<"$targets_json" > "$target_tmp"
    merge_require_target_ready_for_approval "$(cat "$target_tmp")" "$idx"
    repo="$(jq -r '.repo' "$target_tmp")"
    backend="$(jq -r '.publish_backend' "$target_tmp")"
    role="$(jq -r '.role // "target"' "$target_tmp")"
    base_branch="$(jq -r '.base_branch // empty' "$target_tmp")"
    pr_url="$(jq -r '.pr_url // empty' "$target_tmp")"
    pr_number="$(jq -r '.pr_number // empty' "$target_tmp")"
    branch="$(jq -r '.branch // empty' "$target_tmp")"
    ready_marked=false
    if [[ "$backend" == "github" ]]; then
      metadata="$(gh_pr_view_json "$repo" "$pr_url" "number,url,isDraft,headRefOid,baseRefName,state")"
      state="$(gh_pr_json_field "$metadata" '.state')"
      [[ "$state" == "OPEN" || "$state" == "open" ]] || die "merge approval requires target $((idx + 1)) PR to be open"
      is_draft="$(gh_pr_json_field "$metadata" '.isDraft')"
      if [[ "$is_draft" == "true" ]]; then
        (cd "$repo" && gh pr ready "$pr_url")
        ready_marked=true
        metadata="$(gh_pr_view_json "$repo" "$pr_url" "number,url,isDraft,headRefOid,baseRefName,state")"
      fi
      pr_url="$(gh_pr_json_field "$metadata" '.url')"
      pr_number="$(merge_pr_number_from_metadata "$metadata" "$pr_number")"
      base_branch="$(gh_pr_json_field "$metadata" '.baseRefName')"
      head_sha="$(gh_pr_json_field "$metadata" '.headRefOid')"
      [[ -n "$head_sha" ]] || die "merge approval could not observe target $((idx + 1)) PR head SHA"
    else
      head_sha="$(jq -r '.final_pr_head_sha // empty' "$target_tmp")"
      [[ -n "$head_sha" ]] || die "merge approval could not observe target $((idx + 1)) local branch head SHA"
    fi
    jq -ncS \
      --arg repo "$repo" --arg role "$role" --arg backend "$backend" --arg pr_url "$pr_url" \
      --arg pr_number "$pr_number" --arg base_branch "$base_branch" --arg head_sha "$head_sha" \
      --arg branch "$branch" --argjson ready_marked "$ready_marked" \
      '{
        repo:$repo,
        role:$role,
        publish_backend:$backend,
        pr_url:(if $pr_url == "" then null else $pr_url end),
        pr_number:(if $pr_number == "" or $pr_number == "null" then null else ($pr_number | tonumber) end),
        base_branch:$base_branch,
        head_sha:$head_sha,
        branch:(if $branch == "" then null else $branch end),
        ready_action_recorded:$ready_marked
      }' >> "$lines_tmp"
    rm -f "$target_tmp"
  done
  jq -s -cS '.' "$lines_tmp" > "$out_file"
  rm -f "$lines_tmp"
}

ideas_do_approve_merge() {
  local kind="$1" workspace="$2" context_dir="$3" idea_id="$4" actor_explicit="$5" note="$6"
  local canonical idea_file status actor targets_tmp
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  idea_file="$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")"
  status="$(jq -r '.status' "$idea_file")"
  idea_status_can_approve_merge "$status" || die "idea $idea_id is not eligible for merge approval (status: $status)"
  actor="$(ideas_resolve_actor "$context_dir" "$actor_explicit")"
  targets_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-approval-targets.XXXXXX")"
  build_merge_approval_targets_json "$idea_file" "$targets_tmp" "$actor"
  ideas_transition "$kind" "$canonical" "$idea_id" merge_approved "$actor" "$note" "$targets_tmp" "" >/dev/null
  project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
  rm -f "$targets_tmp"
  printf 'ideas: approved merge for %s targets=%s\n' "$idea_id" "$(jq '.merge_approval.targets | length' "$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")")"
}

merge_approval_valid() {
  local idea_file="$1"
  [[ "$(jq -r '.status' "$idea_file")" == "approved_for_merge" ]] || return 1
  [[ "$(jq -r '.merge_approval.targets | length' "$idea_file")" -gt 0 ]] || return 1
}

merge_result_target_json() {
  local approved_target="$1" status="$2" merge_sha="$3" failure_stage="$4" failure_reason="$5"
  jq -cS \
    --arg status "$status" --arg merge_sha "$merge_sha" \
    --arg failure_stage "$failure_stage" --arg failure_reason "$failure_reason" \
    '. + {
      status:$status,
      merge_sha:(if $merge_sha == "" then null else $merge_sha end)
    }
    | if $status == "failed" then .failure={stage:$failure_stage,reason:$failure_reason} else . end' \
    <<<"$approved_target"
}

merge_outcome_file() {
  local idea_id="$1" status="$2" targets_file="$3" failure_reason="${4:-}" out_file
  out_file="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-outcome.XXXXXX")"
  jq -ncS \
    --arg idea_id "$idea_id" --arg status "$status" --arg failure_reason "$failure_reason" \
    --slurpfile targets "$targets_file" \
    '{
      type:"merge",
      idea_id:$idea_id,
      status:$status,
      targets:$targets
    }
    | if $failure_reason != "" then .failure_reason=$failure_reason else . end' > "$out_file"
  printf '%s' "$out_file"
}

preflight_merge_targets() {
  local idea_file="$1" observed_file="$2"
  local count idx approved metadata current_head current_base current_draft current_state backend repo pr_url approved_head approved_base
  count="$(jq '.merge_approval.targets | length' "$idea_file")"
  (( count > 0 )) || { printf 'error: idea %s has no merge approval targets\n' "$(jq -r '.idea_id' "$idea_file")" >&2; return 1; }
  : > "$observed_file"
  for ((idx=0; idx<count; idx++)); do
    approved="$(jq -cS --argjson i "$idx" '.merge_approval.targets[$i]' "$idea_file")"
    backend="$(jq -r '.publish_backend' <<<"$approved")"
    repo="$(jq -r '.repo' <<<"$approved")"
    pr_url="$(jq -r '.pr_url // empty' <<<"$approved")"
    approved_head="$(jq -r '.head_sha' <<<"$approved")"
    approved_base="$(jq -r '.base_branch' <<<"$approved")"
    if [[ "$backend" == "local" ]]; then
      printf 'error: local merge backend is not implemented; merge approval remains recorded for idea %s\n' "$(jq -r '.idea_id' "$idea_file")" >&2
      return 2
    fi
    [[ "$backend" == "github" ]] || { printf 'error: unsupported merge backend for target %s: %s\n' "$((idx + 1))" "$backend" >&2; return 1; }
    metadata="$(gh_pr_view_json "$repo" "$pr_url" "number,url,isDraft,headRefOid,baseRefName,state,mergeCommit")"
    current_state="$(gh_pr_json_field "$metadata" '.state')"
    [[ "$current_state" == "OPEN" || "$current_state" == "open" ]] || { printf 'error: merge preflight failed for target %s: PR is not open\n' "$((idx + 1))" >&2; return 1; }
    current_draft="$(gh_pr_json_field "$metadata" '.isDraft')"
    [[ "$current_draft" != "true" ]] || { printf 'error: merge preflight failed for target %s: PR is draft; run approve-merge so readiness is recorded\n' "$((idx + 1))" >&2; return 1; }
    current_head="$(gh_pr_json_field "$metadata" '.headRefOid')"
    current_base="$(gh_pr_json_field "$metadata" '.baseRefName')"
    [[ "$current_head" == "$approved_head" ]] || { printf 'error: approval-stale: target %s head SHA changed after merge approval (%s -> %s)\n' "$((idx + 1))" "$approved_head" "$current_head" >&2; return 1; }
    [[ "$current_base" == "$approved_base" ]] || { printf 'error: approval-stale: target %s base branch changed after merge approval (%s -> %s)\n' "$((idx + 1))" "$approved_base" "$current_base" >&2; return 1; }
    jq -ncS --argjson approved "$approved" --argjson metadata "$metadata" '$approved + {current_pr:$metadata}' >> "$observed_file"
  done
}

ideas_do_merge() {
  local kind="$1" workspace="$2" idea_id="$3"
  local canonical idea_file actor observed_tmp results_tmp count idx target pr_url merge_out result merge_sha outcome_tmp merged_count=0 failure_reason="" status event
  canonical="$(ideas_canonical_path "$workspace")" || die "workspace not found: $workspace"
  idea_file="$(ideas_require_snapshot "$kind" "$canonical" "$idea_id")"
  merge_approval_valid "$idea_file" || die "merge refuses to run without current ledger approval. Approve first: e3d-pilot ideas approve-merge --repo $workspace $idea_id"
  actor="$(ideas_resolve_actor "$canonical" "")"
  observed_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-observed.XXXXXX")"
  results_tmp="$(mktemp "${TMPDIR:-/tmp}/e3d-merge-results.XXXXXX")"
  set +e
  preflight_merge_targets "$idea_file" "$observed_tmp"
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    if [[ $status -ne 2 ]]; then
      outcome_tmp="$(merge_outcome_file "$idea_id" failed "$results_tmp" "merge preflight failed")"
      ideas_transition "$kind" "$canonical" "$idea_id" merge_failed "$actor" "merge preflight failed" "" "" "$outcome_tmp" >/dev/null
      project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
      rm -f "$outcome_tmp"
    fi
    rm -f "$observed_tmp" "$results_tmp"
    return 1
  fi
  : > "$results_tmp"
  count="$(jq -s 'length' "$observed_tmp")"
  for ((idx=0; idx<count; idx++)); do
    target="$(jq -cS --argjson i "$idx" -s '.[$i]' "$observed_tmp")"
    pr_url="$(jq -r '.pr_url' <<<"$target")"
    set +e
    merge_out="$(cd "$(jq -r '.repo' <<<"$target")" && gh pr merge "$pr_url" --squash --delete-branch 2>&1)"
    status=$?
    set -e
    if [[ $status -ne 0 ]]; then
      failure_reason="$merge_out"
      result="$(merge_result_target_json "$target" failed "" "gh-pr-merge" "$failure_reason")"
      printf '%s\n' "$result" >> "$results_tmp"
      outcome_tmp="$(merge_outcome_file "$idea_id" failed <(printf '%s\n' "$result") "$failure_reason")"
      ideas_transition "$kind" "$canonical" "$idea_id" merge_target_failed "$actor" "merge target failed" "" "" "$outcome_tmp" >/dev/null
      rm -f "$outcome_tmp"
      break
    fi
    merge_sha="$(gh_pr_view_json "$(jq -r '.repo' <<<"$target")" "$pr_url" "mergeCommit,state" | jq -r '.mergeCommit.oid // .mergeCommit.sha // empty')"
    [[ -n "$merge_sha" ]] || merge_sha="$(printf '%s\n' "$merge_out" | grep -Eo '[0-9a-f]{40}' | head -n1 || true)"
    result="$(merge_result_target_json "$target" merged "$merge_sha" "" "")"
    printf '%s\n' "$result" >> "$results_tmp"
    merged_count=$((merged_count + 1))
    outcome_tmp="$(merge_outcome_file "$idea_id" succeeded <(printf '%s\n' "$result"))"
    ideas_transition "$kind" "$canonical" "$idea_id" merge_target_merged "$actor" "merge target merged" "" "" "$outcome_tmp" >/dev/null
    rm -f "$outcome_tmp"
  done
  if (( merged_count == count )); then
    event="merge_completed"
    status="succeeded"
    failure_reason=""
  elif (( merged_count > 0 )); then
    event="merge_partially_completed"
    status="partial"
  else
    event="merge_failed"
    status="failed"
  fi
  outcome_tmp="$(merge_outcome_file "$idea_id" "$status" "$results_tmp" "$failure_reason")"
  ideas_transition "$kind" "$canonical" "$idea_id" "$event" "$actor" "merge $status" "" "" "$outcome_tmp" >/dev/null
  project_tracking_sync_idea "$kind" "$canonical" "$idea_id"
  rm -f "$observed_tmp" "$results_tmp" "$outcome_tmp"
  if [[ "$event" == "merge_completed" ]]; then
    printf 'ideas: merged %s targets=%s\n' "$idea_id" "$count"
    return 0
  fi
  printf 'ideas: merge %s for %s\n' "$status" "$idea_id"
  return 1
}

ideas_merge_approved_queue() {
  local kind="$1" workspace="$2" canonical dir
  canonical="$(ideas_canonical_path "$workspace")" || return 1
  dir="$(ideas_snapshots_dir "$kind" "$canonical")"
  [[ -d "$dir" ]] || return 0
  find "$dir" -mindepth 2 -maxdepth 2 -name idea.json -print0 \
    | xargs -0 jq -r 'select(.status=="approved_for_merge" and ((.merge_approval.targets // []) | length > 0)) | [.merge_approval.approved_at,.idea_id] | @tsv' 2>/dev/null \
    | sort -k1,1 -k2,2 \
    | cut -f2
}

ideas_do_merge_approved_fleet() {
  local fleet_file="$1" workspace idea_id any=0 failures=0 status
  [[ -f "$fleet_file" ]] || die "fleet file not found: $fleet_file"
  workspace="$(cd "$(dirname "$fleet_file")" && pwd -P)"
  while IFS= read -r idea_id; do
    [[ -n "$idea_id" ]] || continue
    any=1
    set +e
    "$0" fleet ideas "$fleet_file" merge "$idea_id"
    status=$?
    set -e
    [[ $status -eq 0 ]] || failures=$((failures + 1))
  done < <(ideas_merge_approved_queue fleet "$workspace")
  [[ $any -eq 1 ]] || printf 'fleet ideas: no merge-approved ideas to merge\n'
  [[ $failures -eq 0 ]]
}

cmd_ideas() {
  local subcommand="${1:-}"
  shift || true
  case "$subcommand" in
    ingest)
      local repo="" run_id="" candidate_id="" candidate_json=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --run-id) run_id="${2:-}"; shift 2 ;;
          --candidate-id) candidate_id="${2:-}"; shift 2 ;;
          --candidate-json) candidate_json="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown ideas ingest argument: $1" ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas ingest requires --repo"
      [[ -n "$run_id" ]] || die "ideas ingest requires --run-id"
      [[ -n "$candidate_id" ]] || die "ideas ingest requires --candidate-id"
      [[ -f "$candidate_json" ]] || die "ideas ingest requires --candidate-json <file>"
      repo="$(repo_abs_path "$repo")"
      local ingested_idea_id
      ingested_idea_id="$(ideas_ingest_candidate repo "$repo" "$run_id" "$candidate_id" "$candidate_json")"
      project_tracking_sync_idea repo "$repo" "$ingested_idea_id"
      printf '%s\n' "$ingested_idea_id"
      ;;
    transition)
      local repo="" actor="" note="" targets_json="" head_sha=""
      local positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          --targets-json) targets_json="${2:-}"; shift 2 ;;
          --head-sha) head_sha="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas transition argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas transition requires --repo"
      [[ ${#positional[@]} -eq 2 ]] || die "usage: e3d-pilot ideas transition --repo <path> <idea-id> <event>"
      [[ -z "$targets_json" || -f "$targets_json" ]] || die "targets JSON not found: $targets_json"
      repo="$(repo_abs_path "$repo")"
      actor="$(ideas_resolve_actor "$repo" "$actor")"
      ideas_transition repo "$repo" "${positional[0]}" "${positional[1]}" "$actor" "$note" "$targets_json" "$head_sha"
      ;;
    list)
      local repo="" status_filter="" json_flag="0"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --status) status_filter="${2:-}"; shift 2 ;;
          --json) json_flag="1"; shift ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown ideas list argument: $1" ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas list requires --repo"
      repo="$(repo_abs_path "$repo")"
      ideas_do_list repo "$repo" "$status_filter" "$json_flag"
      ;;
    show)
      local repo="" json_flag="0" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --json) json_flag="1"; shift ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas show argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas show requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas show --repo <path> <idea-id>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_show repo "$repo" "${positional[0]}" "$json_flag"
      ;;
    approve)
      local repo="" actor="" note="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas approve argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas approve requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas approve --repo <path> <idea-id>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_approve repo "$repo" "$repo" "${positional[0]}" "$actor" "$note"
      ;;
    reject)
      local repo="" actor="" reason="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --actor) actor="${2:-}"; shift 2 ;;
          --reason) reason="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas reject argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas reject requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas reject --repo <path> <idea-id> --reason <text>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_reject repo "$repo" "$repo" "${positional[0]}" "$actor" "$reason"
      ;;
    request-changes)
      local repo="" actor="" reason="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --actor) actor="${2:-}"; shift 2 ;;
          --reason) reason="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas request-changes argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas request-changes requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas request-changes --repo <path> <idea-id> --reason <text>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_request_changes repo "$repo" "$repo" "${positional[0]}" "$actor" "$reason"
      ;;
    sync)
      local repo="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas sync argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas sync requires --repo"
      [[ ${#positional[@]} -le 1 ]] || die "usage: e3d-pilot ideas sync --repo <path> [<idea-id>]"
      repo="$(repo_abs_path "$repo")"
      ideas_do_sync repo "$repo" "${positional[0]:-}"
      ;;
    outcome)
      local repo="" window="" note="" metrics=() positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --window) window="${2:-}"; shift 2 ;;
          --metric) metrics+=("${2:-}"); shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas outcome argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas outcome requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas outcome --repo <path> <idea-id> --window <7d|30d|custom> --metric <key=value>... [--note <text>]"
      repo="$(repo_abs_path "$repo")"
      ideas_do_outcome repo "$repo" "$repo" "${positional[0]}" "$window" "$note" "${metrics[@]}"
      ;;
    mark-reverted)
      local repo="" reason="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --reason) reason="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas mark-reverted argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas mark-reverted requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas mark-reverted --repo <path> <idea-id> --reason <text>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_mark_reverted "$repo" "${positional[0]}" "$reason"
      ;;
    implement)
      local repo="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas implement argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas implement requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas implement --repo <path> <idea-id>"
      ideas_do_implement_repo "$repo" "${positional[0]}"
      ;;
    implement-approved)
      local repo=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown ideas implement-approved argument: $1" ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas implement-approved requires --repo"
      ideas_do_implement_approved_repo "$repo"
      ;;
    repair-run)
      local repo="" run_id="" from_stage="publish" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --run-id) run_id="${2:-}"; shift 2 ;;
          --from-stage) from_stage="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas repair-run argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas repair-run requires --repo"
      [[ -n "$run_id" ]] || die "ideas repair-run requires --run-id"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas repair-run --repo <path> --run-id <run-id> [--from-stage <stage>] <idea-id>"
      ideas_do_repair_run "$repo" "${positional[0]}" "$run_id" "$from_stage"
      ;;
    approve-merge)
      local repo="" actor="" note="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas approve-merge argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas approve-merge requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas approve-merge --repo <path> <idea-id>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_approve_merge repo "$repo" "$repo" "${positional[0]}" "$actor" "$note"
      ;;
    merge)
      local repo="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown ideas merge argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas merge requires --repo"
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot ideas merge --repo <path> <idea-id>"
      repo="$(repo_abs_path "$repo")"
      ideas_do_merge repo "$repo" "${positional[0]}"
      ;;
    rebuild)
      local repo=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --repo) repo="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown ideas rebuild argument: $1" ;;
        esac
      done
      [[ -n "$repo" ]] || die "ideas rebuild requires --repo"
      repo="$(repo_abs_path "$repo")"
      ideas_rebuild repo "$repo"
      printf 'ideas: rebuilt %s\n' "$repo"
      ;;
    ""|-h|--help)
      usage
      ;;
    *)
      die "unknown ideas subcommand: $subcommand"
      ;;
  esac
}

# Reports availability for the fixed provider set by delegating the actual
# check to each lib/providers/<name> script (E3D_PILOT_CHECK=1); no
# provider-specific logic lives here, so adding a fourth provider later only
# means adding its name to this list and its script under lib/providers/.
providers_list() {
  local provider script output status exit_code
  for provider in claude codex local devin; do
    script="$REPO_ROOT/lib/providers/$provider"
    [[ -x "$script" ]] || die "provider script missing or not executable: $script"
    if output="$(provider_availability_probe "$script")"; then
      exit_code=0
    else
      exit_code=$?
    fi
    if [[ $exit_code -eq 0 ]]; then
      status="available"
    else
      status="unavailable"
    fi
    printf '%-8s %-12s %s\n' "$provider" "$status" "$output"
  done
}

cmd_providers() {
  local subcommand="${1:-}"
  case "$subcommand" in
    list)
      providers_list
      ;;
    ""|-h|--help)
      usage
      ;;
    *)
      die "unknown providers subcommand: $subcommand"
      ;;
  esac
}

# ─── fleet prs helpers ────────────────────────────────────────────────────────

fleet_repo_gh_slug() {
  local repo="$1" remote
  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  [[ -n "$remote" ]] || return 1
  # handles git@github.com:owner/repo.git and https://github.com/owner/repo.git
  printf '%s' "$remote" | sed -E 's|.*github\.com[:/]||; s|\.git$||'
}

fleet_pr_candidate_summary() {
  local repo="$1" branch="$2"
  local run_id="${branch#e3d-pilot/}"
  local f="$repo/.e3d-pilot/runs/$run_id/candidates.md"
  [[ -f "$f" ]] || { printf '(unknown idea)|-|-|-'; return; }

  local selected_num
  selected_num="$(grep -m1 '^selected: candidate-' "$f" | grep -oE '[0-9]+$' || true)"
  [[ -n "$selected_num" ]] || { printf '(no candidate selected)|-|-|-'; return; }

  local idea="" attraction="" retention="" effort="" in_block=0
  idea="$(grep -m1 "^### Candidate ${selected_num}:" "$f" | sed "s/^### Candidate ${selected_num}: //" || true)"
  while IFS= read -r line; do
    if [[ "$line" =~ ^"### Candidate ${selected_num}:" ]]; then in_block=1; continue; fi
    [[ $in_block -eq 0 ]] && continue
    [[ "$line" =~ ^"### Candidate " || "$line" =~ ^"---IDEATE-STATUS---" ]] && break
    # Extract the value after the last ": " — avoids matching range notation like "(1-5)"
    [[ "$line" =~ ^Attraction ]] && attraction="$(printf '%s' "$line" | sed -E 's/.*: //')"
    [[ "$line" =~ ^Retention  ]] && retention="$(printf '%s' "$line" | sed -E 's/.*: //')"
    [[ "$line" =~ ^Effort     ]] && effort="$(printf '%s' "$line" | sed 's/^Effort: //')"
  done < "$f"
  # Use ASCII unit separator (0x1f) as field delimiter to avoid clashes with idea text
  printf '%s\x1f%s\x1f%s\x1f%s' "${idea:-(unknown idea)}" "${attraction:--}" "${retention:--}" "${effort:--}"
}

fleet_prs_find() {
  # Prints "<pr_url> <is_draft>" for the first open e3d-pilot PR matching action_repo.
  local action_repo="$1" repos=("${@:2}")
  local repo repo_name slug prs_json pr_url is_draft
  for repo in "${repos[@]}"; do
    repo_name="$(basename "$repo")"
    [[ "$repo_name" == "$action_repo" || "$repo" == "$action_repo" ]] || continue
    [[ -d "$repo" ]] || die "repository not found: $repo"
    slug="$(fleet_repo_gh_slug "$repo")" || die "no GitHub remote configured for $repo"
    prs_json="$(gh pr list --repo "$slug" --state open \
      --json url,isDraft,headRefName 2>/dev/null \
      | jq '[.[] | select(.headRefName | startswith("e3d-pilot/"))][0] // empty' || true)"
    [[ -n "$prs_json" ]] || die "no open e3d-pilot PR found for: $action_repo"
    pr_url="$(printf '%s' "$prs_json" | jq -r '.url')"
    is_draft="$(printf '%s' "$prs_json" | jq -r '.isDraft')"
    printf '%s %s' "$pr_url" "$is_draft"
    return 0
  done
  die "repo not found in fleet: $action_repo"
}

fleet_prs_find_idea_for_pr() {
  local fleet_file="$1" pr_url="$2" workspace dir file
  workspace="$(cd "$(dirname "$fleet_file")" && pwd -P)"
  dir="$(ideas_snapshots_dir fleet "$workspace")"
  [[ -d "$dir" ]] || return 1
  find "$dir" -mindepth 2 -maxdepth 2 -name idea.json -print0 \
    | xargs -0 jq -r --arg url "$pr_url" '
        select(any(.outcomes[]?.targets[]?; .pr_url == $url))
        | .idea_id
      ' 2>/dev/null \
    | head -n1
}

fleet_prs_require_merge_approval() {
  local fleet_file="$1" pr_url="$2" idea_id workspace idea_file current approved_head approved_base metadata current_head current_base
  workspace="$(cd "$(dirname "$fleet_file")" && pwd -P)"
  idea_id="$(fleet_prs_find_idea_for_pr "$fleet_file" "$pr_url")"
  if [[ -z "$idea_id" ]]; then
    die "fleet prs --merge refuses to bypass the idea ledger. Approve merge first: e3d-pilot fleet ideas $fleet_file approve-merge <idea-id>"
  fi
  idea_file="$(ideas_require_snapshot fleet "$workspace" "$idea_id")"
  if [[ "$(jq -r '.status' "$idea_file")" != "approved_for_merge" ]]; then
    die "fleet prs --merge refuses to bypass the idea ledger. Approve merge first: e3d-pilot fleet ideas $fleet_file approve-merge $idea_id"
  fi
  current="$(jq -cS --arg url "$pr_url" '.merge_approval.targets[]? | select(.pr_url == $url)' "$idea_file" | head -n1)"
  if [[ -z "$current" ]]; then
    die "fleet prs --merge refuses to bypass the idea ledger. Approve merge first: e3d-pilot fleet ideas $fleet_file approve-merge $idea_id"
  fi
  metadata="$(gh_pr_view_json "$(jq -r '.repo' <<<"$current")" "$pr_url" "headRefOid,baseRefName,isDraft,state")"
  [[ "$(jq -r '.isDraft // false' <<<"$metadata")" != "true" ]] || die "fleet prs --merge refuses draft PR without recorded ready action. Approve merge first: e3d-pilot fleet ideas $fleet_file approve-merge $idea_id"
  approved_head="$(jq -r '.head_sha' <<<"$current")"
  approved_base="$(jq -r '.base_branch' <<<"$current")"
  current_head="$(jq -r '.headRefOid // empty' <<<"$metadata")"
  current_base="$(jq -r '.baseRefName // empty' <<<"$metadata")"
  [[ "$current_head" == "$approved_head" && "$current_base" == "$approved_base" ]] || die "approval-stale: fleet prs --merge cannot merge $pr_url. Re-approve first: e3d-pilot fleet ideas $fleet_file approve-merge $idea_id"
  printf '%s' "$idea_id"
}

fleet_prs_act() {
  local fleet_file="$1" action="$2" action_repo="$3" repos=("${@:4}")
  local pr_info pr_url is_draft idea_id
  pr_info="$(fleet_prs_find "$action_repo" "${repos[@]}")"
  pr_url="${pr_info% *}"
  is_draft="${pr_info#* }"
  case "$action" in
    approve)
      [[ "$is_draft" == "true" ]] && { gh pr ready "$pr_url"; printf 'marked ready: %s\n' "$pr_url"; }
      gh pr review "$pr_url" --approve
      printf 'approved: %s\n' "$pr_url"
      ;;
    merge)
      idea_id="$(fleet_prs_require_merge_approval "$fleet_file" "$pr_url")"
      ideas_do_merge fleet "$(cd "$(dirname "$fleet_file")" && pwd -P)" "$idea_id"
      ;;
    close)
      gh pr close "$pr_url"
      printf 'closed: %s\n' "$pr_url"
      ;;
  esac
}

fleet_prs_list() {
  local repos=("$@") found=0 header_printed=0
  local repo repo_name slug prs_json seen_slugs=""
  for repo in "${repos[@]}"; do
    [[ -d "$repo" ]] || continue
    slug="$(fleet_repo_gh_slug "$repo" 2>/dev/null)" || continue
    [[ "$slug" == *"/"* ]] || continue
    # Skip duplicate remotes (e.g. e3d-trade appears in both fleet dir and external)
    [[ "$seen_slugs" == *"|${slug}|"* ]] && continue
    seen_slugs="${seen_slugs}|${slug}|"
    prs_json="$(gh pr list --repo "$slug" --state open \
      --json number,url,isDraft,headRefName 2>/dev/null \
      | jq '[.[] | select(.headRefName | startswith("e3d-pilot/"))]' || true)"
    [[ -n "$prs_json" && "$prs_json" != "[]" ]] || continue
    repo_name="$(basename "$repo")"
    while IFS= read -r pr; do
      local number url is_draft branch summary idea attraction retention effort status
      number="$(printf '%s' "$pr" | jq -r '.number')"
      url="$(printf '%s' "$pr" | jq -r '.url')"
      is_draft="$(printf '%s' "$pr" | jq -r '.isDraft')"
      branch="$(printf '%s' "$pr" | jq -r '.headRefName')"
      summary="$(fleet_pr_candidate_summary "$repo" "$branch")"
      # Fields separated by ASCII unit separator (0x1f)
      IFS=$'\x1f' read -r idea attraction retention effort <<< "$summary"
      [[ "$is_draft" == "true" ]] && status="DRAFT" || status="READY"
      if [[ $header_printed -eq 0 ]]; then
        printf '%-22s  %-5s  %-5s  %-44s  A   R   %-6s\n' repo PR state idea effort
        printf '%0.s─' {1..96}; printf '\n'
        header_printed=1
      fi
      printf '%-22s  #%-4s  %-5s  %-44s  %-3s %-3s %-6s\n' \
        "$repo_name" "$number" "$status" \
        "$(printf '%s' "$idea" | cut -c1-44)" \
        "$attraction" "$retention" "$effort"
      printf '  └─ %s\n' "$url"
      found=$((found + 1))
    done < <(printf '%s' "$prs_json" | jq -c '.[]')
  done
  if [[ $found -eq 0 ]]; then
    printf 'no open e3d-pilot PRs found across fleet\n'
  else
    printf '\n%s open PR(s)\n' "$found"
  fi
}

cmd_fleet_prs() {
  local fleet_file="" action="" action_repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --approve|--merge|--close)
        action="${1#--}"; action_repo="${2:-}"
        [[ -n "$action_repo" ]] || die "fleet prs $1 requires a repo name"
        shift 2
        ;;
      --fleet|-f)
        fleet_file="${2:-}"; shift 2
        ;;
      -h|--help)
        usage; return 0
        ;;
      *)
        # treat bare *.json arg as fleet file
        if [[ -z "$fleet_file" && -f "$1" ]]; then
          fleet_file="$1"; shift
        else
          die "unknown fleet prs argument: $1"
        fi
        ;;
    esac
  done

  if [[ -z "$fleet_file" ]]; then
    for candidate in "$HOME/e3d-fleet.json" "$(pwd)/fleet.json" "$(pwd)/e3d-fleet.json"; do
      [[ -f "$candidate" ]] && { fleet_file="$candidate"; break; }
    done
  fi
  [[ -n "$fleet_file" ]] || die "no fleet file found; pass <fleet.json> or use --fleet <file>"
  [[ -f "$fleet_file"  ]] || die "fleet file not found: $fleet_file"

  command -v gh >/dev/null 2>&1 || die "gh CLI not found; install and authenticate with 'gh auth login'"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated; run 'gh auth login'"

  local repos=()
  while IFS= read -r repo; do repos+=("$repo"); done < <(jq -r '.[]' "$fleet_file")

  if [[ -n "$action" ]]; then
    fleet_prs_act "$fleet_file" "$action" "$action_repo" "${repos[@]}"
  else
    fleet_prs_list "${repos[@]}"
  fi
}

# ─── fleet run ────────────────────────────────────────────────────────────────

cmd_fleet_run() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
    usage
    return 0
  fi
  if [[ "${1:-}" == "prs" ]]; then
    shift; cmd_fleet_prs "$@"; return
  fi
  [[ $# -eq 1 ]] || die "usage: e3d-pilot fleet <repos.json>"
  local file="$1" repo status failures=0 pending=0 total=0 out_tmp
  [[ -f "$file" ]] || die "fleet file not found: $file"
  jq -e 'type == "array" and all(.[]; type == "string")' "$file" >/dev/null || die "fleet file must be a JSON array of repo path strings"
  while IFS= read -r repo; do
    total=$((total + 1)); printf 'fleet: starting %s\n' "$repo"
    out_tmp="$(mktemp)"
    set +e
    "$0" run --repo "$repo" --stage all < /dev/null 2>&1 | tee "$out_tmp"
    status="${PIPESTATUS[0]}"
    set -e
    if [[ $status -ne 0 ]]; then
      printf 'fleet: FAIL %s (exit %s)\n' "$repo" "$status"; failures=$((failures + 1))
    elif grep -q '^pilot: pending-approval ' "$out_tmp"; then
      printf 'fleet: PENDING %s\n' "$repo"; pending=$((pending + 1))
    else
      printf 'fleet: PASS %s\n' "$repo"
    fi
    rm -f "$out_tmp"
  done < <(jq -r '.[]' "$file")
  printf 'fleet: summary total=%s passed=%s failed=%s pending=%s\n' "$total" "$((total - failures - pending))" "$failures" "$pending"
  [[ $failures -eq 0 ]]
}

# Portfolio-level ideation ("discover" and "ideate" only -- no draft/negotiate/
# execute/publish) that looks across every repo in the fleet file at once,
# rather than each repo independently the way `e3d-pilot fleet <file>` does.
# Its whole point is finding ideas that only make sense because 2+ of these
# repos exist together (e.g. repo A's data feed + repo B's payment rails),
# which single-repo discover structurally cannot see. State lives next to the
# fleet file itself, under .e3d-pilot-fleet/, since a cross-repo idea has no
# single target repo to belong to.
fleet_workspace_dir() {
  local file="$1" dir
  dir="$(cd "$(dirname "$file")" && pwd)"
  printf '%s/.e3d-pilot-fleet' "$dir"
}

fleet_latest_run_path() {
  printf '%s/latest-run' "$1"
}

new_fleet_run_id() {
  local fleet_dir="$1" base candidate counter runs_dir
  runs_dir="$fleet_dir/runs"
  base="$(date +%Y-%m-%d)-fleet"
  candidate="$base"
  counter=2
  while [[ -e "$runs_dir/$candidate" ]]; do
    candidate="${base}-${counter}"
    counter=$((counter + 1))
  done
  printf '%s' "$candidate"
}

validate_fleet_discover_config() {
  local file="$1"
  jq -e . "$file" >/dev/null || die "invalid JSON: $file"
  json_type_check "$file" 'type == "object"' "fleet discover config must be a JSON object: $file"
  json_type_check "$file" 'has("providers")' "fleet discover config.providers is required"
  json_type_check "$file" '.providers | type == "object"' "fleet discover config.providers must be an object"
  json_type_check "$file" '.providers | has("discover") and has("ideate")' "fleet discover config.providers must include discover and ideate"
  json_type_check "$file" '.providers.discover | type == "string"' "fleet discover config.providers.discover must be a string"
  json_type_check "$file" '.providers.ideate | type == "string"' "fleet discover config.providers.ideate must be a string"
  json_type_check "$file" 'if has("analogy_domains") then (.analogy_domains | type == "array") else true end' "fleet discover config.analogy_domains must be an array when provided"
  json_type_check "$file" 'if has("analogy_domains") then (.analogy_domains | all(.[]; type == "string")) else true end' "fleet discover config.analogy_domains must be an array of strings when provided"
  json_type_check "$file" 'if has("research_topics") then (.research_topics | type == "string") else true end' "fleet discover config.research_topics must be a string when provided"
  json_type_check "$file" 'if has("tracking") then (.tracking | type == "object") else true end' "fleet discover config.tracking must be an object when provided"
  json_type_check "$file" 'if (has("tracking") and (.tracking | has("project_url"))) then (.tracking.project_url | type == "string") else true end' "fleet discover config.tracking.project_url must be a string when provided"
  printf 'fleet discover config valid: %s\n' "$file"
}

# Runs a stage's provider call with the same exit-code handling (0 ok, 2
# unavailable, else failure) that discover_stage/ideate_stage each inline
# separately -- factored out here only because the two new fleet-* stages
# below need the exact same call twice; the older single-repo stages are left
# as-is rather than retrofitted onto this, to avoid touching tested behavior.
run_stage_provider() {
  local provider="$1" prompt_file="$2" stderr_file="$3" label="$4"
  local script status err output
  script="$REPO_ROOT/lib/providers/$provider"
  [[ -x "$script" ]] || die "$label provider script missing or not executable: $script"
  set +e
  output="$(E3D_PILOT_DRY_RUN=0 "$script" "$prompt_file" 2>"$stderr_file")"
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    err=""
    [[ -s "$stderr_file" ]] && err="$(<"$stderr_file")"
    if [[ $status -eq "$PROVIDER_EXIT_UNAVAILABLE" ]]; then
      die "$label provider unavailable: ${err:-$provider}"
    fi
    die "$label provider failed: ${err:-$provider}"
  fi
  printf '%s' "$output"
}

fleet_repo_digest() {
  local repo="$1" name head_sha doc found=0
  name="$(basename "$repo")"
  printf '### %s\n' "$name"
  printf -- '- path: %s\n' "$repo"
  if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    head_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
    [[ -n "$head_sha" ]] && printf -- '- head_sha: %s\n' "$head_sha"
  else
    printf -- '- not a git repository\n'
  fi
  for doc in README.md AGENTS.md CLAUDE.md; do
    if [[ -f "$repo/$doc" ]]; then
      found=1
      printf '#### %s\n```text\n' "$doc"
      read_repo_text_file "$repo/$doc"
      printf '\n```\n'
    fi
  done
  [[ $found -eq 1 ]] || printf -- '- no README/AGENTS/CLAUDE doc found\n'
}

build_fleet_discover_facts_markdown() {
  local repos_file="$1" facts_file="$2" repo
  {
    printf 'Repositories in this portfolio pass:\n\n'
    while IFS= read -r repo; do
      fleet_repo_digest "$repo"
      printf '\n'
    done < <(jq -r '.[]' "$repos_file")
  } > "$facts_file"
}

build_fleet_discover_prompt() {
  local facts_file="$1" prompt_file="$2" config_file="$3" focus="${4:-$FOCUS_DEFAULT}"
  {
    printf 'You are the cross-repo discover stage of a portfolio-level ideation pass\n'
    printf 'across the related repositories summarized below. Unlike a single-repo\n'
    printf 'discover pass, your job is specifically to find opportunities that only\n'
    printf 'make sense because these repos exist together -- not ideas that belong\n'
    printf 'inside just one of them.\n\n'
    printf 'Return markdown. Include a "### Cross-Repo Opportunities" section: 2-4\n'
    printf 'entries, each naming the specific repos involved (by directory name) and\n'
    printf 'what capability each one would contribute, plus one concrete sentence on\n'
    printf 'the resulting opportunity. Do not propose anything that only touches one\n'
    printf 'repo -- single-repo ideation is handled elsewhere.\n\n'
    printf 'Also include a distinct "### Analogous Patterns" subsection: pick the 2-3\n'
    printf 'most transferable entries from the analogy domains below across the whole\n'
    printf 'portfolio, and name concretely how each could combine capabilities from 2+\n'
    printf 'of these repos.\n\n'
    printf 'Analogy domains to consider: %s\n\n' "$(analogy_domains_list "$config_file" | paste -sd ';' - | sed 's/;/; /g')"
    if [[ "$focus" == "revenue" ]]; then
      printf 'This is a revenue-focused pass: also include a "### Monetization Signals"\n'
      printf 'subsection covering (a) monetization mechanisms already visible across\n'
      printf 'these repos'"'"' docs (payment flows, pricing tiers, credits, subscriptions,\n'
      printf 'tokens, fees) and (b) how combining 2+ of these repos could create a new\n'
      printf 'paid surface that none of them offers alone. Be concrete about the\n'
      printf 'mechanism.\n\n'
    fi
    printf 'Portfolio:\n\n'
    cat "$facts_file"
  } > "$prompt_file"
}

fleet_discover_stage() {
  local repos_file="$1" run_dir="$2" config_file="$3" focus="$4"
  local facts_file prompt_file external_context_file findings_file provider provider_output
  facts_file="$run_dir/fleet-discover-facts.md"
  prompt_file="$run_dir/fleet-discover-prompt.md"
  external_context_file="$run_dir/fleet-discover-external-context.md"
  findings_file="$run_dir/findings.md"

  build_fleet_discover_facts_markdown "$repos_file" "$facts_file"
  build_fleet_discover_prompt "$facts_file" "$prompt_file" "$config_file" "$focus"

  provider="$(config_value "$config_file" '.providers.discover')"
  provider_output="$(run_stage_provider "$provider" "$prompt_file" "$run_dir/fleet-discover-provider.stderr" "fleet discover")"

  printf '%s\n' "$provider_output" > "$external_context_file"
  printf '%s\n' "$provider_output" > "$run_dir/fleet-discover-response.md"
  {
    printf -- '---\n'
    printf 'focus: %s\n' "$focus"
    printf 'repos_file: %s\n' "$repos_file"
    printf -- '---\n\n'
    printf '# Fleet Findings\n\n'
    printf '## Portfolio\n\n'
    cat "$facts_file"
    printf '\n## Cross-Repo Context\n\n'
    cat "$external_context_file"
    printf '\n'
  } > "$findings_file"
}

build_fleet_ideate_facts_markdown() {
  local run_dir="$1" facts_file="$2" findings_file fleet_dir prior_dir prior_name found=0
  findings_file="$run_dir/findings.md"
  fleet_dir="$(dirname "$(dirname "$run_dir")")"
  {
    printf '## Current Fleet Findings\n\n```text\n'
    cat "$findings_file"
    printf '\n```\n'
    printf '\n## Prior Fleet Runs (candidates.md)\n'
    if [[ -d "$fleet_dir/runs" ]]; then
      for prior_dir in "$fleet_dir"/runs/*/; do
        [[ -d "$prior_dir" ]] || continue
        prior_name="$(basename "$prior_dir")"
        [[ "$prior_name" == "$(basename "$run_dir")" ]] && continue
        if [[ -f "$prior_dir/candidates.md" ]]; then
          found=1
          printf '### %s/candidates.md\n```text\n' "$prior_name"
          cat "$prior_dir/candidates.md"
          printf '\n```\n'
        fi
      done
    fi
    [[ $found -eq 1 ]] || printf -- '- none found\n'
  } > "$facts_file"
}

build_fleet_ideate_prompt() {
  local facts_file="$1" prompt_file="$2" focus="${3:-$FOCUS_DEFAULT}"
  {
    printf 'You are the cross-repo ideate stage of a portfolio-level ideation pass.\n'
    printf 'Propose 2-4 ranked candidate ideas (most valuable first), each of which\n'
    printf 'REQUIRES touching 2 or more of the repos in the findings below -- reject\n'
    printf 'anything that could be done inside a single repo; that belongs to\n'
    printf 'single-repo ideation instead.\n\n'
    printf 'For EACH candidate you must explicitly check it against the prior fleet\n'
    printf 'runs listed below and state plainly whether it duplicates something\n'
    printf 'already proposed in an earlier fleet-discover run.\n\n'
    if [[ "$focus" == "revenue" ]]; then
      printf 'This ideate run is explicitly focused on revenue-generating ideas. Score\n'
      printf 'every candidate on Revenue potential as the primary ranking signal;\n'
      printf 'Attraction and Retention remain required fields for context and may only\n'
      printf 'break ties between otherwise-equal Revenue candidates. Revenue is not\n'
      printf 'optional here: never answer "n/a".\n\n'
    else
      printf 'This portfolio'"'"'s primary goal is attracting and retaining users;\n'
      printf 'revenue is secondary.\n\n'
    fi
    printf 'Respond using exactly this format, one block per candidate:\n\n'
    printf '### Candidate <N>: <short title>\n'
    printf 'Repos: <comma-separated repo directory names this candidate touches, 2 or more>\n'
    printf 'Duplicate: yes|no\n'
    printf 'Dedup rationale: <cite the specific prior fleet run you checked, or say why not>\n'
    printf 'Analogy: <source domain> -- <how it transfers, or "none" if not applicable>\n'
    printf 'Attraction (1-5): <score, new-user pull>\n'
    printf 'Retention (1-5): <score, repeat-engagement value>\n'
    printf 'Effort: low|medium|high\n'
    if [[ "$focus" == "revenue" ]]; then
      printf 'Revenue (1-5): <score, primary ranking signal for this revenue-focused run -- never answer "n/a">\n'
      printf 'Description: <what to build, which repo contributes what, and why>\n\n'
      printf 'Rank non-duplicate candidates primarily by Revenue (highest first);\n'
      printf 'Attraction + Retention may only break ties between otherwise-equal Revenue\n'
      printf 'candidates and must never let a lower-Revenue candidate outrank a higher\n'
      printf 'one.\n\n'
    else
      printf 'Revenue (1-5|n/a): <score, secondary -- never outranks Attraction+Retention>\n'
      printf 'Description: <what to build, which repo contributes what, and why>\n\n'
      printf 'Rank non-duplicate candidates primarily by Attraction + Retention (highest\n'
      printf 'first); Revenue may only break ties between otherwise-equal candidates and\n'
      printf 'must never let a lower Attraction + Retention candidate outrank a higher\n'
      printf 'one.\n\n'
    fi
    printf 'After all candidates, end your response with exactly this block: choose the\n'
    printf 'highest-ranked candidate that is NOT a duplicate as "selected", using the\n'
    printf 'literal value "none" only if every candidate is a duplicate of existing work.\n\n'
    printf -- '---IDEATE-STATUS---\n'
    printf 'selected: candidate-<N> | none\n'
    printf 'reason: <one line>\n\n'
    printf 'Context:\n\n'
    cat "$facts_file"
  } > "$prompt_file"
}

fleet_ideate_validate_candidates() {
  local response_file="$1" warnings_file="$2"
  : > "$warnings_file"

  local count
  count="$(grep -cE '^### Candidate [0-9]+:' "$response_file" || true)"
  if (( count < 2 || count > 4 )); then
    printf 'expected 2-4 candidates, got %s\n' "$count" >> "$warnings_file"
  fi

  local current_num="" current_rationale="" current_repos="" repo_count
  local has_analogy=0 has_attraction=0 has_retention=0 has_effort=0 line

  while IFS= read -r line; do
    if [[ "$line" =~ ^###\ Candidate\ ([0-9]+): ]]; then
      if [[ -n "$current_num" ]]; then
        [[ -n "$current_rationale" ]] || printf 'Candidate %s is missing a Dedup rationale\n' "$current_num" >> "$warnings_file"
        if [[ -z "$current_repos" ]]; then
          printf 'Candidate %s is missing a Repos field\n' "$current_num" >> "$warnings_file"
        else
          repo_count="$(tr ',' '\n' <<<"$current_repos" | grep -c '[^[:space:]]' || true)"
          (( repo_count >= 2 )) || printf 'Candidate %s Repos field lists fewer than 2 repos\n' "$current_num" >> "$warnings_file"
        fi
        (( has_analogy )) || printf 'Candidate %s is missing an Analogy field\n' "$current_num" >> "$warnings_file"
        (( has_attraction )) || printf 'Candidate %s is missing an Attraction score\n' "$current_num" >> "$warnings_file"
        (( has_retention )) || printf 'Candidate %s is missing a Retention score\n' "$current_num" >> "$warnings_file"
        (( has_effort )) || printf 'Candidate %s is missing an Effort field\n' "$current_num" >> "$warnings_file"
      fi
      current_num="${BASH_REMATCH[1]}"
      current_rationale=""; current_repos=""
      has_analogy=0; has_attraction=0; has_retention=0; has_effort=0
    elif [[ -n "$current_num" ]]; then
      if [[ "$line" =~ ^Repos:[[:space:]]*(.+)$ ]]; then
        current_repos="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^Dedup\ rationale:[[:space:]]*(.*)$ ]]; then
        current_rationale="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^Analogy:[[:space:]]*(.+)$ ]]; then
        has_analogy=1
      elif [[ "$line" =~ ^Attraction.*:[[:space:]]*[0-9] ]]; then
        has_attraction=1
      elif [[ "$line" =~ ^Retention.*:[[:space:]]*[0-9] ]]; then
        has_retention=1
      elif [[ "$line" =~ ^Effort:[[:space:]]*(.+)$ ]]; then
        has_effort=1
      fi
    fi
  done < "$response_file"
  if [[ -n "$current_num" ]]; then
    [[ -n "$current_rationale" ]] || printf 'Candidate %s is missing a Dedup rationale\n' "$current_num" >> "$warnings_file"
    if [[ -z "$current_repos" ]]; then
      printf 'Candidate %s is missing a Repos field\n' "$current_num" >> "$warnings_file"
    else
      repo_count="$(tr ',' '\n' <<<"$current_repos" | grep -c '[^[:space:]]' || true)"
      (( repo_count >= 2 )) || printf 'Candidate %s Repos field lists fewer than 2 repos\n' "$current_num" >> "$warnings_file"
    fi
    (( has_analogy )) || printf 'Candidate %s is missing an Analogy field\n' "$current_num" >> "$warnings_file"
    (( has_attraction )) || printf 'Candidate %s is missing an Attraction score\n' "$current_num" >> "$warnings_file"
    (( has_retention )) || printf 'Candidate %s is missing a Retention score\n' "$current_num" >> "$warnings_file"
    (( has_effort )) || printf 'Candidate %s is missing an Effort field\n' "$current_num" >> "$warnings_file"
  fi

  [[ ! -s "$warnings_file" ]]
}

fleet_ideate_stage() {
  local fleet_file="$1" run_dir="$2" run_id="$3" config_file="$4" focus="$5"
  local facts_file prompt_file candidates_file provider provider_output selected reason warnings_file

  facts_file="$run_dir/fleet-ideate-facts.md"
  prompt_file="$run_dir/fleet-ideate-prompt.md"
  candidates_file="$run_dir/candidates.md"

  build_fleet_ideate_facts_markdown "$run_dir" "$facts_file"
  build_fleet_ideate_prompt "$facts_file" "$prompt_file" "$focus"

  provider="$(config_value "$config_file" '.providers.ideate')"
  provider_output="$(run_stage_provider "$provider" "$prompt_file" "$run_dir/fleet-ideate-provider.stderr" "fleet ideate")"

  printf '%s\n' "$provider_output" > "$run_dir/fleet-ideate-response.md"

  selected="$(ideate_status_field "selected" <<<"$provider_output" || true)"
  reason="$(ideate_status_field "reason" <<<"$provider_output" || true)"
  [[ -n "$selected" ]] || die "fleet ideate provider response missing ---IDEATE-STATUS--- selected field"

  warnings_file="$run_dir/fleet-ideate-warnings.txt"
  if ! fleet_ideate_validate_candidates "$run_dir/fleet-ideate-response.md" "$warnings_file"; then
    printf 'fleet ideate: warning: candidate response did not fully match the expected format:\n'
    while IFS= read -r line; do
      [[ -n "$line" ]] && printf '  - %s\n' "$line"
    done < "$warnings_file"
  fi

  {
    printf -- '---\n'
    printf 'selected: %s\n' "$selected"
    printf 'reason: %s\n' "$reason"
    printf 'focus: %s\n' "$focus"
    printf -- '---\n\n'
    printf '# Fleet Candidates\n\n'
    if [[ -s "$warnings_file" ]]; then
      printf '## Validation Warnings\n\n'
      while IFS= read -r line; do
        [[ -n "$line" ]] && printf -- '- %s\n' "$line"
      done < "$warnings_file"
      printf '\n'
    fi
    printf '## Dedup Context\n\n'
    cat "$facts_file"
    printf '\n## Proposed Candidates\n\n'
    cat "$run_dir/fleet-ideate-response.md"
    printf '\n'
  } > "$candidates_file"
  materialize_fleet_ideas "$(dirname "$(dirname "$(dirname "$run_dir")")")" "$fleet_file" "$run_dir" "$run_id" "$focus" >/dev/null
}

cmd_fleet_discover() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
    usage
    return 0
  fi
  local file="" run_id="" focus="" config_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id)
        run_id="${2:-}"
        shift 2
        ;;
      --focus)
        focus="${2:-}"
        shift 2
        ;;
      --config)
        config_override="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "unknown fleet discover argument: $1"
        ;;
      *)
        [[ -z "$file" ]] || die "unexpected extra argument: $1"
        file="$1"
        shift
        ;;
    esac
  done
  [[ -n "$file" ]] || die "usage: e3d-pilot fleet discover <repos.json> [--run-id <id>] [--focus default|revenue] [--config <path>]"
  [[ -z "$focus" ]] || validate_focus_value "$focus"
  [[ -f "$file" ]] || die "fleet file not found: $file"
  jq -e 'type == "array" and all(.[]; type == "string")' "$file" >/dev/null || die "fleet file must be a JSON array of repo path strings"

  local fleet_dir config_file run_dir resolved_focus
  fleet_dir="$(fleet_workspace_dir "$file")"
  config_file="${config_override:-$fleet_dir/config.json}"
  [[ -f "$config_file" ]] || die "fleet discover config not found: $config_file -- create it with providers.discover and providers.ideate (see examples/sample-fleet-config.json), or pass --config <path>"
  validate_fleet_discover_config "$config_file"

  mkdir -p "$fleet_dir/runs"
  [[ -n "$run_id" ]] || run_id="$(new_fleet_run_id "$fleet_dir")"
  run_dir="$fleet_dir/runs/$run_id"
  mkdir -p "$run_dir"
  printf '%s\n' "$run_id" > "$(fleet_latest_run_path "$fleet_dir")"

  resolved_focus="$(resolve_focus "$run_dir" "$focus")"

  fleet_discover_stage "$file" "$run_dir" "$config_file" "$resolved_focus"
  fleet_ideate_stage "$file" "$run_dir" "$run_id" "$config_file" "$resolved_focus"
  printf '%s\n' "$run_id"
}

cmd_fleet_ideas() {
  [[ $# -ge 2 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> <ingest|transition|rebuild>"
  local file="$1"
  shift
  [[ -f "$file" ]] || die "fleet file not found: $file"
  local workspace
  workspace="$(cd "$(dirname "$file")" && pwd -P)"
  local subcommand="${1:-}"
  shift || true
  case "$subcommand" in
    ingest)
      local run_id="" candidate_id="" candidate_json=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --run-id) run_id="${2:-}"; shift 2 ;;
          --candidate-id) candidate_id="${2:-}"; shift 2 ;;
          --candidate-json) candidate_json="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown fleet ideas ingest argument: $1" ;;
        esac
      done
      [[ -n "$run_id" ]] || die "fleet ideas ingest requires --run-id"
      [[ -n "$candidate_id" ]] || die "fleet ideas ingest requires --candidate-id"
      [[ -f "$candidate_json" ]] || die "fleet ideas ingest requires --candidate-json <file>"
      local ingested_idea_id
      ingested_idea_id="$(ideas_ingest_candidate fleet "$workspace" "$run_id" "$candidate_id" "$candidate_json")"
      project_tracking_sync_idea fleet "$workspace" "$ingested_idea_id"
      printf '%s\n' "$ingested_idea_id"
      ;;
    transition)
      local actor="" note="" targets_json="" head_sha=""
      local positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          --targets-json) targets_json="${2:-}"; shift 2 ;;
          --head-sha) head_sha="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas transition argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 2 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> transition <idea-id> <event>"
      [[ -z "$targets_json" || -f "$targets_json" ]] || die "targets JSON not found: $targets_json"
      actor="$(ideas_resolve_actor "$workspace" "$actor")"
      ideas_transition fleet "$workspace" "${positional[0]}" "${positional[1]}" "$actor" "$note" "$targets_json" "$head_sha"
      ;;
    list)
      local status_filter="" json_flag="0"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --status) status_filter="${2:-}"; shift 2 ;;
          --json) json_flag="1"; shift ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown fleet ideas list argument: $1" ;;
        esac
      done
      ideas_do_list fleet "$workspace" "$status_filter" "$json_flag"
      ;;
    show)
      local json_flag="0" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) json_flag="1"; shift ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas show argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> show <idea-id>"
      ideas_do_show fleet "$workspace" "${positional[0]}" "$json_flag"
      ;;
    approve)
      local actor="" note="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas approve argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> approve <idea-id>"
      ideas_do_approve fleet "$workspace" "$workspace" "${positional[0]}" "$actor" "$note"
      ;;
    reject)
      local actor="" reason="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --actor) actor="${2:-}"; shift 2 ;;
          --reason) reason="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas reject argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> reject <idea-id> --reason <text>"
      ideas_do_reject fleet "$workspace" "$workspace" "${positional[0]}" "$actor" "$reason"
      ;;
    request-changes)
      local actor="" reason="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --actor) actor="${2:-}"; shift 2 ;;
          --reason) reason="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas request-changes argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> request-changes <idea-id> --reason <text>"
      ideas_do_request_changes fleet "$workspace" "$workspace" "${positional[0]}" "$actor" "$reason"
      ;;
    sync)
      local positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas sync argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -le 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> sync [<idea-id>]"
      ideas_do_sync fleet "$workspace" "${positional[0]:-}"
      ;;
    outcome)
      local window="" note="" metrics=() positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --window) window="${2:-}"; shift 2 ;;
          --metric) metrics+=("${2:-}"); shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas outcome argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> outcome <idea-id> --window <7d|30d|custom> --metric <key=value>... [--note <text>]"
      ideas_do_outcome fleet "$workspace" "$workspace" "${positional[0]}" "$window" "$note" "${metrics[@]}"
      ;;
    implement)
      local continue_on_failure=0 positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --continue-on-target-failure) continue_on_failure=1; shift ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas implement argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> implement <idea-id>"
      ideas_do_implement_fleet "$file" "${positional[0]}" "$continue_on_failure"
      ;;
    implement-approved)
      local continue_on_failure=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --continue-on-target-failure) continue_on_failure=1; shift ;;
          -h|--help) usage; return 0 ;;
          *) die "unknown fleet ideas implement-approved argument: $1" ;;
        esac
      done
      ideas_do_implement_approved_fleet "$file" "$continue_on_failure"
      ;;
    approve-merge)
      local actor="" note="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --actor) actor="${2:-}"; shift 2 ;;
          --note) note="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas approve-merge argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> approve-merge <idea-id>"
      ideas_do_approve_merge fleet "$workspace" "$workspace" "${positional[0]}" "$actor" "$note"
      ;;
    merge)
      local positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet ideas merge argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> merge <idea-id>"
      ideas_do_merge fleet "$workspace" "${positional[0]}"
      ;;
    merge-approved)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -h|--help) usage; return 0 ;;
          *) die "unknown fleet ideas merge-approved argument: $1" ;;
        esac
      done
      ideas_do_merge_approved_fleet "$file"
      ;;
    rebuild)
      [[ $# -eq 0 ]] || die "usage: e3d-pilot fleet ideas <fleet.json> rebuild"
      ideas_rebuild fleet "$workspace"
      printf 'fleet ideas: rebuilt %s\n' "$workspace"
      ;;
    ""|-h|--help)
      usage
      ;;
    *)
      die "unknown fleet ideas subcommand: $subcommand"
      ;;
  esac
}

cmd_fleet_train() {
  local subcommand="${1:-}"
  shift || true
  case "$subcommand" in
    readiness)
      local since="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --since) since="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet train readiness argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet train readiness <fleet.json> [--since <RFC3339>]"
      [[ -f "${positional[0]}" ]] || die "fleet file not found: ${positional[0]}"
      training_run_readiness "${positional[0]}" "$since"
      ;;
    export)
      local week="" output="" positional=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --week) week="${2:-}"; shift 2 ;;
          --output) output="${2:-}"; shift 2 ;;
          -h|--help) usage; return 0 ;;
          --*) die "unknown fleet train export argument: $1" ;;
          *) positional+=("$1"); shift ;;
        esac
      done
      [[ ${#positional[@]} -eq 1 ]] || die "usage: e3d-pilot fleet train export <fleet.json> [--week <YYYY-Www>] [--output <dir>]"
      [[ -f "${positional[0]}" ]] || die "fleet file not found: ${positional[0]}"
      training_run_export "${positional[0]}" "$week" "$output"
      ;;
    ""|-h|--help)
      usage
      ;;
    *)
      die "unknown fleet train subcommand: $subcommand"
      ;;
  esac
}

cmd_fleet() {
  case "${1:-}" in
    discover)
      shift
      cmd_fleet_discover "$@"
      ;;
    ideas)
      shift
      cmd_fleet_ideas "$@"
      ;;
    prs)
      shift
      cmd_fleet_prs "$@"
      ;;
    train)
      shift
      cmd_fleet_train "$@"
      ;;
    *)
      cmd_fleet_run "$@"
      ;;
  esac
}

cmd_web() {
  local port=4173 repos=() arg repo
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ -n "${2:-}" ]] || die "web --repo requires a path"
        repos+=("$2")
        shift 2
        ;;
      --port)
        [[ -n "${2:-}" ]] || die "web --port requires a number"
        port="$2"
        shift 2
        ;;
      *)
        die "unknown web argument: $1"
        ;;
    esac
  done
  [[ ${#repos[@]} -gt 0 ]] || die "web requires at least one --repo <path>"
  command -v node >/dev/null 2>&1 || die "e3d-pilot web requires Node.js on PATH (optional feature -- every other e3d-pilot command needs only Bash/git/jq/curl)."
  [[ -n "${E3D_PILOT_WEB_AUTH_USER:-}" && -n "${E3D_PILOT_WEB_AUTH_PASS:-}" ]] || die "e3d-pilot web refuses to start without E3D_PILOT_WEB_AUTH_USER and E3D_PILOT_WEB_AUTH_PASS set (private dashboard, never unauthenticated)."

  local abs_repos=()
  for repo in "${repos[@]}"; do
    repo="$(repo_abs_path "$repo")"
    ensure_git_repo "$repo"
    abs_repos+=("$repo")
  done

  exec node "$REPO_ROOT/lib/web/server.js" --port "$port" -- "${abs_repos[@]}"
}

main() {
  local command="${1:-}"
  case "$command" in
    ""|-h|--help)
      usage
      ;;
    config)
      shift
      cmd_config "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    ideas)
      shift
      cmd_ideas "$@"
      ;;
    providers)
      shift
      cmd_providers "$@"
      ;;
    fleet)
      shift
      cmd_fleet "$@"
      ;;
    web)
      shift
      cmd_web "$@"
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
