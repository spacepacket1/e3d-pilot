    flags: { type: 'object', properties: {
      instructions_ignored: { type: 'boolean' },
      cap_exceeded: { type: 'array', items: { type: 'object' } },
      unavailable: { type: 'array', items: { type: 'object' } },
      citations_dropped: { type: 'object' },
    } },
  },
  required: ['enabled', 'searches_used', 'citations', 'flags'],
};

