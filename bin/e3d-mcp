#!/usr/bin/env node
// e3d-mcp: Model Context Protocol server (stdio) exposing e3d-pilot to any MCP
// client -- GitHub Copilot (VS Code agent mode, coding agent), Claude Code, Cursor, etc.
//
// Zero dependencies on purpose: MCP over stdio is newline-delimited JSON-RPC 2.0,
// small enough to speak directly, so `npx`/clone-and-run needs no install step.
//
// Tools:
//   e3d_debate          multi-model debate -> decisive answer + consensus + named dissent
//   e3d_list_providers  which model providers this server can use
//   e3d_provenance_trace / e3d_ideas_list   read-only "why does this exist?" queries
//
// Debate cost guard: every debate spends the *server operator's* model credits, so
// rounds/providers/concurrency are capped (E3D_MCP_MAX_ROUNDS, E3D_MCP_MAX_PROVIDERS,
// E3D_MCP_MAX_CONCURRENT, E3D_MCP_TIMEOUT_SEC). Nothing here writes to a repo.

import { mkdtemp, writeFile, readFile, rm, stat } from 'node:fs/promises';
import { readFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { createInterface } from 'node:readline';
import { ROOT, log, text, run, configuredProviders, providerLine, NAME_RE } from '../lib/mcp/util.js';
import { redact } from '../lib/mcp/redact.js';
import { parseVerdict } from '../lib/mcp/verdict.js';
import { doctor, checkoutConfigHint } from '../lib/mcp/doctor.js';
import { createRpc } from '../lib/mcp/rpc.js';
import { createRepoGuard } from '../lib/mcp/repos.js';
import { createJobs } from '../lib/mcp/jobs.js';
import { createPipelineTools } from '../lib/mcp/pipeline-tools.js';
import { createPipelineActions } from '../lib/mcp/pipeline-actions.js';
import { createSampling } from '../lib/mcp/sampling.js';
import { listPrompts, getPrompt } from '../lib/mcp/prompts.js';
import { chooseVoices, independence, isSampling } from '../lib/mcp/voices.js';
import { startHttpServer } from '../lib/mcp/http.js';
import { createUsage, usageFromTranscript, worstCase, usageTool, usageHandler } from '../lib/mcp/usage.js';
import { webSearchConfig, sanitizeText, cleanUrl, hostOf, API_PROVIDERS, PRIVACY_NOTICE, searchAvailability } from '../lib/debate/websearch.mjs';
import { createExternalAuth, validateConfig as validateAuthConfig } from '../lib/mcp/external-auth.js';
import { createOutbox, outboxStatus, outboxExport, outboxRetryDead } from '../lib/mcp/outbox.js';
import { createMetering, createReadiness, modelsFromTranscript, orphanPolicy } from '../lib/mcp/metering.js';
import { createHash, randomUUID } from 'node:crypto';
import { createRuns, validateRunsConfig } from '../lib/mcp/runs.js';
import { startRunServer, validateRunServerConfig } from '../lib/mcp/run-server.js';
import { validatePricingConfig, createPricingClient, limitsForPlan, pricedError, debateEnvFor, readUsageRows, searchCapable, searchCapFromEnv, requestedSearches } from '../lib/mcp/pricing.js';
import { agentModeFrom, agentFieldsOf, AGENT_INSTRUCTIONS, SCHEMA_VERSION as AGENT_SCHEMA_VERSION, IDEMPOTENCY_KEY_RE, QUOTE_ID_RE, agentError, errorResult, reasonError, extendDebateTool, quoteTool, quoteResult, validQuote } from '../lib/mcp/agent.js';
import { validatePanelConfig, validateRequiredConfig, withRequired, requireAvailable, createPanelClient, checkFamilies, requireFamilies, degrade, explicitPanel, familiesOf } from '../lib/mcp/panel.js';

const HTTP_MODE = process.argv.includes('--http');
// External auth and metering hook (docs/external-auth.md): hosted --http mode only.
const AUTH_HOOK = Boolean(process.env.E3D_MCP_AUTH_URL);
// E3D_MCP_PRICING=per_token (token pricing, lib/mcp/pricing.js): advertises per_token_v1 and honours the run fields billing sends with it.
const PRICING_CONFIG = validatePricingConfig(process.env, { http: HTTP_MODE, hook: AUTH_HOOK });
let pricingClient = null; // billing's quote and usage-report client, once the external hook is running under per_token
// E3D_MCP_AGENT (lib/mcp/agent.js): the agent contract (e3d_quote, quote_id and idempotency_key, structured errors, instructions).
// On by default exactly when E3D_MCP_PRICING=per_token; 0 turns it off without a release. Never on for stdio or self-hosted use.
const AGENT_CONFIG = agentModeFrom(process.env, PRICING_CONFIG.mode);
const AGENT_ON = AGENT_CONFIG.on && HTTP_MODE && AUTH_HOOK;
// The version comes from package.json, so a development build (0.2.0-dev.N) reports itself correctly.
const PKG_VERSION = (() => { try { return JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8')).version; } catch { return '0.0.0-unknown'; } })();
const SERVER_INFO = { name: 'e3d-pilot', version: PKG_VERSION };
const SUPPORTED_PROTOCOLS = ['2025-06-18', '2025-03-26', '2024-11-05'];

const envInt = (name, dflt) => {
  const n = Number.parseInt(process.env[name] ?? '', 10);
  return Number.isFinite(n) && n > 0 ? n : dflt;
};
const LIMITS = {
  rounds: envInt('E3D_MCP_MAX_ROUNDS', 3),
  providers: envInt('E3D_MCP_MAX_PROVIDERS', 4),
  concurrent: envInt('E3D_MCP_MAX_CONCURRENT', 2),
  // Hosted: stay under typical load-balancer idle timeouts unless the operator says otherwise.
  timeoutMs: envInt('E3D_MCP_TIMEOUT_SEC', HTTP_MODE ? 120 : 900) * 1000,
  maxWords: 600,
  questionChars: 20000,
  // Editors give up on a tool call after about 3 minutes. When the client's own models answer (MCP sampling), stop first,
  // so the debate is cancelled and reported instead of running on unseen and charging calls nobody sees.
  samplingTimeoutMs: envInt('E3D_MCP_SAMPLING_TIMEOUT_SEC', 150) * 1000,
};
let activeDebates = 0;

const send = (msg) => process.stdout.write(`${JSON.stringify(msg)}\n`);
// quick = one round of independent answers + one synthesis call (fast, no cross-critique);
// thorough = the debate as originally shipped (2 rounds, models see and rebut each other).
const MODES = { quick: { rounds: 1, maxWords: 80 }, thorough: { rounds: 2, maxWords: 200 } };

// Each model's answer in the last round, from transcript.md ("## Round N -- provider").
function parsePositions(transcript) {
  const sections = transcript.split(/\n(?=## )/).map((c) => c.match(/^## Round (\d+) -- (\S+)\n\n([\s\S]*)$/)).filter(Boolean)
    .map((m) => ({ round: Number(m[1]), provider: m[2], body: m[3].trim() }));
  const last = Math.max(0, ...sections.map((x) => x.round));
  return {
    roundsRan: last,
    positions: sections.filter((x) => x.round === last).map((x) => ({
      provider: x.provider,
      text: x.body.replace(/\n*status: (approved|revise)\s*$/i, '').replace(/\n*POSITION:[^\n]*$/, '').trim(),
    })),
  };
}

// `warning: ...` lines of the engine's stderr: at most 5, 200 characters each, redacted.
function engineWarningsOf(err) {
  return String(err ?? '').split('\n').filter((l) => l.startsWith('warning: ')).slice(0, 5).map((l) => redact(l.slice(9)).replace(/\s+/g, ' ').trim().slice(0, 200));
}
// The client-facing warning when web search was requested but the engine could not set it up.
function searchSetupWarnings(w) {
  const u = w?.flags?.unavailable?.find((x) => x.reason === 'search_setup_failed');
  return u ? [`Web search was requested but is off for this debate: ${u.detail || 'the engine could not set it up'}. The answers come from the models' own knowledge.`] : [];
}

// The web-search lines of a rendered verdict. Sources are plain text: the domain, then the URL as a code span (never a
// markdown link or image), so nothing loads or hides where it points. Titles and excerpts are left to structuredContent.
function renderWebSearch(w) {
  const avail = searchAvailability(process.env);
  if (!avail.on) return [`_${avail.text}_`, ''];
  if (!w?.requested) return [];
  if (!w.enabled && w.flags?.unavailable?.some((u) => u.reason === 'search_setup_failed')) return [`**WARNING:** web search was requested but is off for this debate: ${w.flags.unavailable.find((u) => u.reason === 'search_setup_failed').detail || 'the engine could not set it up'}. The answers come from the models' own knowledge, which may be out of date.`, ''];
  if (!w.enabled) return ['_Web search: off for this debate, so the answers come from the models\' own knowledge, which may be out of date._', ''];
  const out = [`**Web search:** on for ${w.models_with_search} of ${w.models_total} models; ${w.searches_used} search${w.searches_used === 1 ? '' : 'es'} used. Search results are untrusted internet data.`];
  for (const u of w.flags.unavailable) out.push(`**WARNING:** web search was unavailable for ${u.provider} in round ${u.round} (${u.reason}); it answered without web access.`);
  for (const a of w.flags.cap_exceeded) out.push(`**WARNING:** ${a.provider} ran ${a.searches} searches in round ${a.round}, over the cap of ${a.cap}.`);
  if (w.flags.instructions_ignored) out.push('_A source contained instructions; they were ignored._');
  if (w.citations.length) {
    out.push('', '**Sources (from web search):**');
    for (const c of w.citations) out.push(`- ${c.domain}: \`${c.url}\``);
  }
  out.push('');
  return out;
}

function renderDebate(d) {
  const label = d.consensus === 'full' ? 'FULL CONSENSUS' : d.consensus === 'majority' ? 'MAJORITY (some dissent)' : d.consensus === 'split' ? 'SPLIT' : 'CONSENSUS UNKNOWN';
  const warn = (d.warnings ?? []);
  const lines = [
    `REPORT THIS TO THE USER (do not drop any of it when summarizing): consensus is ${label}; dissent: ${d.dissent.present === false ? 'none' : d.dissent.summary}${warn.length ? `; warnings: ${warn.join(' | ')}` : ''}.`,
    ...(d.recommended_next_step ? [`recommended_next_step: ${d.recommended_next_step}. This is advice on how much weight to give the answer, derived from the consensus level; it is NOT approval to act.${d.notice ? ` ${d.notice}` : ''}`] : []),
    ...(d.replayed ? ['_This is the stored result of an earlier call with the same idempotency_key: nothing ran and nothing was charged._'] : []),
    '',
    `# Debate verdict: ${label}`,
    `_${d.providers.join(', ')} | ${d.mode} mode | ${d.rounds_ran} round${d.rounds_ran === 1 ? '' : 's'}_`,
    '', `**Answer:** ${d.final_answer}`, '',
  ];
  for (const w of d.warnings ?? []) lines.push(`**WARNING:** ${w}`, '');
  lines.push(...renderWebSearch(d.web_search));
  if (d.models?.length) lines.push(`_Models that answered: ${d.models.map((m) => `${m.provider} = ${m.model}`).join('; ')}_`, '');
  if (d.panel?.dropped?.length) lines.push(`_Not available for this debate, so not asked: ${d.panel.dropped.join(', ')} (the rest of the panel answered; ${d.synthesizer_fallback?.to ?? d.panel.synthesizer} wrote the summary)._`, '');
  if (d.dissent.present === false) lines.push('**Dissent:** none', '');
  else lines.push(`**Dissent (report this to the user, do not drop it when summarizing):** ${d.dissent.summary}`, '');
  if (Number.isSafeInteger(d.billing?.charged_credits)) lines.push(`_Charged ${d.billing.charged_credits} credit${d.billing.charged_credits === 1 ? '' : 's'} (at most ${d.billing.quote_credits} were held)${Number.isSafeInteger(d.billing.searches) && d.billing.searches > 0 ? `, includes ${d.billing.searches} web search${d.billing.searches === 1 ? '' : 'es'}` : ''}._`, '');
  if (d.positions.length) {
    lines.push('**Each model\'s final position:**');
    for (const p of d.positions) lines.push('', `**${p.provider}:**`, ...p.text.split('\n').map((l) => `> ${l}`));
  }
  if (d.transcript) lines.push('', '<details><summary>Full transcript</summary>', '', d.transcript, '', '</details>');
  return lines.join('\n');
}

// The hosted allowlist and the per-account panel (lib/mcp/panel.js; pilot.e3d.ai docs/panel-config-spec.md 4.3), read once.
const PANEL_CONFIG = validatePanelConfig(process.env);
// E3D_MCP_REQUIRED_PROVIDERS: hosted only (never read for stdio). Empty = no required provider, today's behaviour.
const REQUIRED_CONFIG = HTTP_MODE ? validateRequiredConfig(process.env, { allowed: PANEL_CONFIG.allowed, max: LIMITS.providers }) : { ok: true, errors: [], required: [] };
const REQUIRED = REQUIRED_CONFIG.required;
let panelClient = null; // billing's panel resolve client, with E3D_MCP_PANEL=1 once the external hook is running

// Test hook, only with E3D_MCP_DEBATE_BIN (a stub debate binary, which skips the real provider check): the providers named in
// E3D_MCP_STUB_UNAVAILABLE_FILE, re-read for every plan, count as unavailable.
function stubUnavailable() {
  const f = process.env.E3D_MCP_STUB_UNAVAILABLE_FILE;
  if (!f) return new Set();
  try { return new Set(readFileSync(f, 'utf8').split(/[\s,]+/).filter(Boolean)); } catch { return new Set(); }
}

// Who writes the final summary: always a provider of the debate (never the claude CLI just because it is installed). Hosted:
// the first required provider (E3D_MCP_REQUIRED_PROVIDERS), else the first provider of the effective panel. Local: the
// client's own model when it takes part, else claude when it takes part, else the first provider. Always passed to e3d-debate
// explicitly; a failed summary is a failed debate, never retried with another provider.
function chooseSynthesizer(providers, samplingOn) {
  if (HTTP_MODE) return REQUIRED.length ? REQUIRED[0] : providers[0];
  if (samplingOn && providers.includes('mcp-sampling')) return 'mcp-sampling';
  return providers.includes('claude') ? 'claude' : providers[0];
}

// Validates and resolves the arguments shared by e3d_debate and e3d_debate_start. Returns { error } or the plan.
// clamp (customer async runs only): rounds and max_words are lowered to these maxima; a longer provider list is refused, never
// truncated. web: the request came from the internal run listener (billing's stored panel, no principal yet).
// With E3D_MCP_PANEL=1 a hosted tool call first asks billing for the account's panel (before anything is reserved).
async function planDebate(args, ctx, { clamp = null, web = false } = {}) {
  const question = typeof args.question === 'string' ? args.question.trim() : '';
  if (!question) return { error: 'error: `question` is required' };
  if (question.length > LIMITS.questionChars) return { error: `error: question exceeds ${LIMITS.questionChars} characters` };

  const mode = args.mode ?? 'quick';
  if (!MODES[mode]) return { error: 'error: mode must be "quick" or "thorough"' };
  const lower = (v, max) => (clamp && Number.isInteger(v) ? Math.min(v, max) : v);
  const rounds = lower(args.rounds ?? MODES[mode].rounds, clamp?.rounds);
  if (!Number.isInteger(rounds) || rounds < 1 || rounds > LIMITS.rounds) return { error: `error: rounds must be an integer 1..${LIMITS.rounds}` };
  const maxWords = lower(args.max_words ?? MODES[mode].maxWords, clamp?.max_words);
  if (!Number.isInteger(maxWords) || maxWords < 20 || maxWords > LIMITS.maxWords) return { error: `error: max_words must be an integer 20..${LIMITS.maxWords}` };
  if (args.include_transcript !== undefined && typeof args.include_transcript !== 'boolean') return { error: 'error: include_transcript must be a boolean' };
  if (args.web_search !== undefined && typeof args.web_search !== 'boolean') return { error: 'error: web_search must be a boolean' };
  const webSearch = args.web_search !== false;

  // E3D_MCP_DEBATE_BIN swaps in another debate executable (used by tests); provider checks are then that binary's job.
  const stubbed = Boolean(process.env.E3D_MCP_DEBATE_BIN);
  const known = stubbed ? [] : await configuredProviders();
  const samplingOn = sampling.available(ctx?.session);
  const stubDown = stubbed ? stubUnavailable() : null;
  const isAvailable = (p) => (isSampling(p) ? samplingOn : stubbed ? !stubDown.has(p) : known.some((k) => k.name === p && k.available));
  const allowed = PANEL_CONFIG.allowed;
  const max = clamp ? Math.min(clamp.providers, LIMITS.providers) : LIMITS.providers;
  let providers = args.providers;
  if (providers !== undefined) {
    if (!Array.isArray(providers) || providers.some((p) => typeof p !== 'string' || !NAME_RE.test(p))) return { error: 'error: providers must be an array of provider names' };
    providers = [...new Set(providers)];
  }
  let selection = 'explicit';
  let selectionNote = 'chosen by the caller';
  let panel = null; // { source, requested, used, dropped } with the per-account panel on
  const pinned = () => {
    if (stubbed) return { providers: (process.env.E3D_MCP_PROVIDERS ? chooseVoices({ known, samplingOn: false }).providers : ['claude', 'codex']), selection: 'auto', note: 'test stub' };
    // Default: the client's own models (MCP sampling, e.g. Copilot) plus any model CLIs detected here; hosted: the pinned list.
    const pick = chooseVoices({ known, samplingOn });
    return { providers: pick.providers, selection: pick.selection, note: pick.note };
  };

  if (panelClient && web) {
    // A run-listener list is the account's panel as billing stored it at creation (an older billing sends none: the default).
    const requested = withRequired(providers ?? pinned().providers, REQUIRED);
    const d = degrade(requested, { allowed, isAvailable, max, required: REQUIRED });
    if (d.error) return d;
    providers = d.providers; selection = 'pinned'; selectionNote = 'the debate panel of the account';
    panel = { source: args.providers === undefined ? 'default' : 'account', requested, used: providers, dropped: d.dropped };
  } else if (panelClient && !web) {
    // Every hosted debate, with or without explicit providers: the account's panel from billing, never cached, never a default.
    const r = await panelClient.resolve(ctx?.principal);
    if (!r.ok) return { error: 'error: temporarily unavailable; retry (the debate panel could not be read; nothing was charged)', code: 'unavailable' };
    const mismatch = checkFamilies(r, log);
    if (mismatch) return mismatch;
    // Required providers (E3D_MCP_REQUIRED_PROVIDERS) are forced first, defensively (billing already puts them first).
    const accountIds = withRequired(r.providers.map((p) => p.id), REQUIRED);
    if (providers === undefined) {
      const d = degrade(accountIds, { allowed, isAvailable, max, required: REQUIRED });
      if (d.error) return d;
      providers = d.providers; selection = 'pinned';
      selectionNote = r.source === 'account' ? "your account's debate panel" : 'the default debate panel';
      panel = { source: r.source, requested: accountIds, used: providers, dropped: d.dropped };
    } else {
      // A client's list may narrow the account's panel, never add to it (tool arguments are not consent). It can narrow only
      // the optional providers: the required ones are added back, first.
      const requested = providers;
      const down = requireAvailable(REQUIRED, isAvailable);
      if (down) return down;
      providers = withRequired(providers, REQUIRED);
      const e = explicitPanel(providers, { allowed, accountIds, isAvailable, max });
      if (e.error) return e;
      panel = { source: 'explicit', requested, used: providers, dropped: [] };
    }
  } else {
    if (providers === undefined) {
      const pick = pinned();
      ({ providers } = pick); selection = pick.selection; selectionNote = pick.note;
    }
    if (REQUIRED.length) {
      // Hosted with E3D_MCP_REQUIRED_PROVIDERS: the required providers always take part, first; never a substitute.
      const down = requireAvailable(REQUIRED, isAvailable);
      if (down) return down;
      providers = withRequired(providers, REQUIRED);
    }
    // The hosted allowlist binds every debate whenever it is set (sampling voices are never in it).
    const notAllowed = allowed ? providers.filter((p) => !allowed.includes(p)) : [];
    if (notAllowed.length) return { error: `error: provider_not_allowed: provider(s) not offered on this server: ${notAllowed.join(', ')} (call e3d_list_providers). Nothing was charged.` };
    if (providers.length < 2) return { error: 'error: need at least 2 available providers to debate (call e3d_list_providers); only found: ' + (providers.join(', ') || 'none') };
    if (providers.length > max) return { error: clamp && max < LIMITS.providers ? `error: at most ${max} providers per debate on this server. Nothing was charged.` : `error: at most ${LIMITS.providers} providers per debate` };
    const unavailable = providers.filter((p) => !isAvailable(p));
    if (unavailable.length) {
      const sampled = unavailable.filter(isSampling);
      return { error: `error: provider(s) not available here: ${unavailable.join(', ')}${sampled.length ? ' (mcp-sampling needs an MCP client that supports sampling, such as Copilot in VS Code)' : ''}` };
    }
  }
  if (panelClient) {
    // Two vendors of one company are not independent opinions: refused before anything is reserved.
    const f = requireFamilies(providers);
    if (f) return f;
  }
  const synthesizer = chooseSynthesizer(providers, samplingOn);
  if (panel) panel = { ...panel, families: familiesOf(providers), synthesizer, ...(REQUIRED.length ? { required: [...REQUIRED] } : {}) };
  return { question, mode, rounds, maxWords, providers, synthesizer, selection, selectionNote, ...(panel ? { panel } : {}), webSearch, ...searchPlan(providers, webSearch) };
}

// Which voices may search in this debate (the same rules bin/e3d-debate applies): only the four API providers, only with the
// global switch on, and only those on E3D_DEBATE_WEB_SEARCH_PROVIDERS. Used for the worst-case estimate.
function searchPlan(providers, webSearch) {
  const cfg = webSearchConfig(process.env);
  const searching = webSearch && cfg.enabled ? providers.filter((p) => API_PROVIDERS.includes(p) && cfg.providers.includes(p)) : [];
  // per-token pricing: the cap is the one the quote will ask for (2 unless set), not the global per-call cap, and only a server that can run
  // priced searches asks for any
  if (PRICING_CONFIG.mode === 'per_token') return { searchProviders: webSearch && searchCapable(process.env) ? searching.length : 0, maxSearchesPerCall: searchCapFromEnv(process.env) };
  return { searchProviders: searching.length, maxSearchesPerCall: cfg.maxSearches };
}
const worstFor = (plan) => worstCase({ providers: plan.providers.length, rounds: plan.rounds, maxWords: plan.maxWords, questionChars: plan.question.length,
  searchProviders: plan.searchProviders ?? 0, maxSearchesPerCall: plan.maxSearchesPerCall ?? 0 });

// The web-search part of a debate's result, from the out/web-search.json bin/e3d-debate writes. Everything is re-checked and
// re-sanitised here: titles and excerpts are page text, so they are bounded and stripped of markup; URLs are http(s) with no
// query string; nothing is ever fetched.
// setup (optional): { providers, detail } when the engine printed warnings and no web-search.json came back although search was requested
// (the engine could not set search up, e.g. an old node): the block then says so in flags.unavailable, with the first warning as detail.
function readWebSearch(raw, requested, setup = null) {
  let w = null;
  try { w = raw ? JSON.parse(raw) : null; } catch { w = null; }
  const int = (v) => (Number.isSafeInteger(v) && v >= 0 ? v : 0);
  const line = (v, max) => sanitizeText(String(v ?? '')).replace(/\s+/g, ' ').trim().slice(0, max);
  const name = (v) => String(v ?? '').replace(/[^a-z0-9_.:-]/gi, '').slice(0, 64);
  if (!w || typeof w !== 'object') {
    const failed = requested && setup?.detail ? (setup.providers?.length ? setup.providers : ['all']).slice(0, 8).map((provider) => ({ provider, round: 0, reason: 'search_setup_failed', detail: line(setup.detail, 200) })) : [];
    return { enabled: false, requested, models_with_search: 0, models_total: 0, searches_used: 0, searches_by_provider: {}, citations: [], flags: { instructions_ignored: false, cap_exceeded: [], unavailable: failed, citations_dropped: {} } };
  }
  const byProvider = {};
  for (const [k, v] of Object.entries(w.searches_used ?? {})) if (API_PROVIDERS.includes(k)) byProvider[k] = int(v);
  const citations = (Array.isArray(w.citations) ? w.citations : []).slice(0, 20).map((c) => {
    const url = cleanUrl(c?.url);
    if (!url) return null;
    const domain = /^[a-z0-9.-]{1,253}$/.test(String(c?.domain ?? '')) ? c.domain : hostOf(url);
    return { title: line(c?.title, 120) || domain, domain, url, excerpt: line(c?.excerpt, 300), provider: name(c?.provider) };
  }).filter(Boolean);
  const flags = w.flags ?? {};
  return {
    enabled: w.enabled === true, requested, models_with_search: int(w.models_with_search), models_total: int(w.models_total),
    searches_used: Object.values(byProvider).reduce((a, b) => a + b, 0), searches_by_provider: byProvider, citations,
    flags: {
      instructions_ignored: flags.instructions_ignored === true,
      cap_exceeded: (Array.isArray(flags.cap_exceeded) ? flags.cap_exceeded : []).slice(0, 32).map((a) => ({ provider: name(a?.provider), round: int(a?.round), searches: int(a?.searches), cap: int(a?.cap) })),
      unavailable: (Array.isArray(flags.unavailable) ? flags.unavailable : []).slice(0, 32).map((u) => ({ provider: name(u?.provider), round: int(u?.round), reason: name(u?.reason), ...(typeof u?.detail === 'string' && u.detail ? { detail: line(u.detail, 200) } : {}) })),
      citations_dropped: Object.fromEntries(Object.entries(flags.citations_dropped ?? {}).filter(([k]) => /^[a-z_]{1,32}$/.test(k)).map(([k, v]) => [k, int(v)])),
    },
  };
}

// The seat record of a debate (seats.json from e3d-debate, docs/seat-reliability.md): which seats answered, which were lost and why, and
// whether another model wrote the summary. Everything is re-validated and bounded; an absent or unreadable file is null (old engine).
function readSeats(raw) {
  let w = null;
  try { w = raw ? JSON.parse(raw) : null; } catch { w = null; }
  if (!w || typeof w !== 'object') return null;
  const int = (v) => (Number.isSafeInteger(v) && v >= 0 && v <= 1000 ? v : 0);
  const name = (v) => String(v ?? '').replace(/[^a-z0-9_.:-]/gi, '').slice(0, 64);
  const unavailable = (Array.isArray(w.seats_unavailable) ? w.seats_unavailable : []).slice(0, 16).map((u) => ({ provider: name(u?.provider), round: int(u?.round), reason: name(u?.reason) || 'error' }));
  const f = w.synthesizer_fallback;
  const fallback = f && typeof f === 'object' && name(f.from) && name(f.to) ? { from: name(f.from), to: name(f.to), reason: name(f.reason) || 'error' } : null;
  const seats_requested = int(w.seats_requested);
  const seats_answered = int(w.seats_answered);
  const note = typeof w.consensus_note === 'string' ? sanitizeText(w.consensus_note).replace(/\s+/g, ' ').trim().slice(0, 300) : '';
  const warnings = [];
  if (unavailable.length) warnings.push(`Only ${seats_answered} of ${seats_requested} models answered: ${unavailable.map((u) => `${u.provider} was unavailable in round ${u.round} (${u.reason})`).join(', ')}.${note ? ` ${note}` : ''}`);
  if (fallback) warnings.push(`The summary was written by ${fallback.to} because the synthesizer ${fallback.from} failed (${fallback.reason}).`);
  return {
    seats_requested, seats_answered, seats_unavailable: unavailable, ...(fallback ? { synthesizer_fallback: fallback } : {}),
    ...(note ? { consensus_note: note } : {}),
    flags: { synthesizer_fallback: fallback !== null, seats_lost: unavailable.length > 0, fewer_than_3_seats: seats_answered < 3 },
    warnings,
  };
}

// The tool error for a refused metering.begin().
function beginError(rsv) {
  if (rsv.kind === 'billing') return text(`error: billing: ${String(rsv.message || rsv.code).replace(/[\x00-\x1f\x7f]+/g, ' ').slice(0, 200)}`, true);
  if (rsv.kind === 'unavailable') return text('error: billing: temporarily unavailable', true);
  if (rsv.kind === 'invalid') return text(`error: ${rsv.reason}`, true);
  return text(`error: daily budget: ${rsv.reason}`, true);
}

// The connector quote (docs/token-pricing-interface.md section 2), asked with the request id the reserve will use, before it. Answers
// what metering.begin needs: { ok: true, calls, quote: { maxTokens, answerBytes, ... } } or a refusal that stops the tool call, with
// nothing reserved. calls is providers x rounds + 1 exactly (billing refuses the reserve otherwise).
const sleepMs = (ms) => new Promise((r) => setTimeout(r, ms));
async function connectorQuote(plan, { request_id, principal }) {
  const refuse = (message, kind = 'billing', code) => ({ ok: false, kind, message, ...(code ? { code } : {}) });
  const bad = pricedError([...plan.providers, plan.synthesizer], { env: process.env });
  if (bad) return refuse(`this debate cannot be priced: ${bad}`, 'billing', 'unknown_model_rate');
  const questionBytes = Buffer.byteLength(plan.question, 'utf8');
  if (questionBytes > 32000) return refuse('the question is too long to be priced (at most 32000 bytes)', 'billing', 'invalid');
  const body = { principal, request_id, providers: [...plan.providers], rounds: plan.rounds, max_words: plan.maxWords, question_bytes: questionBytes,
    question_sha256: createHash('sha256').update(plan.question, 'utf8').digest('hex'), prompt_version: 'v2' };
  // web search is on unless this call turned it off (web_search: false): ask for the cap on every panel provider this server may search with.
  // The answer's `search` object is what runs (a missing one means off); without a request the quote is the version 1 one, byte for byte.
  const searches = plan.webSearch !== false ? requestedSearches(plan.providers, process.env) : null;
  if (searches) body.searches = searches;
  let q;
  for (let attempt = 0; attempt < 3; attempt++) {
    if (attempt) await sleepMs(250 * 2 ** attempt);
    q = await pricingClient.quote(body);
    if (q.ok || !q.retry) break;
  }
  if (!q.ok) {
    if (q.code === 'unknown_model_rate') return refuse('a model on this debate has no price; nothing was charged', 'billing', q.code);
    if (q.code === 'quote_exceeds_limit') return refuse(`this debate could use up to ${q.credits} credits, above the per-debate maximum of ${q.max_credits}${Number.isSafeInteger(q.credits_off) ? ` (without web search at most ${q.credits_off}: pass web_search: false)` : ''}; try fewer rounds or a shorter question. Nothing was charged.`, 'billing', q.code);
    if (q.code) return refuse('the debate could not be priced; nothing was charged', 'billing', q.code);
    return { ok: false, kind: 'unavailable' };
  }
  const limits = limitsForPlan({ max_tokens: q.max_tokens, answer_bytes: q.answer_bytes, ...(q.search ? { max_searches: q.search.maxSearches, cite_bytes: q.search.citeBytes } : {}) },
    [...plan.providers, plan.synthesizer], { env: process.env, panel: plan.providers });
  if (limits.error) { log(`pricing: the quote does not cover the plan (${limits.error})`); return { ok: false, kind: 'unavailable' }; }
  return { ok: true, calls: plan.providers.length * plan.rounds + 1, quote: { maxTokens: limits.maxTokens, answerBytes: limits.answerBytes, credits: q.credits, maxCredits: q.max_credits, rateVersion: q.rate_version,
    ...(limits.maxSearches ? { maxSearches: limits.maxSearches, citeBytes: limits.citeBytes, ...(q.search.creditsOff !== undefined ? { creditsOff: q.search.creditsOff } : {}) } : {}) } };
}
const quoteOf = (plan) => (pricingClient ? (a) => connectorQuote(plan, a) : null);

// ---- the agent contract (lib/mcp/agent.js; billing's docs/agent-contract-spec.md). Only with AGENT_ON. ----
const agentMode = (ctx) => Boolean(AGENT_ON && pricingClient && ctx?.principal);
const stripError = (t) => String(t).replace(/^error:\s*/, '');
// a plan error as a catalog error: provider problems are panel_unavailable, a billing read that failed is service_unavailable
function agentPlanError(plan) {
  if (plan.code === 'unavailable') return agentError('service_unavailable', { message: 'the debate panel could not be read; nothing was charged' });
  const m = stripError(plan.error);
  return agentError(/provider_not_allowed|not available here|at least 2 available|at most \d+ providers|family|families|required provider/i.test(m) ? 'panel_unavailable' : 'invalid_request', { message: m });
}
// a refused metering.begin() as a catalog error
function agentBeginError(rsv) {
  if (rsv.kind === 'unavailable') return agentError('service_unavailable', { message: 'billing is temporarily unavailable; nothing was charged' });
  if (rsv.kind === 'invalid') return agentError('invalid_request', { message: rsv.reason });
  if (rsv.kind === 'local') return agentError('budget_exhausted', { message: `this server's daily budget for the key: ${rsv.reason}` });
  // the legacy quote's refusal codes (connectorQuote) and the reserve's `reason` / hook code
  if (rsv.code === 'unknown_model_rate') return agentError('panel_unavailable', { message: 'a model on this debate has no price; nothing was charged' });
  if (rsv.code === 'quote_exceeds_limit') return agentError('quote_exceeds_limit', { message: rsv.message });
  if (rsv.code === 'invalid') return agentError('invalid_request', { message: rsv.message });
  return reasonError({ reason: rsv.reason, code: rsv.code, retry_after_seconds: rsv.retry_after_seconds });
}
// the arguments only an agent-mode server accepts
function agentArgsError(args) {
  const { idempotency_key: key, quote_id: qid } = args;
  if (key !== undefined && (typeof key !== 'string' || !IDEMPOTENCY_KEY_RE.test(key))) return agentError('idempotency_key_invalid');
  if (qid !== undefined && (typeof qid !== 'string' || !QUOTE_ID_RE.test(qid))) return agentError('invalid_request', { message: 'quote_id must be the id e3d_quote returned' });
  if (qid !== undefined && key === undefined) return agentError('invalid_request', { message: 'quote_id needs an idempotency_key: a quote is single use and is bound to the first key that runs it' });
  return null;
}
// what billing's agent quote and begin are asked: the run as it will execute, never its text (only a hash and a size)
function agentRunBody(plan, principal) {
  const searches = plan.webSearch !== false ? requestedSearches(plan.providers, process.env) : null;
  return { principal, providers: [...plan.providers], rounds: plan.rounds, max_words: plan.maxWords, question_bytes: Buffer.byteLength(plan.question, 'utf8'),
    question_sha256: createHash('sha256').update(plan.question, 'utf8').digest('hex'), prompt_version: 'v2', ...(searches ? { searches } : {}) };
}
const unexpected = () => agentError('internal_error', { message: 'billing answered with something unexpected' });
// The limits a debate runs under, from an agent quote that carries them (max_tokens, answer_bytes and, with search, cite_bytes), else null.
function limitsFromAgentQuote(q, plan) {
  const isO = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
  if (!isO(q.max_tokens) || !isO(q.answer_bytes)) return null;
  const fields = { max_tokens: q.max_tokens, answer_bytes: q.answer_bytes, ...(q.search?.enabled === true && isO(q.search.max_searches) ? { max_searches: q.search.max_searches, cite_bytes: q.search.cite_bytes } : {}) };
  const l = limitsForPlan(fields, [...plan.providers, plan.synthesizer], { env: process.env, panel: plan.providers });
  return l.error ? null : { ok: true, calls: plan.providers.length * plan.rounds + 1, quote: { maxTokens: l.maxTokens, answerBytes: l.answerBytes, credits: q.max_credits, maxCredits: q.max_credits, rateVersion: q.rate_version,
    ...(l.maxSearches ? { maxSearches: l.maxSearches, citeBytes: l.citeBytes } : {}) } };
}

// e3d_quote: free, read-only. The quote row is billing's; nothing is held.
async function toolQuote(args, _progress, ctx) {
  if (!agentMode(ctx)) return text('error: unknown tool: e3d_quote', true);
  const plan = await planDebate(args, ctx);
  if (plan.error) return errorResult(agentPlanError(plan));
  const bad = pricedError([...plan.providers, plan.synthesizer], { env: process.env });
  if (bad) return errorResult(agentError('panel_unavailable', { message: `this debate cannot be priced: ${bad}` }));
  const body = agentRunBody(plan, ctx.principal);
  if (body.question_bytes > 32000) return errorResult(agentError('question_too_large'));
  const r = await pricingClient.agentQuote(body);
  if (!r.ok) return errorResult(r.error);
  if (!validQuote(r.body)) return errorResult(unexpected());
  log(`agent: quote issued principal=${ctx.principal} quote_id=${r.body.quote.quote_id} max_credits=${r.body.quote.max_credits}`);
  return quoteResult(r.body, r.body.quote.search?.enabled === true);
}

// The stored result of a finished run (begin answered `replayed`): returned as the tool result, nothing runs, nothing is charged.
function agentReplay(b, plan, args) {
  const a = agentFieldsOf(b.agent);
  if (b.outcome === 'timeout') return errorResult(agentError('debate_timeout', { message: 'the first attempt with this idempotency_key timed out; nothing more was charged. Use a new key to try again' }));
  if (b.outcome !== 'ok') return errorResult(agentError('debate_failed', { message: 'the first attempt with this idempotency_key did not finish; nothing more was charged. Use a new key to try again' }));
  const d = b.debate, res = d?.result;
  if (!a || !res || typeof res.final_answer !== 'string') return errorResult(agentError('internal_error', { message: 'the stored result of this idempotency_key is not available' }));
  const none = typeof res.dissent !== 'string' || /^["'`]*(none)?[."'`]*$/i.test(res.dissent.trim());
  const result = {
    final_answer: res.final_answer, consensus: res.consensus,
    dissent: { present: !none, summary: none ? 'none' : res.dissent },
    positions: (Array.isArray(res.positions) ? res.positions : []).map((p) => ({ provider: p.provider, text: p.position })),
    mode: args.mode ?? 'quick', providers: Array.isArray(d.providers) && d.providers.length ? d.providers : plan.providers, rounds_ran: Number.isSafeInteger(d.rounds) ? d.rounds : plan.rounds,
    warnings: [], replayed: true, ...(typeof b.debate_id === 'string' ? { debate_id: b.debate_id } : {}),
    ...(res.web_search && typeof res.web_search === 'object' ? { web_search: res.web_search } : {}),
    ...a,
  };
  return { content: [{ type: 'text', text: renderDebate(result) }], structuredContent: result };
}

// Everything an agent-mode e3d_debate call with an idempotency_key does before it reserves: quote (when no quote_id came), begin, and
// the limits the run executes under. Returns { error }, { replay } or { meta } for metering.begin (request_id = the quote id).
async function agentPrepare(args, plan, principal) {
  const bad = pricedError([...plan.providers, plan.synthesizer], { env: process.env });
  if (bad) return { error: agentError('panel_unavailable', { message: `this debate cannot be priced: ${bad}` }) };
  const body = agentRunBody(plan, principal);
  if (body.question_bytes > 32000) return { error: agentError('question_too_large') };
  let quoteId = args.quote_id; let aq = null;
  if (!quoteId) {
    const r = await pricingClient.agentQuote(body);
    if (!r.ok) return { error: r.error };
    if (!validQuote(r.body)) return { error: unexpected() };
    aq = r.body.quote; quoteId = aq.quote_id;
  }
  // a quote the caller brought is checked by billing at begin; its search flag is what this server would have asked for
  const searchEnabled = aq ? aq.search?.enabled === true : Boolean(body.searches);
  // TEMPORARY FALLBACK, remove once billing's agent quote carries max_tokens, answer_bytes and search.cite_bytes (e3d-pilot-cloud PR #144):
  // until then the limits are read from a connector quote (a separate, unused row), before anything is claimed, and must describe the same price.
  let lim = aq ? limitsFromAgentQuote(aq, plan) : null;
  if (!lim) {
    lim = await connectorQuote(plan, { request_id: randomUUID(), principal });
    if (!lim.ok) return { error: agentBeginError(lim) };
    if ((aq && (lim.quote.credits !== aq.max_credits || lim.quote.rateVersion !== aq.rate_version)) || Boolean(lim.quote.maxSearches) !== searchEnabled) return { error: agentError('quote_changed') };
  }
  const br = await pricingClient.agentBegin({ principal, idempotency_key: args.idempotency_key, quote_id: quoteId, question_sha256: body.question_sha256, providers: body.providers, rounds: body.rounds, max_words: body.max_words, search_enabled: searchEnabled });
  if (!br.ok) return { error: br.error };
  if (br.body.status === 'replayed') { log(`agent: replayed principal=${principal} quote_id=${quoteId}`); return { replay: agentReplay(br.body, plan, args) }; }
  if (br.body.status !== 'new' || br.body.request_id !== quoteId) return { error: unexpected() };
  log(`agent: begin new principal=${principal} quote_id=${quoteId}`);
  return { meta: { request_id: quoteId, quote: async () => lim } };
}

// Sends usage.json (bin/e3d-debate: one row per attempted call) to billing's POST /usage/v1/report, before finalize. Retries 5xx, 429 and
// transport failures with the same body; a refusal (400, 409) or a failure after the retries is logged and the debate is still
// finalized: billing then prices the v1 totals (and alarms), so a lost report never loses the charge or blocks the answer.
async function reportUsage(handle, file) {
  if (!pricingClient || !handle.finalize) return;
  const u = await readUsageRows(file);
  if (!u.present) { log(`pricing: no usage.json for debate_id=${handle.debate_id}; finalizing without a usage report`); return; }
  if (u.dropped) log(`pricing: ${u.dropped} malformed usage row(s) dropped debate_id=${handle.debate_id}`);
  const r = await pricingClient.report({ reservation_id: handle.reservation_id, debate_id: handle.debate_id, rows: u.rows });
  log(r.ok ? `pricing: usage reported debate_id=${handle.debate_id} rows=${u.rows.length}${r.replay ? ' (replay)' : ''}`
    : `pricing: usage report not accepted debate_id=${handle.debate_id} (${r.code ?? r.why}${r.why && r.code ? `: ${r.why}` : ''}); finalizing anyway`);
}

// Runs one reserved debate to its end and commits what actually happened (shared by e3d_debate and the async runner). The
// caller holds an execution slot (activeDebates). onStarted runs after the durable "models started" marker
// (metering.start) and before any model is invoked. signal (async runs) stops the debate: a cancelled debate is an error
// without a result. Returns { startFailed } or the outcome, with `stored` holding the result in the shape the service
// stores (ok outcomes only).
async function executeDebate(plan, handle, ctx, { progress, onStarted, signal } = {}) {
  const { question, providers, rounds, maxWords, synthesizer } = plan;
  // token pricing: the limits this debate must run under (a web run's plan carries them; a connector debate's come with its quote)
  const limits = plan.perToken ?? handle.quote ?? null;
  // per-token: search only when the quote priced it (limits.maxSearches); otherwise off, as before
  const webSearchRequested = plan.webSearch !== false && (!limits || Boolean(limits.maxSearches));
  const debateBin = process.env.E3D_MCP_DEBATE_BIN || join(ROOT, 'bin/e3d-debate');
  let settled = false;
  let ran = false;
  let lastRun = null;
  let dir = null;
  const started = Date.now();
  try {
    dir = await mkdtemp(join(tmpdir(), 'e3d-mcp-'));
    const qfile = join(dir, 'question.md');
    await writeFile(qfile, question);
    const cliArgs = ['--question-file', qfile, '--providers', providers.join(','), '--rounds', String(rounds),
      '--max-words', String(maxWords), '--out-dir', join(dir, 'out'), '--synthesizer', synthesizer,
      '--web-search', webSearchRequested ? 'on' : 'off'];
    let step = 0;
    const tag = `debate-${Date.now().toString(36)}-${Math.random().toString(16).slice(2, 8)}`;
    const usesSampling = providers.some(isSampling) || isSampling(synthesizer);
    const samplingEnv = usesSampling ? await sampling.env(ctx.session, { tag, maxTokens: Math.min(Math.max(maxWords * 3, 300), 4000) }) : {};
    const timeoutMs = usesSampling ? Math.min(LIMITS.timeoutMs, LIMITS.samplingTimeoutMs) : LIMITS.timeoutMs;
    if (!(await metering.start(handle))) return { startFailed: true };
    ran = true;
    await onStarted?.();
    const r = await run(debateBin, cliArgs, {
      timeoutMs, signal,
      env: { ...process.env, ...samplingEnv, ...debateEnvFor(limits), E3D_DEBATE_TIMEOUT_SEC: String(Math.max(Math.floor(timeoutMs / 1000), 1)) },
      onStderr: (s) => { for (const m of s.matchAll(/^=== (.+?) ===$/gm)) progress?.(++step, m[1]); },
    });
    lastRun = r;
    // The engine's own `warning:` lines (never its question or answer text): logged, bounded, and kept for the result.
    const engineWarnings = engineWarningsOf(r.err);
    for (const w of engineWarnings) log(`engine warning: ${w}`);
    // Token pricing: the vendor-reported usage of every attempted call goes to billing BEFORE finalize (a stopped debate included).
    if (limits) await reportUsage(handle, join(dir, 'out', 'usage.json'));
    // Calls that actually ran are counted from the transcript, whether or not the debate succeeded.
    const transcript = await readFile(join(dir, 'out', 'transcript.md'), 'utf8').catch(() => '');
    const webSearch = readWebSearch(await readFile(join(dir, 'out', 'web-search.json'), 'utf8').catch(() => ''), webSearchRequested,
      { providers: plan.providers.filter((p) => API_PROVIDERS.includes(p)), detail: engineWarnings.find((w) => /web search/i.test(w)) ?? engineWarnings[0] });
    const seats = readSeats(await readFile(join(dir, 'out', 'seats.json'), 'utf8').catch(() => ''));
    // with web search, everything returned is sanitised again here (e3d-debate already did): control and bidi characters,
    // markdown images, HTML and links are neutralised
    const clean = webSearch.enabled ? (t) => sanitizeText(t) : (t) => t;
    // The synthesis call counts when the transcript shows it ran ("## Synthesis" heading), or when the debate was not stopped by the timeout (a failed debate is charged conservatively).
    const spent = usageFromTranscript(transcript, question, { synthesized: /\n## Synthesis/.test(transcript) || !(r.timedOut || r.cancelled) });
    const parsed = parseVerdict(r.out);
    const verdict = parsed && webSearch.enabled ? { ...parsed, final_answer: clean(parsed.final_answer), dissent: { ...parsed.dissent, summary: clean(parsed.dissent.summary) } } : parsed;
    // Every outcome settles what actually ran (no transcript = zero calls = release).
    const outcome = r.cancelled ? 'error' : r.timedOut ? 'timeout' : (r.code !== 0 || !verdict ? 'error' : 'ok');
    const { roundsRan, positions: rawPositions } = parsePositions(transcript);
    const positions = rawPositions.map((p) => ({ ...p, text: clean(p.text) }));
    const samplingCalls = sampling.drain(tag).map((m) => ({ provider: m.voice === 'b' ? 'mcp-sampling-b' : 'mcp-sampling', model: m.model, hint: m.hint }));
    // One entry per provider+model, with how many calls it answered (a voice that also wrote the verdict made two).
    const samplingModels = [...samplingCalls.reduce((acc, m) => {
      const k = `${m.provider}|${m.model}`;
      acc.set(k, { ...m, calls: (acc.get(k)?.calls ?? 0) + 1 });
      return acc;
    }, new Map()).values()];
    // The result as the service stores it (only an ok outcome carries one).
    const stored = outcome === 'ok' ? {
      final_answer: verdict.final_answer, consensus: verdict.consensus,
      dissent: verdict.dissent.present === false ? 'none' : verdict.dissent.summary,
      positions: positions.map((p) => {
        const model = samplingModels.find((m) => m.provider === p.provider)?.model;
        return { provider: p.provider, model: typeof model === 'string' && /^[!-~]{1,128}$/.test(model) ? model : 'unspecified', position: p.text };
      }),
      web_search: webSearch,
    } : null;
    // With finalize, the service stores the result with the charge.
    const finalizeMeta = handle.finalize ? { transcript: transcript || null, finished_at: Date.now(), result: stored } : {};
    // search usage is recorded per provider like tokens (models[].searches); it never changes the calls that are charged
    const models = modelsFromTranscript(transcript, { synthesizer, calls: spent.calls }).map((m) => ({ ...m, searches: webSearch.searches_by_provider[m.provider] ?? 0 }));
    const { budget, billing } = await metering.commit(handle, { ...spent, searches: webSearch.searches_used }, { outcome, duration_ms: Date.now() - started, models, ...finalizeMeta });
    settled = true;
    return { r, timeoutMs, transcript, spent, verdict, outcome, roundsRan, positions, samplingModels, stored, budget, billing, webSearch, engineWarnings, seats };
  } finally {
    // Not settled (an unexpected error): give the reservation back, as before. With the hook, once the debate binary
    // has run the intent is kept instead, so the next start reconciles it per E3D_MCP_ORPHAN_POLICY (never free).
    if (!settled && (!ran || !metering.hooked)) await metering.abort(handle, 'not_run').catch(() => {});
    else if (!settled) {
      // the process is still alive, so restart recovery would skip this intent: settle what the transcript shows now
      const t = dir ? await readFile(join(dir, 'out', 'transcript.md'), 'utf8').catch(() => '') : '';
      const spent = usageFromTranscript(t, question, { synthesized: /\n## Synthesis/.test(t) || (lastRun ? !lastRun.timedOut : false) });
      await metering.commit(handle, spent, { outcome: 'error', duration_ms: Date.now() - started, models: modelsFromTranscript(t, { synthesizer, calls: spent.calls }), ...(handle.finalize ? { transcript: t || null } : {}) }).catch(() => {});
    }
    if (dir) rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

// Token pricing (interface section 6): the billing object of a per_token debate gains quote_credits, charged_credits and the usage
// (input_tokens, output_tokens, source vendor | estimate); the pricing object itself is not passed on. Other billing is unchanged.
function billingResult(b) {
  const { pricing, agent: _agent, ...rest } = b;
  return pricing ? { ...rest, quote_credits: pricing.quote_credits, charged_credits: pricing.charged_credits, usage: pricing.usage,
    ...(pricing.search ? { searches: pricing.search.searches, search_credits: pricing.search.charged_credits_search } : {}) } : rest;
}

async function toolDebate(args, progress, ctx) {
  // `agent` = this call uses the agent contract (a quote_id or an idempotency_key was sent): structured errors, the advice line, warnings.
  // A call with neither is the legacy path: its error texts and success text are exactly as before; only additive structuredContent fields are added.
  const agentOn = agentMode(ctx);
  const agent = agentOn && (args.idempotency_key !== undefined || args.quote_id !== undefined);
  if (agent) { const e = agentArgsError(args); if (e) return errorResult(e); }
  const plan = await planDebate(args, ctx);
  if (plan.error) return agent ? errorResult(agentPlanError(plan)) : text(plan.error, true);
  const { question, mode, rounds, maxWords, providers, synthesizer, selection, selectionNote, panel } = plan;

  // Refuse BEFORE spending if the worst case for this request would break today's cap.
  const principal = ctx?.principal ?? 'local';
  const worst = worstFor(plan);
  // With an idempotency_key (agent mode): quote, claim the key at billing (a repeat of a finished run returns its stored result here), and reserve under the quote's id.
  let agentMeta = null;
  if (agent && args.idempotency_key !== undefined) {
    const prep = await agentPrepare(args, plan, principal);
    if (prep.error) return errorResult(prep.error);
    if (prep.replay) return prep.replay;
    agentMeta = prep.meta;
  }
  // Reserve the worst case first (atomically, so concurrent debates cannot overshoot the cap), then settle to actual use.
  // With the external hook, metering.begin also reserves at the billing service and persists an intent before returning.
  // When the service advertises finalize, the debate (question, providers, rounds) is finalized and stored there at the end.
  const rsv = await metering.begin(principal, worst, { tool: 'e3d_debate', debate: { question, providers, rounds }, ...(agentMeta ?? (ctx?.principal && quoteOf(plan) ? { quote: quoteOf(plan) } : {})) });
  if (!rsv.ok) return agent ? errorResult(agentBeginError(rsv)) : beginError(rsv);
  const { handle } = rsv;
  if (activeDebates >= LIMITS.concurrent) { await metering.abort(handle, 'busy').catch(() => {}); return agent ? errorResult(agentError('concurrency_limit', { message: `${LIMITS.concurrent} debates already running on this server` })) : text(`error: ${LIMITS.concurrent} debates already running; retry shortly`, true); }
  activeDebates++;
  let x;
  try { x = await executeDebate(plan, handle, ctx, { progress }); } finally { activeDebates--; runs?.pump(); }
  if (x.startFailed) return agent ? errorResult(agentError('service_unavailable', { message: 'billing is temporarily unavailable' })) : text('error: billing: temporarily unavailable', true);
  const { r, timeoutMs, transcript, spent, verdict, roundsRan, positions, samplingModels, budget, billing, webSearch, seats } = x;
  if (agent && r.timedOut) return errorResult(agentError('debate_timeout', { message: `the debate timed out after ${timeoutMs / 1000} s and was stopped; ${spent.calls} model call(s) had already answered and were counted. Use a new idempotency_key with mode quick or fewer models` }));
  if (agent && (r.code !== 0 || !verdict)) return errorResult(agentError('debate_failed', { message: `the debate did not finish (exit ${r.code}); use a new idempotency_key to try again` }));
  if (r.timedOut) return text(`error: debate timed out after ${timeoutMs / 1000}s and was stopped. ${spent.calls} model call(s) had already answered and are counted against today's budget (${budget?.remaining_calls ?? 'no limit'} calls left). Try mode "quick", fewer providers, or a shorter question.`, true);
  if (r.code !== 0 || !verdict) return text(`error: debate failed (exit ${r.code})\n${redact(r.err.slice(-1500))}`, true);

  const indep = independence(providers, samplingModels);
  const result = {
    ...verdict,
    mode, providers, rounds_requested: rounds, rounds_ran: roundsRan || rounds,
    selection, selection_note: selectionNote, synthesizer,
    ...(samplingModels.length ? { models: samplingModels } : {}),
    independent: indep.independent, warnings: [...indep.warnings, ...searchSetupWarnings(webSearch), ...(seats?.warnings ?? []), ...(agent && !billing?.agent ? ['The billing result for this run is not available yet, so cost, dissent_items and recommended_next_step are missing: treat the advice as no_op and read the dissent above.'] : [])],
    ...(indep.families.length ? { families: indep.families } : {}),
    ...(seats ? { seats_requested: seats.seats_requested, seats_answered: seats.seats_answered, seats_unavailable: seats.seats_unavailable, flags: seats.flags,
      ...(seats.synthesizer_fallback ? { synthesizer_fallback: seats.synthesizer_fallback } : {}), ...(seats.consensus_note ? { consensus_note: seats.consensus_note } : {}) } : {}),
    ...(panel ? { panel } : {}),
    usage: { model_calls: spent.calls, est_input_tokens: spent.inTokens, est_output_tokens: spent.outTokens, searches: webSearch.searches_used, estimate: billing?.pricing?.usage.source !== 'vendor' },
    web_search: webSearch,
    budget,
    ...(billing ? { billing: billingResult(billing) } : {}),
    ...(agentOn ? (billing?.agent ? billing.agent : { schema_version: AGENT_SCHEMA_VERSION }) : {}),
    positions,
    ...(args.include_transcript ? { transcript: transcript.trim() } : {}),
  };
  // the legacy path's text is unchanged: the advice line is only for calls that use the contract
  return { content: [{ type: 'text', text: renderDebate(agent ? result : { ...result, recommended_next_step: undefined, notice: undefined }) }], structuredContent: result };
}

// ---- async debates (hosted, external hook only; lib/mcp/runs.js): start, check on, and get the result later ----
let runs = null; // the run store, once the external hook is running
let runsConfig = null;
const ASYNC_TOOLS = new Set(['e3d_debate_start', 'e3d_debate_status', 'e3d_debate_result']);
// Exposed only when the service advertises both finalize (the result is stored with the charge) and fetch (it can be read
// back after the local copy expires): otherwise a paid async result could become unreachable.
const asyncEnabled = () => Boolean(runs) && Boolean(hookState?.external?.hasFeature('finalize')) && Boolean(hookState?.external?.hasFeature('fetch'));
const lookupError = (r) => (r.code === 'rate_limited'
  ? text(`error: rate_limited: too many checks on debates; retry in ${r.retry_after} s`, true)
  : r.code === 'unavailable' ? text('error: temporarily unavailable; retry shortly', true)
    : text('error: not_found: no debate with that id', true));
const debateIdOf = (args) => (typeof args.debate_id === 'string' ? args.debate_id : '');

async function toolDebateStart(args, _progress, ctx) {
  // A run continues after the client's request has ended, so it can never use the client's own models through MCP sampling
  // (that needs the live client session). Refuse that before anything is reserved, and never pick it by default.
  const asked = [...(Array.isArray(args?.providers) ? args.providers : []), args?.synthesizer].filter((p) => typeof p === 'string');
  if (asked.some(isSampling)) return text('error: invalid: a started debate runs on the server\'s own models and cannot use your client\'s models (mcp-sampling). Use e3d_debate for that, or leave the providers unset.', true);
  const plan = await planDebate(args, { ...ctx, session: null }, { clamp: runsConfig.customer });
  if (plan.error) return text(plan.error, true);
  const principal = ctx?.principal ?? 'local';
  const worst = worstFor(plan);
  const r = await runs.start({ principal, plan, worst, ...(quoteOf(plan) ? { quote: quoteOf(plan) } : {}) });
  if (!r.ok) return r.kind === 'begin' ? beginError(r.rsv) : text(`error: ${r.kind === 'busy' ? 'busy: ' : ''}${r.message}`, true);
  const out = { debate_id: r.debate_id, status: r.status, poll_after_sec: r.poll_after_sec };
  return { content: [{ type: 'text', text: `Debate started (id ${r.debate_id}, ${r.status}). It runs on the server even if you stop waiting. Check on it with e3d_debate_status in about ${r.poll_after_sec} seconds, then get the answer with e3d_debate_result.` }], structuredContent: out };
}

async function toolDebateStatus(args, _progress, ctx) {
  const r = await runs.status(ctx?.principal ?? 'local', debateIdOf(args));
  if (!r.ok) return lookupError(r);
  const s = r.status;
  const line = s.status === 'done' ? 'The debate is finished: get the answer with e3d_debate_result.'
    : s.status === 'failed' ? `The debate did not finish (${s.outcome ?? 'error'}). e3d_debate_result shows what is known.`
      : `The debate is ${s.status}${s.progress ? ` (step ${s.progress.step}: ${s.progress.message})` : ''}. Check again in about ${s.poll_after_sec} seconds.`;
  return { content: [{ type: 'text', text: line }], structuredContent: s };
}

function renderStored(d) {
  const res = d.result;
  const label = res?.consensus === 'full' ? 'FULL CONSENSUS' : res?.consensus === 'majority' ? 'MAJORITY (some dissent)' : res?.consensus === 'split' ? 'SPLIT' : 'CONSENSUS UNKNOWN';
  const lines = [
    `REPORT THIS TO THE USER (do not drop any of it when summarizing): consensus is ${label}; dissent: ${res.dissent}.`, '',
    `# Debate verdict: ${label}`, `_${d.providers.join(', ')} | ${d.rounds} round${d.rounds === 1 ? '' : 's'}_`, '',
    `**Answer:** ${res.final_answer}`, '',
    res.dissent === 'none' ? '**Dissent:** none' : `**Dissent (report this to the user, do not drop it when summarizing):** ${res.dissent}`, '',
  ];
  if (res.web_search && typeof res.web_search === 'object') lines.push(...renderWebSearch(res.web_search));
  if (res.positions?.length) {
    lines.push('**Each model\'s final position:**');
    for (const p of res.positions) lines.push('', `**${p.provider}:**`, ...String(p.position).split('\n').map((l) => `> ${l}`));
  }
  if (typeof d.transcript === 'string') lines.push('', '<details><summary>Full transcript</summary>', '', d.transcript, '', '</details>');
  return lines.join('\n');
}

async function toolDebateResult(args, _progress, ctx) {
  if (args.include_transcript !== undefined && typeof args.include_transcript !== 'boolean') return text('error: include_transcript must be a boolean', true);
  const r = await runs.result(ctx?.principal ?? 'local', debateIdOf(args), args.include_transcript === true);
  if (!r.ok) return lookupError(r);
  const d = r.debate;
  const out = {
    debate_id: d.debate_id, status: d.status, outcome: d.outcome,
    ...(d.result ? { final_answer: d.result.final_answer, consensus: d.result.consensus, dissent: d.result.dissent, positions: d.result.positions } : {}),
    ...(d.result?.web_search && typeof d.result.web_search === 'object' ? { web_search: d.result.web_search } : {}),
    providers: d.providers, rounds: d.rounds, usage: d.usage, credits_charged: d.credits_charged, created_at: d.created_at, finished_at: d.finished_at,
    truncated: d.truncated, source: d.source, ...(d.poll_after_sec ? { poll_after_sec: d.poll_after_sec } : {}),
    ...(args.include_transcript === true && 'transcript' in d ? { transcript: d.transcript } : {}),
  };
  if (d.status === 'queued' || d.status === 'running') return { content: [{ type: 'text', text: `The debate is still ${d.status}. Check again in about ${d.poll_after_sec} seconds.` }], structuredContent: out };
  if (!d.result) return { content: [{ type: 'text', text: `The debate did not finish (${d.outcome ?? 'error'}), so there is no answer. ${d.credits_charged ? `${d.credits_charged} credit(s) were charged for the model calls that ran.` : 'Nothing was charged for an answer.'}` }], structuredContent: out };
  return { content: [{ type: 'text', text: renderStored(d) }], structuredContent: out };
}

// e3d_list_providers spends nothing, so its panel lookup may be cached briefly (30 s per principal); a debate never uses it.
const listPanelCache = new Map();
async function accountPanelLine(principal) {
  const hit = listPanelCache.get(principal);
  if (hit && hit.until > Date.now()) return hit.line;
  const r = await panelClient.resolve(principal);
  const line = r.ok ? `Your account's panel: ${r.providers.map((p) => p.id).join(', ') || 'none'} (${r.source === 'account' ? 'your choice' : 'the default'}; change it in Settings > Debate panel)`
    : "Your account's panel: could not be read right now; debates are refused until it can be.";
  if (r.ok) {
    listPanelCache.set(principal, { line, until: Date.now() + 30000 });
    while (listPanelCache.size > 1000) listPanelCache.delete(listPanelCache.keys().next().value);
  }
  return line;
}

async function toolListProviders(_args, _progress, ctx) {
  const known = await configuredProviders();
  const samplingOn = sampling.available(ctx?.session);
  const allowed = PANEL_CONFIG.allowed;
  // With the hosted allowlist, only the providers this server offers are listed (sampling voices never are).
  const lines = (allowed ? known.filter((k) => allowed.includes(k.name)) : known).map(providerLine);
  if (samplingOn && !allowed) {
    lines.push("mcp-sampling: available (this client's own models via MCP sampling, e.g. Copilot in VS Code)");
    lines.push('mcp-sampling-b: available (a second model family from the same client, if it allows one)');
  }
  if (panelClient && ctx?.principal) lines.push('', await accountPanelLine(ctx.principal));
  else {
    // the ACTUAL default of this deployment: only offered providers, the required ones first, no more than the server's per-debate maximum
    const offered = allowed ? known.filter((k) => allowed.includes(k.name)) : known;
    const pick = chooseVoices({ known: offered, samplingOn: samplingOn && !allowed });
    const eff = withRequired(pick.providers, REQUIRED).slice(0, LIMITS.providers);
    lines.push('', `Default voices for e3d_debate: ${eff.join(', ') || 'none'} (${pick.note}${REQUIRED.length ? '; required providers first' : ''})`);
  }
  lines.push(searchAvailability(process.env).text);
  return text(lines.join('\n') || 'no providers found');
}

async function requireRepo(path) {
  if (typeof path !== 'string' || !path) throw new Error('`repo` (absolute path to a repo using e3d-pilot) is required');
  const abs = resolve(path);
  try { if (!(await stat(join(abs, '.e3d-pilot'))).isDirectory()) throw 0; }
  catch { throw new Error(`${abs} has no .e3d-pilot directory -- not an e3d-pilot repo`); }
  return abs;
}

async function toolProvenanceTrace(args) {
  const repo = await requireRepo(args.repo);
  if (typeof args.idea_id !== 'string' || !/^idea-[A-Za-z0-9]+$/.test(args.idea_id)) return text('error: idea_id must look like idea-<hex>', true);
  const r = await run(join(ROOT, 'bin/e3d-pilot'), ['provenance', 'trace', '--repo', repo, args.idea_id, '--json']);
  return r.code === 0 ? text(r.out) : text(`error: ${r.err || r.out}`, true);
}

async function toolIdeasList(args) {
  const repo = await requireRepo(args.repo);
  const cli = ['ideas', 'list', '--repo', repo, '--json'];
  if (args.status !== undefined) {
    if (typeof args.status !== 'string' || !NAME_RE.test(args.status)) return text('error: invalid status', true);
    cli.push('--status', args.status);
  }
  const r = await run(join(ROOT, 'bin/e3d-pilot'), cli);
  if (r.code !== 0) return text(`error: ${r.err || r.out}`, true);
  // Raw idea records carry full notes/provenance (hundreds of KB per repo); return a compact index.
  const ideas = JSON.parse(r.out);
  const limit = 50;
  const rows = ideas.slice(0, limit).map((i) => ({
    idea_id: i.idea_id, status: i.status, title: i.title, category: i.category,
    updated_at: i.updated_at, last_decision_at: i.last_decision_at,
  }));
  return text(JSON.stringify({ total: ideas.length, shown: rows.length, ideas: rows }, null, 2));
}

// The web_search object in e3d_debate's structured result (docs/web-search-interface.md).
const WEB_SEARCH_SCHEMA = {
