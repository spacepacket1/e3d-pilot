        final_answer: { type: 'string' }, consensus: { type: 'string', enum: ['full', 'majority', 'split', 'unknown'] }, dissent: { type: 'string', description: '"none" when there is no dissent.' },
        positions: { type: 'array', items: { type: 'object', properties: { provider: { type: 'string' }, model: { type: 'string' }, position: { type: 'string' } }, required: ['provider', 'position'] } },
        providers: { type: 'array', items: { type: 'string' } }, rounds: { type: 'integer' }, credits_charged: { type: ['integer', 'null'] },
        source: { type: 'string', enum: ['local', 'service'] }, transcript: { type: ['string', 'null'] }, poll_after_sec: { type: 'integer' },
        web_search: WEB_SEARCH_SCHEMA,
      },
      required: ['debate_id', 'status'],
    },
    annotations: { title: 'Get a debate result', readOnlyHint: true, destructiveHint: false, openWorldHint: false, idempotentHint: true },
  },
  {
    name: 'e3d_list_providers',
    description: 'List the model providers this server can use and whether each is available to join a debate. Free.',
    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
    annotations: { title: 'List debate providers', readOnlyHint: true, destructiveHint: false, openWorldHint: false },
  },
  {
    name: 'e3d_provenance_trace',
    description: 'Trace why a change exists: for an e3d-pilot idea, return its lineage -- origin, debates and decisions (with dissent), approvals, execution, review, outcome. Read-only.',
    inputSchema: {
      type: 'object',
      properties: {
        repo: { type: 'string', description: 'Absolute path to a repo managed by e3d-pilot (has .e3d-pilot/).' },
        idea_id: { type: 'string', description: 'Idea id, e.g. idea-a785c206642b.' },
      },
      required: ['repo', 'idea_id'],
      additionalProperties: false,
    },
    annotations: { title: 'Trace decision provenance', readOnlyHint: true, openWorldHint: false },
  },
  {
    name: 'e3d_ideas_list',
    description: 'List the ideas tracked by e3d-pilot in a repo, optionally filtered by status, to find an idea id for e3d_provenance_trace. Read-only.',
    inputSchema: {
      type: 'object',
      properties: {
        repo: { type: 'string', description: 'Absolute path to a repo managed by e3d-pilot.' },
        status: { type: 'string', description: 'Optional status filter, e.g. approved, implemented.' },
      },
      required: ['repo'],
      additionalProperties: false,
    },
    annotations: { title: 'List ideas', readOnlyHint: true, openWorldHint: false },
  },
];

// ---- pipeline-over-MCP (jobs, repo allowlist, gates); the four tools above are unchanged ----
const rpc = createRpc(send);
const guard = createRepoGuard();
const jobs = createJobs();
const pipeline = createPipelineTools({ guard, jobs });
// stdio: unlimited unless E3D_MCP_DAILY_* are set; hosted (HTTP) mode ships with finite defaults.
// a server that advertises per_token_search_v1 caps web searches at 160 per principal per day unless E3D_MCP_DAILY_SEARCHES says otherwise
// (the owner's setting: ten worst-case four-vendor debates)
const usage = createUsage({ defaults: HTTP_MODE ? { calls: 100, tokens: 500000, ...(searchCapable(process.env, { mode: PRICING_CONFIG.mode }) ? { searches: 160 } : {}) } : { calls: 0, tokens: 0 } });
// Without E3D_MCP_AUTH_URL this is the local usage object unchanged; the hook is attached at hosted startup below.
let metering = createMetering({ localUsage: usage, log });
let hookState = null; // { metering, outbox } once the external hook is running (read by e3d_usage)
const sampling = createSampling({ rpc, log });
// One connection object per client: stdio has exactly one; HTTP makes one per session. Hosted (HTTP) connections
// never advertise sampling, elicitation or roots, so the server never needs to call back into the client.
const stdioConn = { send, session: { clientInfo: null, capabilities: {}, rootsReady: null }, principal: process.env.E3D_MCP_PRINCIPAL || 'local', rpc, hosted: false, allowed: null };
const newHttpConn = (principal, allowed) => ({ send: () => {}, session: { clientInfo: null, capabilities: {}, rootsReady: null }, principal, rpc: null, hosted: true, allowed });
const actions = createPipelineActions({ guard, jobs, base: pipeline, usage });
TOOLS.push(...pipeline.tools, ...actions.tools, usageTool);

// The client's workspace folders (MCP roots) are the default set of repos the pipeline tools may touch.
async function refreshRoots(session = stdioConn.session) {
  if (!session.capabilities.roots) return;
  try {
    const r = await rpc.request('roots/list', {}, 10000);
    guard.setClientRoots((r?.roots ?? []).map((x) => x.uri));
  } catch (e) { log('roots/list failed:', e.message); }
}

const HANDLERS = {
  e3d_debate: toolDebate,
  e3d_quote: toolQuote,
  e3d_debate_start: toolDebateStart,
  e3d_debate_status: toolDebateStatus,
  e3d_debate_result: toolDebateResult,
  e3d_list_providers: toolListProviders,
  e3d_provenance_trace: toolProvenanceTrace,
  e3d_ideas_list: toolIdeasList,
  ...pipeline.handlers,
  ...actions.handlers,
  e3d_usage: usageHandler(usage, () => hookState),
};

// A tool the connection may use. e3d_quote is free and only prices what e3d_debate runs, so whoever may debate may quote.
const permits = (conn, name) => !conn.allowed || conn.allowed.has(name) || (name === 'e3d_quote' && conn.allowed.has('e3d_debate'));

async function handle(msg, conn = stdioConn) {
  const { id, method, params } = msg;
  const { session } = conn;
  const isRequest = id !== undefined && id !== null;
  const reply = (result) => isRequest && conn.send({ jsonrpc: '2.0', id, result });
  const fail = (code, message) => isRequest && conn.send({ jsonrpc: '2.0', id, error: { code, message } });

  switch (method) {
    case 'initialize': {
      session.clientInfo = params?.clientInfo ?? null;
      session.capabilities = conn.hosted ? {} : (params?.capabilities ?? {});
      const want = params?.protocolVersion;
      return reply({
        protocolVersion: SUPPORTED_PROTOCOLS.includes(want) ? want : SUPPORTED_PROTOCOLS[0],
        capabilities: { tools: { listChanged: false }, prompts: { listChanged: false } },
        serverInfo: SERVER_INFO,
        instructions: conn.hosted && AGENT_ON ? AGENT_INSTRUCTIONS
          : conn.hosted
          ? 'Use e3d_debate for contestable decisions where independent model perspectives and recorded dissent add value; always report its dissent, and never present a split verdict as settled. It uses a shared usage budget (see e3d_usage); do not use it for simple lookups.'
          : 'Use e3d_debate for contestable decisions where independent model perspectives and recorded dissent add value; always report its dissent. It costs credits; do not use it for simple lookups. The e3d_pilot_* tools run a human-gated pipeline: propose an idea, a human approves it (e3d_pilot_approve tells you how; never approve on your own), e3d_pilot_implement drafts and negotiates a spec and pauses, e3d_pilot_code_plan shows the plan, and only after the user agrees does e3d_pilot_execute write code and open a draft PR. Tools marked FREE spend nothing; tools marked SPENDS MODEL CREDITS do. Merging is never available here.',
      });
    }
    case 'notifications/initialized': if (!conn.hosted) session.rootsReady = refreshRoots(session); return;
    case 'notifications/roots/list_changed': if (!conn.hosted) session.rootsReady = refreshRoots(session); return;
    case 'ping': return reply({});
    case 'prompts/list': return reply({ prompts: listPrompts(conn.allowed) });
    case 'prompts/get': {
      const got = getPrompt(params?.name, params?.arguments, conn.allowed);
      if (got?.error) return fail(-32602, got.error);
      return got ? reply(got) : fail(-32602, `unknown prompt: ${params?.name}`);
    }
    case 'tools/list': {
      // the async debate tools exist only while the service advertises finalize and fetch
      const gated = asyncEnabled() ? TOOLS : TOOLS.filter((t) => !ASYNC_TOOLS.has(t.name));
      // agent mode (hosted, per-token): e3d_debate takes quote_id and idempotency_key, and e3d_quote is offered (to whoever may debate)
      const listed = AGENT_ON && conn.hosted ? gated.flatMap((t) => (t.name === 'e3d_debate' ? [extendDebateTool(t), ...(permits(conn, 'e3d_quote') ? [quoteTool(t)] : [])] : [t])) : gated;
      return reply({ tools: conn.allowed ? listed.filter((t) => permits(conn, t.name)) : listed });
    }
    case 'tools/call': {
      const handler = HANDLERS[params?.name];
      // A tool outside this connection's allowlist (or a gated one) is reported exactly like one that does not exist.
      if (!handler || !permits(conn, params.name) || (params.name === 'e3d_quote' && !(AGENT_ON && conn.hosted)) || (ASYNC_TOOLS.has(params.name) && !asyncEnabled())) return fail(-32602, `unknown tool: ${params?.name}`);
      const token = params?._meta?.progressToken;
      const progress = token === undefined || conn.hosted ? undefined : (n, message) =>
        conn.send({ jsonrpc: '2.0', method: 'notifications/progress', params: { progressToken: token, progress: n, message } });
      try {
        await session.rootsReady;
        return reply(await handler(params.arguments ?? {}, progress, { session, rpc: conn.rpc, sampling, principal: conn.principal, samplingEnv: (tag) => sampling.env(session, { tag }) }));
      } catch (e) {
        return reply(text(`error: ${e.message}`, true));
      }
    }
    default:
      if (!isRequest) return; // notifications (initialized, cancelled, ...) need no reply
      return fail(-32601, `method not found: ${method}`);
  }
}

// ---- CLI helpers: `e3d-mcp --doctor` and `e3d-mcp --print-config` (no server) ----
// --no-update-notifier keeps npm's "new version available" banner out of the editor's MCP log.
const CLIENT_ARGS = ['-y', '--no-update-notifier', '-p', 'e3d-pilot', 'e3d-mcp'];

if (process.argv.includes('--doctor')) process.exit(await doctor());
{
  // Operator commands for the settlement outbox: ids, call names, ages and counts only.
  const argv = process.argv;
  const operand = (flag) => { const i = argv.indexOf(flag); return i > -1 ? argv[i + 1] : undefined; };
  const opDir = () => createUsage({ env: process.env }).dir;
  const op = async (fn) => { try { await fn(); process.exit(0); } catch (e) { process.stderr.write(`e3d-mcp: ${redact(e.message)}\n`); process.exit(1); } };
  if (argv.includes('--outbox-status')) await op(async () => { console.log((await outboxStatus(opDir())).lines.join('\n')); });
  if (argv.includes('--outbox-export')) await op(async () => { const r = await outboxExport(opDir(), operand('--outbox-export')); console.log(`exported ${r.count} record(s) (${r.dead} dead), mode 0600, no tokens`); });
  if (argv.includes('--outbox-retry-dead')) await op(async () => { const r = await outboxRetryDead(opDir(), operand('--outbox-retry-dead')); console.log(`moved ${r.record_id} back to pending`); });
}
if (process.argv.includes('--print-config')) {
  const local = process.argv.includes('--local');
  const cmd = local ? { command: process.execPath, args: [fileURLToPath(import.meta.url)] } : { command: 'npx', args: CLIENT_ARGS };
  // Same shape and formatting as the README snippet, so users can compare them by eye.
  console.log(`{
  "servers": {
    "e3d-pilot": { "type": "stdio", "command": ${JSON.stringify(cmd.command)}, "args": ${JSON.stringify(cmd.args).replace(/,/g, ', ')} }
  }
}`);
  console.error(`# Paste this into .vscode/mcp.json (VS Code / Copilot agent mode).${!local && checkoutConfigHint() ? ' Add --local to point at this checkout instead of the npm package.' : ''}`);
  process.exit(0);
}

if (!PANEL_CONFIG.ok) {
  process.stderr.write(`[e3d-mcp] refusing to start: ${PANEL_CONFIG.errors.join('; ')}\n`);
  process.exit(2);
}
if (!REQUIRED_CONFIG.ok) {
  process.stderr.write(`[e3d-mcp] refusing to start: ${REQUIRED_CONFIG.errors.join('; ')}\n`);
  process.exit(2);
}
if (!AGENT_CONFIG.ok) {
  process.stderr.write(`[e3d-mcp] refusing to start: ${AGENT_CONFIG.errors.join('; ')}\n`);
  process.exit(2);
}
if (!PRICING_CONFIG.ok) {
  process.stderr.write(`[e3d-mcp] refusing to start: ${PRICING_CONFIG.errors.join('; ')}\n`);
  process.exit(2);
}
if (PANEL_CONFIG.panel && !HTTP_MODE) {
  process.stderr.write('[e3d-mcp] E3D_MCP_PANEL is only supported in hosted mode (--http) with E3D_MCP_AUTH_URL; unset it for stdio.\n');
  process.exit(2);
}
if (AUTH_HOOK && !HTTP_MODE) {
  process.stderr.write('[e3d-mcp] E3D_MCP_AUTH_URL is only supported in hosted mode (--http); unset it for stdio.\n');
  process.exit(2);
}
// The internal run listener (lib/mcp/run-server.js): hosted mode with the external hook only.
const RUN_SERVER = validateRunServerConfig(process.env);
delete process.env.E3D_MCP_RUN_TOKEN; // read once; never inherited by the debate processes
if (RUN_SERVER.enabled && !HTTP_MODE) {
  process.stderr.write('[e3d-mcp] E3D_MCP_RUN_PORT is only supported in hosted mode (--http) with E3D_MCP_AUTH_URL; unset it for stdio.\n');
  process.exit(2);
}

// The async runner's executor: a hosted run never has sampling (no client to call back), so the plan is run as is.
async function runAsyncDebate({ plan, handle, principal, onStarted, progress, signal }) {
  const ctx = { session: { clientInfo: null, capabilities: {}, rootsReady: null }, principal };
  const x = await executeDebate(plan, handle, ctx, { progress, onStarted, signal });
  if (x.startFailed) return { startFailed: true };
  return { outcome: x.outcome, result: x.stored, transcript: x.transcript || null,
    usage: { calls: x.spent.calls, est_input_tokens: x.spent.inTokens, est_output_tokens: x.spent.outTokens, searches: x.webSearch?.searches_used ?? 0 }, billing: x.billing };
}

// A web run's plan: the same validation and customer maxima as e3d_debate_start; no client, so no sampling.
// With the per-token run fields (perToken, already validated by the run listener) the plan is exactly what was quoted: rounds and
// max_words are never clamped, web search is off (it is not priced), and every provider needs its output limit and answer-bytes limit.
async function planWebRun(fields, { perToken = null } = {}) {
  const ctx = { session: { clientInfo: null, capabilities: {}, rootsReady: null }, principal: null };
  const clamp = perToken ? { ...runsConfig.customer, rounds: Infinity, max_words: Infinity } : runsConfig.customer;
  const plan = await planDebate({ question: fields.question, providers: fields.providers, rounds: fields.rounds, max_words: fields.max_words, web_search: perToken ? Boolean(perToken.max_searches) : fields.web_search }, ctx, { clamp, web: true });
  if (plan.error) return plan;
  if (perToken) {
    const limits = limitsForPlan(perToken, [...plan.providers, plan.synthesizer], { env: process.env, panel: plan.providers });
    if (limits.error) return { error: `error: invalid: ${limits.error}` };
    // the searches the run will make are exactly the quoted ones: the daily search estimate uses them, and search is off without them
    const caps = limits.maxSearches;
    const searchPart = caps ? { webSearch: true, searchProviders: Object.keys(caps).length, maxSearchesPerCall: Math.max(...Object.values(caps)) } : { webSearch: false, searchProviders: 0, maxSearchesPerCall: 0 };
    const priced = { ...plan, ...searchPart, perToken: limits };
    return { plan: priced, worst: worstFor(priced) };
  }
  return { plan, worst: worstFor(plan) };
}

// The external hook: validate everything, then recover crashed work and start outbox delivery BEFORE listening.
async function startAuthHook() {
  const checked = validateAuthConfig(process.env);
  const errors = [...checked.errors, ...RUN_SERVER.errors];
  try { orphanPolicy(process.env); } catch (e) { errors.push(e.message); }
  const runsChecked = validateRunsConfig(process.env);
  errors.push(...runsChecked.errors);
  const customerMax = runsChecked.config?.customer?.providers;
  if (REQUIRED.length && Number.isInteger(customerMax) && REQUIRED.length > customerMax) errors.push(`E3D_MCP_REQUIRED_PROVIDERS names ${REQUIRED.length} providers; at most ${customerMax} per started debate (E3D_MCP_CUSTOMER_LIMITS providers)`);
  if (errors.length) throw new Error(`external auth hook: refusing to start: ${errors.join('; ')}`);
  if (process.env.E3D_MCP_AUTH_TOKENS) log('warning: E3D_MCP_AUTH_TOKENS is ignored because E3D_MCP_AUTH_URL is set (keys are checked by the auth service)');
  const external = createExternalAuth({ log, agent: AGENT_ON });
  // E3D_MCP_PANEL=1: every hosted debate asks billing for the account's panel first (refused on any failure).
  if (PANEL_CONFIG.panel) panelClient = createPanelClient({ log });
  if (PRICING_CONFIG.mode === 'per_token') pricingClient = createPricingClient({ log });
  const outbox = createOutbox({ dir: usage.dir, auth: external, log });
  external.attachOutbox(outbox);
  metering = createMetering({ localUsage: usage, external, outbox, log, dir: usage.dir });
  // Async runs share the debate execution slots (LIMITS.concurrent) with e3d_debate.
  runsConfig = runsChecked.config;
  const store = createRuns({ dir: usage.dir, config: runsConfig, metering, outbox, external, log,
    execute: runAsyncDebate,
    acquireExec: () => { if (activeDebates >= LIMITS.concurrent) return false; activeDebates++; return true; },
    releaseExec: () => { activeDebates--; } });
  outbox.setFinalizeHook?.(({ debate_id }) => store.purgeUnstored(debate_id));
  await store.load();
  // queued runs that never started their models keep their intents (resumed below); every other intent is reconciled here
  const { recovered } = await metering.recover({ claim: store.claimIntent });
  if (recovered) log(`metering: reconciled ${recovered} unfinished debate(s) from a previous run`);
  await outbox.start();
  runs = store;
  await runs.recover();
  runs.startTimers();
  const healthSec = Number.parseInt(process.env.E3D_MCP_AUTH_HEALTH_SEC ?? '', 10);
  const readiness = createReadiness({ external, outbox, log, intervalMs: (Number.isSafeInteger(healthSec) && healthSec > 0 ? healthSec : 15) * 1000 });
  await readiness.start();
  hookState = { metering, outbox, external, runs };
  return { external, outbox, readiness };
}

// ---- HTTP (hosted) mode: `e3d-mcp --http [--port N] [--host H]` ----
if (HTTP_MODE) {
  const arg = (name, dflt) => { const i = process.argv.indexOf(name); return i > -1 && process.argv[i + 1] ? process.argv[i + 1] : dflt; };
  const host = arg('--host', process.env.E3D_MCP_HOST || '127.0.0.1');
  const port = Number.parseInt(arg('--port', process.env.E3D_MCP_PORT || process.env.PORT || '8787'), 10);
  let server;
  let hook = null;
  let runServer = null;
  try {
    if (RUN_SERVER.enabled && !AUTH_HOOK) throw new Error(`refusing to start: ${RUN_SERVER.errors.join('; ') || 'the internal run listener needs E3D_MCP_AUTH_URL'}`);
    if (AUTH_HOOK) hook = await startAuthHook();
    server = await startHttpServer({ host, port, log, handle, newConn: newHttpConn, version: SERVER_INFO.version,
      ...(hook ? { auth: hook.external, readiness: hook.readiness.state } : {}) });
    // a separate loopback-only listener; the public one above never serves /internal/*
    if (hook && RUN_SERVER.enabled) {
      runServer = await startRunServer({ port: RUN_SERVER.config.port, token: RUN_SERVER.config.token, failsPerMin: RUN_SERVER.config.failsPerMin,
        runs, external: hook.external, plan: planWebRun, log, pricing: { mode: PRICING_CONFIG.mode, customer: runsConfig.customer, search: searchCapable(process.env, { mode: PRICING_CONFIG.mode }) } });
    }
  } catch (e) { process.stderr.write(`[e3d-mcp] ${redact(e.message)}\n`); process.exit(2); }
  if (process.env.E3D_MCP_PORT_FILE) await writeFile(process.env.E3D_MCP_PORT_FILE, String(server.port));
  if (runServer && process.env.E3D_MCP_RUN_PORT_FILE) await writeFile(process.env.E3D_MCP_RUN_PORT_FILE, String(runServer.port));
  let stopping = false;
  const stop = async () => { if (stopping) return; stopping = true; log('shutting down'); setTimeout(() => process.exit(0), 10000).unref(); hook?.readiness.stop(); hook?.outbox.stop(); runs?.stop(); await runServer?.close(); await server.close(); await sampling.stop(); process.exit(0); };
  process.on('SIGTERM', stop);
  process.on('SIGINT', stop);
  log(`ready (hosted; agent contract: ${AGENT_ON ? 'on' : 'off'}; limits: ${JSON.stringify(LIMITS)}; allowed providers: ${PANEL_CONFIG.allowed ? PANEL_CONFIG.allowed.join(',') : 'any available'}; account panels: ${panelClient ? 'on' : 'off'}${REQUIRED.length ? `; required providers: ${REQUIRED.join(',')}` : ''})`);
} else {
  const rl = createInterface({ input: process.stdin });
  const pending = new Set();
  rl.on('line', (line) => {
    if (!line.trim()) return;
    let msg;
    try { msg = JSON.parse(line); }
    catch { return send({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'parse error' } }); }
    if (rpc.handleResponse(msg)) return; // an answer to a request this server made (roots/list, ...)
    const p = handle(msg).catch((e) => log('handler error:', e.stack || e)).finally(() => pending.delete(p));
    pending.add(p);
  });
  // Exit only once in-flight calls finish, so a client closing stdin after its last request still gets the reply.
  rl.on('close', () => Promise.allSettled([...pending]).then(() => sampling.stop()).then(() => process.exit(0)));
  log(`ready (limits: ${JSON.stringify(LIMITS)})`);
}
