#!/usr/bin/env node
// e3d-mcp: Model Context Protocol server (stdio) exposing e3d-pilot to any MCP
// client -- GitHub Copilot (VS Code agent mode, coding agent), Claude Code, Cursor, etc.
//
// Zero dependencies on purpose: MCP over stdio is newline-delimited JSON-RPC 2.0,
// small enough to speak directly, so `npx`/clone-and-run needs no install step.
//
// Tools:
//   e3d_debate          multi-model debate -> decisive answer + consensus + named dissent
//   e3d_list_providers  which model providers are configured on this machine
//   e3d_provenance_trace / e3d_ideas_list   read-only "why does this exist?" queries
//
// Debate cost guard: every debate spends the *server operator's* model credits, so
// rounds/providers/concurrency are capped (E3D_MCP_MAX_ROUNDS, E3D_MCP_MAX_PROVIDERS,
// E3D_MCP_MAX_CONCURRENT, E3D_MCP_TIMEOUT_SEC). Nothing here writes to a repo.

import { mkdtemp, writeFile, readFile, rm, stat } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { createInterface } from 'node:readline';
import { ROOT, log, text, run, configuredProviders, providerLine, NAME_RE } from '../lib/mcp/util.js';
import { redact } from '../lib/mcp/redact.js';
import { doctor, checkoutConfigHint } from '../lib/mcp/doctor.js';
import { createRpc } from '../lib/mcp/rpc.js';
import { createRepoGuard } from '../lib/mcp/repos.js';
import { createJobs } from '../lib/mcp/jobs.js';
import { createPipelineTools } from '../lib/mcp/pipeline-tools.js';
import { createPipelineActions } from '../lib/mcp/pipeline-actions.js';
import { createSampling } from '../lib/mcp/sampling.js';
import { chooseVoices, independence, isSampling } from '../lib/mcp/voices.js';
import { startHttpServer } from '../lib/mcp/http.js';
import { createUsage, usageFromTranscript, worstCase, usageTool, usageHandler } from '../lib/mcp/usage.js';

const HTTP_MODE = process.argv.includes('--http');
const SERVER_INFO = { name: 'e3d-pilot', version: '0.2.0' };
const SUPPORTED_PROTOCOLS = ['2025-06-18', '2025-03-26', '2024-11-05'];

const envInt = (name, dflt) => {
  const n = Number.parseInt(process.env[name] ?? '', 10);
  return Number.isFinite(n) && n > 0 ? n : dflt;
};
const LIMITS = {
  rounds: envInt('E3D_MCP_MAX_ROUNDS', 3),
  providers: envInt('E3D_MCP_MAX_PROVIDERS', 4),
  concurrent: envInt('E3D_MCP_MAX_CONCURRENT', 2),
  // Hosted: stay under typical load-balancer idle timeouts unless the operator says otherwise.
  timeoutMs: envInt('E3D_MCP_TIMEOUT_SEC', HTTP_MODE ? 120 : 900) * 1000,
  maxWords: 600,
  questionChars: 20000,
};
let activeDebates = 0;

const send = (msg) => process.stdout.write(`${JSON.stringify(msg)}\n`);
// quick = one round of independent answers + one synthesis call (fast, no cross-critique);
// thorough = the debate as originally shipped (2 rounds, models see and rebut each other).
const MODES = { quick: { rounds: 1, maxWords: 80 }, thorough: { rounds: 2, maxWords: 200 } };

// e3d-debate prints "FINAL ANSWER: ...\nCONSENSUS: ...\nDISSENT: ..." -- turn that into fields.
function parseVerdict(out) {
  const raw = out.match(/FINAL ANSWER:[\s\S]*$/)?.[0]?.trim();
  if (!raw) return null;
  const m = raw.match(/^FINAL ANSWER:\s*([\s\S]*?)\s*\n\s*CONSENSUS:\s*([^\n]*)\n\s*DISSENT:\s*([\s\S]*)$/);
  if (!m) return { final_answer: raw.replace(/^FINAL ANSWER:\s*/, ''), consensus: 'unknown', dissent: { present: null, summary: 'Verdict could not be parsed; read the answer text in full.' } };
  const consensus = ['full', 'majority', 'split'].find((c) => m[2].toLowerCase().includes(c)) ?? 'unknown';
  const dissentText = m[3].trim();
  const none = /^["'`]*none[."'`]*$/i.test(dissentText);
  return { final_answer: m[1].trim(), consensus, dissent: { present: !none, summary: none ? 'none' : dissentText } };
}

// Each model's answer in the last round, from transcript.md ("## Round N -- provider").
function parsePositions(transcript) {
  const sections = transcript.split(/\n(?=## )/).map((c) => c.match(/^## Round (\d+) -- (\S+)\n\n([\s\S]*)$/)).filter(Boolean)
    .map((m) => ({ round: Number(m[1]), provider: m[2], body: m[3].trim() }));
  const last = Math.max(0, ...sections.map((x) => x.round));
  return {
    roundsRan: last,
    positions: sections.filter((x) => x.round === last).map((x) => ({
      provider: x.provider,
      text: x.body.replace(/\n*status: (approved|revise)\s*$/i, '').replace(/\n*POSITION:[^\n]*$/, '').trim(),
    })),
  };
}

function renderDebate(d) {
  const label = d.consensus === 'full' ? 'FULL CONSENSUS' : d.consensus === 'majority' ? 'MAJORITY (some dissent)' : d.consensus === 'split' ? 'SPLIT' : 'CONSENSUS UNKNOWN';
  const lines = [
    `# Debate verdict: ${label}`,
    `_${d.providers.join(', ')} | ${d.mode} mode | ${d.rounds_ran} round${d.rounds_ran === 1 ? '' : 's'}_`,
    '', `**Answer:** ${d.final_answer}`, '',
  ];
  for (const w of d.warnings ?? []) lines.push(`**WARNING:** ${w}`, '');
  if (d.models?.length) lines.push(`_Models that answered: ${d.models.map((m) => `${m.provider} = ${m.model}`).join('; ')}_`, '');
  if (d.dissent.present === false) lines.push('**Dissent:** none', '');
  else lines.push(`**Dissent (report this to the user, do not drop it when summarizing):** ${d.dissent.summary}`, '');
  if (d.positions.length) {
    lines.push('**Each model\'s final position:**');
    for (const p of d.positions) lines.push('', `**${p.provider}:**`, ...p.text.split('\n').map((l) => `> ${l}`));
  }
  if (d.transcript) lines.push('', '<details><summary>Full transcript</summary>', '', d.transcript, '', '</details>');
  return lines.join('\n');
}

async function toolDebate(args, progress, ctx) {
  const question = typeof args.question === 'string' ? args.question.trim() : '';
  if (!question) return text('error: `question` is required', true);
  if (question.length > LIMITS.questionChars) return text(`error: question exceeds ${LIMITS.questionChars} characters`, true);

  const mode = args.mode ?? 'quick';
  if (!MODES[mode]) return text('error: mode must be "quick" or "thorough"', true);
  const rounds = args.rounds ?? MODES[mode].rounds;
  if (!Number.isInteger(rounds) || rounds < 1 || rounds > LIMITS.rounds) return text(`error: rounds must be an integer 1..${LIMITS.rounds}`, true);
  const maxWords = args.max_words ?? MODES[mode].maxWords;
  if (!Number.isInteger(maxWords) || maxWords < 20 || maxWords > LIMITS.maxWords) return text(`error: max_words must be an integer 20..${LIMITS.maxWords}`, true);
  if (args.include_transcript !== undefined && typeof args.include_transcript !== 'boolean') return text('error: include_transcript must be a boolean', true);

  // E3D_MCP_DEBATE_BIN swaps in another debate executable (used by tests); provider checks are then that binary's job.
  const debateBin = process.env.E3D_MCP_DEBATE_BIN || join(ROOT, 'bin/e3d-debate');
  const stubbed = Boolean(process.env.E3D_MCP_DEBATE_BIN);
  const known = stubbed ? [] : await configuredProviders();
  const samplingOn = sampling.available(ctx?.session);
  let providers = args.providers;
  let synthesizer;
  let selection = 'explicit';
  let selectionNote = 'chosen by the caller';
  if (providers === undefined) {
    if (stubbed) { providers = ['claude', 'codex']; selection = 'auto'; selectionNote = 'test stub'; }
    else {
      // Default: the client's own models (MCP sampling, e.g. Copilot) plus any model CLIs detected here.
      const pick = chooseVoices({ known, samplingOn });
      ({ providers, synthesizer, selection } = pick);
      selectionNote = pick.note;
    }
  }
  if (!Array.isArray(providers) || providers.some((p) => typeof p !== 'string' || !NAME_RE.test(p))) return text('error: providers must be an array of provider names', true);
  providers = [...new Set(providers)];
  if (providers.length < 2) return text('error: need at least 2 available providers to debate (call e3d_list_providers); only found: ' + (providers.join(', ') || 'none'), true);
  if (providers.length > LIMITS.providers) return text(`error: at most ${LIMITS.providers} providers per debate`, true);
  const unavailable = stubbed ? [] : providers.filter((p) => (isSampling(p) ? !samplingOn : !known.find((k) => k.name === p && k.available)));
  if (unavailable.length) {
    const sampled = unavailable.filter(isSampling);
    return text(`error: provider(s) not available here: ${unavailable.join(', ')}${sampled.length ? ' (mcp-sampling needs an MCP client that supports sampling, such as Copilot in VS Code)' : ''}`, true);
  }
  const claudeUp = stubbed || known.some((k) => k.name === 'claude' && k.available);
  if (synthesizer === undefined) synthesizer = samplingOn && providers.includes('mcp-sampling') ? 'mcp-sampling' : (claudeUp ? 'claude' : providers[0]);

  // Refuse BEFORE spending if the worst case for this request would break today's cap.
  const principal = ctx?.principal ?? 'local';
  const worst = worstCase({ providers: providers.length, rounds, maxWords, questionChars: question.length });
  const allowed = await usage.check(principal, worst);
  if (!allowed.ok) return text(`error: daily budget: ${allowed.reason}`, true);

  if (activeDebates >= LIMITS.concurrent) return text(`error: ${LIMITS.concurrent} debates already running; retry shortly`, true);
  activeDebates++;
  const dir = await mkdtemp(join(tmpdir(), 'e3d-mcp-'));
  try {
    const qfile = join(dir, 'question.md');
    await writeFile(qfile, question);
    const cliArgs = ['--question-file', qfile, '--providers', providers.join(','), '--rounds', String(rounds),
      '--max-words', String(maxWords), '--out-dir', join(dir, 'out'), ...(synthesizer !== 'claude' ? ['--synthesizer', synthesizer] : [])];
    let step = 0;
    const tag = `debate-${Date.now().toString(36)}-${Math.random().toString(16).slice(2, 8)}`;
    const usesSampling = providers.some(isSampling) || isSampling(synthesizer);
    const samplingEnv = usesSampling ? await sampling.env(ctx.session, { tag, maxTokens: Math.min(Math.max(maxWords * 3, 300), 4000) }) : {};
    const r = await run(debateBin, cliArgs, {
      timeoutMs: LIMITS.timeoutMs,
      env: { ...process.env, ...samplingEnv },
      onStderr: (s) => { for (const m of s.matchAll(/^=== (.+?) ===$/gm)) progress?.(++step, m[1]); },
    });
    // Calls that actually ran are counted from the transcript, whether or not the debate succeeded.
    const transcript = await readFile(join(dir, 'out', 'transcript.md'), 'utf8').catch(() => '');
    const spent = usageFromTranscript(transcript, question);
    const budget = spent.calls > 0 ? await usage.record(principal, spent) : await usage.snapshot(principal);
    if (r.timedOut) return text(`error: debate timed out after ${LIMITS.timeoutMs / 1000}s`, true);
    const verdict = parseVerdict(r.out);
    if (r.code !== 0 || !verdict) return text(`error: debate failed (exit ${r.code})\n${redact(r.err.slice(-1500))}`, true);

    const { roundsRan, positions } = parsePositions(transcript);
    const samplingModels = sampling.drain(tag).map((m) => ({ provider: m.voice === 'b' ? 'mcp-sampling-b' : 'mcp-sampling', model: m.model, hint: m.hint }));
    const indep = usesSampling ? independence(providers, samplingModels) : { independent: true, warnings: [] };
    const result = {
      ...verdict,
      mode, providers, rounds_requested: rounds, rounds_ran: roundsRan || rounds,
      selection, selection_note: selectionNote, synthesizer,
      ...(samplingModels.length ? { models: samplingModels } : {}),
      independent: indep.independent, warnings: indep.warnings,
      usage: { model_calls: spent.calls, est_input_tokens: spent.inTokens, est_output_tokens: spent.outTokens, estimate: true },
      budget,
      positions,
      ...(args.include_transcript ? { transcript: transcript.trim() } : {}),
    };
    return { content: [{ type: 'text', text: renderDebate(result) }], structuredContent: result };
  } finally {
    activeDebates--;
    rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

async function toolListProviders(_args, _progress, ctx) {
  const known = await configuredProviders();
  const samplingOn = sampling.available(ctx?.session);
  const lines = known.map(providerLine);
  if (samplingOn) {
    lines.push("mcp-sampling: available (this client's own models via MCP sampling, e.g. Copilot in VS Code)");
    lines.push('mcp-sampling-b: available (a second model family from the same client, if it allows one)');
  }
  const pick = chooseVoices({ known, samplingOn });
  lines.push('', `Default voices for e3d_debate: ${pick.providers.join(', ') || 'none'} (${pick.note})`);
  return text(lines.join('\n') || 'no providers found');
}

async function requireRepo(path) {
  if (typeof path !== 'string' || !path) throw new Error('`repo` (absolute path to a repo using e3d-pilot) is required');
  const abs = resolve(path);
  try { if (!(await stat(join(abs, '.e3d-pilot'))).isDirectory()) throw 0; }
  catch { throw new Error(`${abs} has no .e3d-pilot directory -- not an e3d-pilot repo`); }
  return abs;
}

async function toolProvenanceTrace(args) {
  const repo = await requireRepo(args.repo);
  if (typeof args.idea_id !== 'string' || !/^idea-[A-Za-z0-9]+$/.test(args.idea_id)) return text('error: idea_id must look like idea-<hex>', true);
  const r = await run(join(ROOT, 'bin/e3d-pilot'), ['provenance', 'trace', '--repo', repo, args.idea_id, '--json']);
  return r.code === 0 ? text(r.out) : text(`error: ${r.err || r.out}`, true);
}

async function toolIdeasList(args) {
  const repo = await requireRepo(args.repo);
  const cli = ['ideas', 'list', '--repo', repo, '--json'];
  if (args.status !== undefined) {
    if (typeof args.status !== 'string' || !NAME_RE.test(args.status)) return text('error: invalid status', true);
    cli.push('--status', args.status);
  }
  const r = await run(join(ROOT, 'bin/e3d-pilot'), cli);
  if (r.code !== 0) return text(`error: ${r.err || r.out}`, true);
  // Raw idea records carry full notes/provenance (hundreds of KB per repo); return a compact index.
  const ideas = JSON.parse(r.out);
  const limit = 50;
  const rows = ideas.slice(0, limit).map((i) => ({
    idea_id: i.idea_id, status: i.status, title: i.title, category: i.category,
    updated_at: i.updated_at, last_decision_at: i.last_decision_at,
  }));
  return text(JSON.stringify({ total: ideas.length, shown: rows.length, ideas: rows }, null, 2));
}

const TOOLS = [
  {
    name: 'e3d_debate',
    description: 'Get a multi-model second opinion on a decision or design question. Independent AI models answer, and a synthesizer returns a final answer, a consensus level (full/majority/split), and any dissent, plus each model\'s final position. ALWAYS report the dissent and consensus level to the user -- the disagreement is the point; never present a split verdict as settled. Write a self-contained question: the models cannot see your code. mode "quick" (default): one round, usually well under a minute. mode "thorough": models also critique each other, a few minutes. Use for architectural choices, tradeoffs, and contestable judgment calls -- not for lookups or questions with an obvious answer. Spends the user\'s model credits.',
    inputSchema: {
      type: 'object',
      properties: {
        question: { type: 'string', description: 'The decision or question, with enough context for models that cannot see your code.' },
        mode: { type: 'string', enum: ['quick', 'thorough'], description: 'quick (default): 1 round, short answers, no cross-critique. thorough: 2 rounds where models see and rebut each other.' },
        providers: { type: 'array', items: { type: 'string' }, description: 'Provider names (see e3d_list_providers). Default: the client\'s own models via MCP sampling (e.g. Copilot) plus detected model CLIs; without sampling, claude + codex.' },
        rounds: { type: 'integer', minimum: 1, maximum: LIMITS.rounds, description: 'Override the mode\'s round count. Stops early on convergence.' },
        max_words: { type: 'integer', minimum: 20, maximum: LIMITS.maxWords, description: 'Override the mode\'s per-provider per-round answer cap.' },
        include_transcript: { type: 'boolean', description: 'Also return the full transcript (large). Default false.' },
      },
      required: ['question'],
      additionalProperties: false,
    },
    outputSchema: {
      type: 'object',
      properties: {
        final_answer: { type: 'string' },
        consensus: { type: 'string', enum: ['full', 'majority', 'split', 'unknown'] },
        dissent: {
          type: 'object',
          properties: { present: { type: ['boolean', 'null'] }, summary: { type: 'string', description: '"none" when there is no dissent.' } },
          required: ['present', 'summary'],
        },
        positions: { type: 'array', items: { type: 'object', properties: { provider: { type: 'string' }, text: { type: 'string' } }, required: ['provider', 'text'] } },
        mode: { type: 'string' },
        providers: { type: 'array', items: { type: 'string' } },
        rounds_requested: { type: 'integer' },
        rounds_ran: { type: 'integer' },
        selection: { type: 'string', enum: ['auto', 'pinned', 'explicit'], description: 'How the participating models were chosen.' },
        selection_note: { type: 'string' },
        synthesizer: { type: 'string' },
        models: { type: 'array', items: { type: 'object', properties: { provider: { type: 'string' }, model: { type: 'string' }, hint: { type: ['string', 'null'] } } }, description: 'Which models actually answered through MCP sampling.' },
        independent: { type: 'boolean', description: 'false when every voice resolved to the same model.' },
        warnings: { type: 'array', items: { type: 'string' } },
        transcript: { type: 'string' },
      },
      required: ['final_answer', 'consensus', 'dissent', 'positions', 'mode', 'providers', 'rounds_ran'],
    },
    annotations: { title: 'Multi-model debate', readOnlyHint: true, openWorldHint: true, idempotentHint: false },
  },
  {
    name: 'e3d_list_providers',
    description: 'List the model providers configured on this machine and whether each is available to join a debate.',
    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
    annotations: { title: 'List debate providers', readOnlyHint: true, openWorldHint: false },
  },
  {
    name: 'e3d_provenance_trace',
    description: 'Trace why a change exists: for an e3d-pilot idea, return its lineage -- origin, debates and decisions (with dissent), approvals, execution, review, outcome. Read-only.',
    inputSchema: {
      type: 'object',
      properties: {
        repo: { type: 'string', description: 'Absolute path to a repo managed by e3d-pilot (has .e3d-pilot/).' },
        idea_id: { type: 'string', description: 'Idea id, e.g. idea-a785c206642b.' },
      },
      required: ['repo', 'idea_id'],
      additionalProperties: false,
    },
