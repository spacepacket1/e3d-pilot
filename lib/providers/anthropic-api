#!/usr/bin/env bash
set -euo pipefail

# Anthropic Messages API provider (curl + jq; no SDK, no `claude` CLI needed), for servers and containers.
#   ANTHROPIC_API_KEY        or ANTHROPIC_API_KEY_FILE (a file holding the key, or an `export ANTHROPIC_API_KEY=...` line)
#   ANTHROPIC_API_MODEL      default claude-sonnet-5-5
#   ANTHROPIC_API_THINKING   optional; default "between_tools" (thinking off) for Claude 5 models, nothing for others; empty sends nothing
#   ANTHROPIC_API_MAX_TOKENS default 4096
#   ANTHROPIC_API_BASE_URL   default https://api.anthropic.com
# The key is sent from a 0600 header file, never on the command line, and is never printed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./common.sh
source "$SCRIPT_DIR/common.sh"
# shellcheck source=./websearch.sh
source "$SCRIPT_DIR/websearch.sh"

ANTHROPIC_API_MODEL="${ANTHROPIC_API_MODEL:-claude-sonnet-5-5}"
ANTHROPIC_API_BASE_URL="${ANTHROPIC_API_BASE_URL:-https://api.anthropic.com}"
PROVIDER_TOKEN_LIMIT="${E3D_PILOT_PROVIDER_TOKEN_LIMIT:-200000}"

anthropic_key() {
  if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then printf '%s' "$ANTHROPIC_API_KEY"
  else provider_key_from_file "${ANTHROPIC_API_KEY_FILE:-}" ANTHROPIC_API_KEY
  fi
}

if [[ "${E3D_PILOT_CHECK:-0}" == "1" ]]; then
  if ! provider_binary_available curl || ! provider_binary_available jq; then
    printf 'unavailable: curl and jq are required\n'
    exit "$PROVIDER_EXIT_UNAVAILABLE"
  fi
  if [[ -z "$(anthropic_key)" ]]; then
    printf 'unavailable: set ANTHROPIC_API_KEY (or ANTHROPIC_API_KEY_FILE)\n'
    exit "$PROVIDER_EXIT_UNAVAILABLE"
  fi
  # Reachability only: no key is sent and nothing is billed.
  if curl -s -o /dev/null -m "${ANTHROPIC_API_CHECK_TIMEOUT:-3}" "${ANTHROPIC_API_BASE_URL%/}"; then
    printf 'available (%s)\n' "$ANTHROPIC_API_MODEL"
    exit "$PROVIDER_EXIT_OK"
  fi
  printf 'unavailable: API not reachable (%s)\n' "${ANTHROPIC_API_BASE_URL%/}"
  exit "$PROVIDER_EXIT_UNAVAILABLE"
fi

if [[ -z "$(anthropic_key)" ]]; then
  echo "error: anthropic-api is not configured (ANTHROPIC_API_KEY or ANTHROPIC_API_KEY_FILE)" >&2
  exit "$PROVIDER_EXIT_UNAVAILABLE"
fi

# Claude 5 models think before answering by default, and thinking tokens count against max_tokens: at a small cap the whole
# budget can go to thinking and the response holds no text. "between_tools" is how those models turn thinking off.
# ANTHROPIC_API_THINKING overrides it (set it empty to send nothing, e.g. for an older model).
if [[ -n "${ANTHROPIC_API_THINKING+x}" ]]; then ANTHROPIC_THINKING="$ANTHROPIC_API_THINKING"
elif [[ "$ANTHROPIC_API_MODEL" =~ ^claude-[a-z]+-5 ]]; then ANTHROPIC_THINKING="between_tools"
else ANTHROPIC_THINKING=""; fi

PROMPT_FILE="${1:-}"
provider_require_prompt_file "$PROMPT_FILE"

URL="${ANTHROPIC_API_BASE_URL%/}/v1/messages"

if [[ "${E3D_PILOT_DRY_RUN:-0}" == "1" ]]; then
  printf 'curl -sS -X POST %q -H %q -H %q -H %q -d @- (model=%s) < %q\n' "$URL" 'x-api-key: [redacted]' 'anthropic-version: 2023-06-01' 'content-type: application/json' "$ANTHROPIC_API_MODEL" "$PROMPT_FILE"
  exit "$PROVIDER_EXIT_OK"
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/e3d-pilot-anthropic.XXXXXX")"
trap 'rm -rf "$work"' EXIT
chmod 700 "$work"
( umask 077; printf 'x-api-key: %s\nanthropic-version: 2023-06-01\ncontent-type: application/json\n' "$(anthropic_key)" > "$work/headers" )

if ws_enabled; then
  # Web search (lib/providers/websearch.sh; docs/web-search-providers.md). The basic tool web_search_20250305 only: the
  # 20260209+ versions run search from inside code execution, which would add a second tool. The tool list is exactly one
  # tool; max_uses is the cap; one domain list natively (allow wins), the other is post-filtered by e3d-debate.
  ws_settings || ws_fail anthropic-api invalid_domain_config
  jq -n --rawfile content "$PROMPT_FILE" --arg model "$ANTHROPIC_API_MODEL" --arg max "${ANTHROPIC_API_MAX_TOKENS:-4096}" \
    --arg think "$ANTHROPIC_THINKING" --arg sys "$WS_SYSTEM_TEXT" --argjson uses "$WS_MAX" --argjson allow "$WS_ALLOW" --argjson deny "$WS_DENY" \
    '{model: $model, max_tokens: ($max | tonumber), system: $sys, messages: [{role: "user", content: $content}],
      tools: [{type: "web_search_20250305", name: "web_search", max_uses: $uses}
        + (if ($allow | length) > 0 then {allowed_domains: $allow} elif ($deny | length) > 0 then {blocked_domains: $deny} else {} end)]}
      + (if $think != "" then {thinking: {type: $think}} else {} end)' > "$work/payload.json"
  max_continuations="${ANTHROPIC_API_MAX_PAUSE_CONTINUATIONS:-2}"
  [[ "$max_continuations" =~ ^[0-9]+$ ]] && (( max_continuations <= 5 )) || max_continuations=2
  # per-token pricing: one call is one request, so a paused turn is never continued (the continuation would be a second billed request)
  ws_per_token && max_continuations=0
  # the usage line of everything received so far: input_tokens counts every billed class and the search results as the vendor reports them
  anth_usage_json() {
    jq -sc --arg m "$ANTHROPIC_API_MODEL" '{provider:"anthropic-api",model:(.[-1].model // $m),tokens:(map((.usage.input_tokens // 0) + (.usage.output_tokens // 0)) | add),searches:(map(.usage.server_tool_use.web_search_requests // ([.content[]? | select(.type == "server_tool_use" and .name == "web_search")] | length)) | add)}
      + (if all(.[]; (.usage.input_tokens | type) == "number" and (.usage.output_tokens | type) == "number")
         then {input_tokens: (map(.usage.input_tokens + (.usage.cache_creation_input_tokens // 0) + (.usage.cache_read_input_tokens // 0)) | add), output_tokens: (map(.usage.output_tokens) | add)}
         else {input_tokens: null, output_tokens: null} end)' "$work/all.jsonl"
  }
  : > "$work/all.jsonl"
  attempt=0
  while :; do
    set +e
    http_code="$(curl -sS -m "$(ws_remaining)" -o "$work/response.json" -w '%{http_code}' \
      -H "@$work/headers" -d "@$work/payload.json" "$URL" 2> "$work/curl.err")"
    status=$?
    set -e
    (( status == 28 )) && ws_fail anthropic-api timeout
    (( status != 0 )) && ws_fail anthropic-api request_failed "curl exit $status"
    if [[ "$http_code" != 2* ]]; then
      msg="$(jq -r '.error.message // empty' "$work/response.json" 2>/dev/null | head -c 200)"
      # an organization with web search disabled gets a 400 invalid_request_error that says so
      if [[ "$http_code" == 400 ]] && grep -qi 'web search' <<< "$msg"; then ws_fail anthropic-api search_disabled "$msg"; fi
      ws_fail anthropic-api "http_$http_code" "$msg"
    fi
    jq -c . "$work/response.json" >> "$work/all.jsonl" || ws_fail anthropic-api bad_response
    WS_USAGE_JSON="$(anth_usage_json)"
    # Only these blocks may appear: anything else (code execution, client tool use) means another tool ran. Fail closed.
    bad="$(jq -r '[.content[]? | .type as $t | select(($t | IN("text","thinking","redacted_thinking","server_tool_use","web_search_tool_result")) | not) | $t]
      + [.content[]? | select(.type == "server_tool_use" and .name != "web_search") | "server_tool_use:" + (.name // "?")] | unique | join(",")' "$work/response.json")"
    [[ -z "$bad" ]] || ws_fail anthropic-api unexpected_tool "$bad"
    # A search error arrives inside a 200 as web_search_tool_result_error. max_uses_exceeded is the cap working; any other code fails closed.
    serr="$(jq -r '[.content[]? | select(.type == "web_search_tool_result") | .content | select(type == "object" and .type == "web_search_tool_result_error") | .error_code // "unknown"] | map(select(. != "max_uses_exceeded")) | first // empty' "$work/response.json")"
    [[ -z "$serr" ]] || ws_fail anthropic-api "search_error_$serr"
    [[ "$(jq -r '.stop_reason // empty' "$work/response.json")" == "pause_turn" ]] || break
    # per-token: whatever text came back is the answer (none: no_text below); never a second request
    ws_per_token && break
    # pause_turn: send the paused assistant content back unchanged (same tools), a bounded number of times.
    (( attempt >= max_continuations )) && ws_fail anthropic-api pause_turn_limit
    attempt=$((attempt + 1))
    jq -c --slurpfile r "$work/response.json" '.messages += [{role: "assistant", content: $r[0].content}]' "$work/payload.json" > "$work/payload.next" && mv "$work/payload.next" "$work/payload.json"
  done
  content="$(jq -rs '[.[].content[]? | select(.type == "text") | .text] | join("")' "$work/all.jsonl")"
  [[ -n "$content" ]] || ws_fail anthropic-api no_text
  # Measured (docs/seat-reliability.md): with the search tool on, the model thinks again after the search results, and at a small max_tokens all of
  # the budget can go to that thinking. The response then ends at max_tokens with only the sentence written BEFORE the search ("I'll check the
  # current release.") as text. That sentence is not an answer: it counts as no text (so it is retried, then asked without search), never returned.
  if [[ "$(jq -r '.stop_reason // empty' "$work/response.json")" == "max_tokens" ]] \
    && jq -e '[.content[]?] as $c | ([$c | to_entries[] | select(.value.type == "web_search_tool_result") | .key] | max) as $last
      | $last != null and (([$c[($last + 1):][] | select(.type == "text") | .text] | join("")) == "")' "$work/response.json" > /dev/null 2>&1; then
    ws_fail anthropic-api no_text "stopped at max_tokens after the search, before an answer"
  fi
  tokens="$(jq -s 'map((.usage.input_tokens // 0) + (.usage.output_tokens // 0)) | add' "$work/all.jsonl")"
  searches="$(jq -s 'map(.usage.server_tool_use.web_search_requests // 0) | add' "$work/all.jsonl")"
  # cited locations first (with the vendor's excerpt, at most 150 characters, truncated again to our cap), then results seen
  cites="$(jq -sc --argjson n "$WS_EXCERPT" '[.[].content[]? | select(.type == "text") | .citations[]? | select(.type == "web_search_result_location") | {url: (.url // ""), title: (.title // ""), excerpt: ((.cited_text // "")[0:$n])}]
    + [.[].content[]? | select(.type == "web_search_tool_result") | .content | select(type == "array") | .[] | select(.type == "web_search_result") | {url: (.url // ""), title: (.title // ""), excerpt: ""}] | .[0:60]' "$work/all.jsonl")"
  ws_record "$searches" "$cites"
  ws_usage_once "$(anth_usage_json)"
  printf '%s\n' "$content"
  if [[ "$PROVIDER_TOKEN_LIMIT" =~ ^[0-9]+$ ]] && (( PROVIDER_TOKEN_LIMIT > 0 && tokens > PROVIDER_TOKEN_LIMIT )); then
    printf 'error: anthropic-api provider token ceiling exceeded (%s > %s)\n' "$tokens" "$PROVIDER_TOKEN_LIMIT" >&2
    exit "$PROVIDER_EXIT_FAILURE"
  fi
  exit "$PROVIDER_EXIT_OK"
fi

jq -n --rawfile content "$PROMPT_FILE" --arg model "$ANTHROPIC_API_MODEL" --arg max "${ANTHROPIC_API_MAX_TOKENS:-4096}" --arg think "$ANTHROPIC_THINKING" \
  '{model: $model, max_tokens: ($max | tonumber), messages: [{role: "user", content: $content}]} + (if $think != "" then {thinking: {type: $think}} else {} end)' > "$work/payload.json"

set +e
http_code="$(curl -sS -m "${ANTHROPIC_API_TIMEOUT:-180}" -o "$work/response.json" -w '%{http_code}' \
  -H "@$work/headers" -d "@$work/payload.json" "$URL" 2> "$work/curl.err")"
status=$?
set -e

if [[ $status -ne 0 ]]; then
  printf 'error: anthropic-api request failed (curl exit %s): %s\n' "$status" "$(head -c 300 "$work/curl.err" | tr '\n' ' ')" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
if [[ "$http_code" != 2* ]]; then
  msg="$(jq -r '.error.message // empty' "$work/response.json" 2>/dev/null | head -c 300)"
  printf 'error: anthropic-api HTTP %s%s\n' "$http_code" "${msg:+: $msg}" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi

# the usage line comes first: a 200 with no text (all output tokens spent on thinking, say) is still billed. input_tokens counts every
# billed input class (cache writes and reads included); output_tokens is the vendor's, thinking included.
printf 'e3d_provider_usage=%s\n' "$(jq -c --arg m "$ANTHROPIC_API_MODEL" '{provider:"anthropic-api",model:(.model // $m),tokens:((.usage.input_tokens // 0) + (.usage.output_tokens // 0)),usage:(.usage // null)}
  + (if (.usage.input_tokens | type) == "number" and (.usage.output_tokens | type) == "number"
     then {input_tokens: (.usage.input_tokens + (.usage.cache_creation_input_tokens // 0) + (.usage.cache_read_input_tokens // 0)), output_tokens: .usage.output_tokens}
     else {input_tokens: null, output_tokens: null} end)' "$work/response.json")" >&2
content="$(jq -r '[.content[]? | select(.type == "text") | .text] | join("")' "$work/response.json")"
if [[ -z "$content" ]]; then
  echo "error: anthropic-api returned no text content" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
tokens="$(jq '((.usage.input_tokens // 0) + (.usage.output_tokens // 0))' "$work/response.json")"
printf '%s\n' "$content"

if [[ "$PROVIDER_TOKEN_LIMIT" =~ ^[0-9]+$ ]] && (( PROVIDER_TOKEN_LIMIT > 0 && tokens > PROVIDER_TOKEN_LIMIT )); then
  printf 'error: anthropic-api provider token ceiling exceeded (%s > %s)\n' "$tokens" "$PROVIDER_TOKEN_LIMIT" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
