#!/usr/bin/env bash
set -euo pipefail

# xAI (Grok) chat-completions provider (curl + jq; no SDK, no `codex` CLI needed), for servers and containers.
#   XAI_API_KEY        or XAI_API_KEY_FILE (a file holding the key, or an `export XAI_API_KEY=...` line)
#   XAI_API_MODEL      required: there is deliberately no default, because valid model names change
#   XAI_API_MAX_TOKENS optional (sent as max_tokens)
#   XAI_API_BASE_URL   default https://api.x.ai/v1 (any OpenAI-compatible endpoint works)
# The key is sent from a 0600 header file, never on the command line, and is never printed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./common.sh
source "$SCRIPT_DIR/common.sh"
# shellcheck source=./websearch.sh
source "$SCRIPT_DIR/websearch.sh"

XAI_API_BASE_URL="${XAI_API_BASE_URL:-https://api.x.ai/v1}"
PROVIDER_TOKEN_LIMIT="${E3D_PILOT_PROVIDER_TOKEN_LIMIT:-200000}"

xai_key() {
  if [[ -n "${XAI_API_KEY:-}" ]]; then printf '%s' "$XAI_API_KEY"
  else provider_key_from_file "${XAI_API_KEY_FILE:-}" XAI_API_KEY
  fi
}

if [[ "${E3D_PILOT_CHECK:-0}" == "1" ]]; then
  if ! provider_binary_available curl || ! provider_binary_available jq; then
    printf 'unavailable: curl and jq are required\n'
    exit "$PROVIDER_EXIT_UNAVAILABLE"
  fi
  if [[ -z "$(xai_key)" ]]; then
    printf 'unavailable: set XAI_API_KEY (or XAI_API_KEY_FILE)\n'
    exit "$PROVIDER_EXIT_UNAVAILABLE"
  fi
  if [[ -z "${XAI_API_MODEL:-}" ]]; then
    printf 'unavailable: set XAI_API_MODEL (no default: model names change)\n'
    exit "$PROVIDER_EXIT_UNAVAILABLE"
  fi
  # Reachability only: no key is sent and nothing is billed.
  if curl -s -o /dev/null -m "${XAI_API_CHECK_TIMEOUT:-3}" "${XAI_API_BASE_URL%/}"; then
    printf 'available (%s)\n' "$XAI_API_MODEL"
    exit "$PROVIDER_EXIT_OK"
  fi
  printf 'unavailable: API not reachable (%s)\n' "${XAI_API_BASE_URL%/}"
  exit "$PROVIDER_EXIT_UNAVAILABLE"
fi

if [[ -z "$(xai_key)" || -z "${XAI_API_MODEL:-}" ]]; then
  echo "error: xai-api is not configured (XAI_API_KEY or XAI_API_KEY_FILE, and XAI_API_MODEL)" >&2
  exit "$PROVIDER_EXIT_UNAVAILABLE"
fi

PROMPT_FILE="${1:-}"
provider_require_prompt_file "$PROMPT_FILE"

URL="${XAI_API_BASE_URL%/}/chat/completions"

if [[ "${E3D_PILOT_DRY_RUN:-0}" == "1" ]]; then
  printf 'curl -sS -X POST %q -H %q -H %q -d @- (model=%s) < %q\n' "$URL" 'Authorization: Bearer [redacted]' 'Content-Type: application/json' "$XAI_API_MODEL" "$PROMPT_FILE"
  exit "$PROVIDER_EXIT_OK"
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/e3d-pilot-xai-api.XXXXXX")"
trap 'rm -rf "$work"' EXIT
chmod 700 "$work"
( umask 077; printf 'Authorization: Bearer %s\nContent-Type: application/json\n' "$(xai_key)" > "$work/headers" )

if ws_enabled; then
  # Web search (lib/providers/websearch.sh; docs/web-search-providers.md): the Responses API with exactly one tool,
  # web_search, image understanding and image search off. xAI documents no per-call search cap: max_turns (the limit on
  # server-side tool-calling turns) is the closest control, and the count is checked after the fact. One domain list of at
  # most 5 natively (allow wins); anything else is post-filtered by e3d-debate.
  # a search call always has an output ceiling (8192 unless XAI_API_MAX_TOKENS says otherwise)
  ws_settings || ws_fail xai-api invalid_domain_config
  WS_MODEL="$XAI_API_MODEL"
  jq -n --rawfile content "$PROMPT_FILE" --arg model "$XAI_API_MODEL" --arg max "${XAI_API_MAX_TOKENS:-8192}" \
    --arg sys "$WS_SYSTEM_TEXT" --argjson cap "$WS_MAX" --argjson allow "$WS_ALLOW" --argjson deny "$WS_DENY" \
    '{model: $model, input: [{role: "system", content: $sys}, {role: "user", content: $content}], store: false, max_turns: $cap,
      tools: [{type: "web_search", enable_image_understanding: false, enable_image_search: false}
        + (if ($allow | length) > 0 and ($allow | length) <= 5 then {filters: {allowed_domains: $allow}}
           elif ($deny | length) > 0 and ($deny | length) <= 5 then {filters: {excluded_domains: $deny}} else {} end)]}
      + (if $max != "" then {max_output_tokens: ($max | tonumber)} else {} end)' > "$work/payload.json"
  ws_responses_run xai-api "${XAI_API_BASE_URL%/}/responses" "$work"
fi

jq -n --rawfile content "$PROMPT_FILE" --arg model "$XAI_API_MODEL" --arg max "${XAI_API_MAX_TOKENS:-}" \
  '{model: $model, messages: [{role: "user", content: $content}]} + (if $max != "" then {max_tokens: ($max | tonumber)} else {} end)' > "$work/payload.json"

set +e
http_code="$(curl -sS -m "${XAI_API_TIMEOUT:-180}" -o "$work/response.json" -w '%{http_code}' \
  -H "@$work/headers" -d "@$work/payload.json" "$URL" 2> "$work/curl.err")"
status=$?
set -e

if [[ $status -ne 0 ]]; then
  printf 'error: xai-api request failed (curl exit %s): %s\n' "$status" "$(head -c 300 "$work/curl.err" | tr '\n' ' ')" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
if [[ "$http_code" != 2* ]]; then
  msg="$(jq -r '.error.message // empty' "$work/response.json" 2>/dev/null | head -c 300)"
  printf 'error: xai-api HTTP %s%s\n' "$http_code" "${msg:+: $msg}" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi

content="$(jq -r '.choices[0].message.content // empty' "$work/response.json")"
if [[ -z "$content" ]]; then
  echo "error: xai-api returned no message content" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
tokens="$(jq '.usage.total_tokens // 0' "$work/response.json")"
printf 'e3d_provider_usage=%s\n' "$(jq -c --arg m "$XAI_API_MODEL" '{provider:"xai-api",model:(.model // $m),tokens:(.usage.total_tokens // null),usage:(.usage // null)}' "$work/response.json")" >&2
printf '%s\n' "$content"

if [[ "$PROVIDER_TOKEN_LIMIT" =~ ^[0-9]+$ ]] && (( PROVIDER_TOKEN_LIMIT > 0 && tokens > PROVIDER_TOKEN_LIMIT )); then
  printf 'error: xai-api provider token ceiling exceeded (%s > %s)\n' "$tokens" "$PROVIDER_TOKEN_LIMIT" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi
