#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./common.sh
source "$SCRIPT_DIR/common.sh"

DEVIN_BIN="${DEVIN_BIN:-devin}"
DEVIN_MODEL="${DEVIN_MODEL:-claude-sonnet-4-6-thinking-1m}"
DEVIN_PERMISSION_MODE="${DEVIN_PERMISSION_MODE:-auto}"

if [[ "${E3D_PILOT_CHECK:-0}" == "1" ]]; then
  if provider_binary_available "$DEVIN_BIN"; then
    printf 'available (%s)\n' "$DEVIN_BIN"
    exit "$PROVIDER_EXIT_OK"
  fi
  printf 'unavailable: devin binary not found (%s); set DEVIN_BIN to override\n' "$DEVIN_BIN"
  exit "$PROVIDER_EXIT_UNAVAILABLE"
fi

PROMPT_FILE="${1:-}"
provider_require_prompt_file "$PROMPT_FILE"

devin_args=(
  --print
  --model "$DEVIN_MODEL"
  --permission-mode "$DEVIN_PERMISSION_MODE"
  --prompt-file "$PROMPT_FILE"
)

if [[ "${E3D_PILOT_DRY_RUN:-0}" == "1" ]]; then
  printf '%q ' "$DEVIN_BIN" "${devin_args[@]}"
  printf '\n'
  exit "$PROVIDER_EXIT_OK"
fi

if ! provider_binary_available "$DEVIN_BIN"; then
  echo "error: devin binary not found: $DEVIN_BIN" >&2
  exit "$PROVIDER_EXIT_FAILURE"
fi

exec "$DEVIN_BIN" "${devin_args[@]}"
