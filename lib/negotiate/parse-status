#!/usr/bin/env bash
# Parses a single reviewer's raw stdout for the negotiate status contract
# (docs/build-e3d-pilot.md, Phase 2). The three status lines and the fenced
# ```spec replacement block are located by direct regex match anywhere in the
# raw text, whether or not a provider happens to wrap them in an extra
# Markdown fence.
#
# Usage: parse-status <response-file> [field]
#   field: status | reason | spec | objections | all (default: all, prints JSON)
#
# Optional plain-language objections (docs/objection-capture.md): after the reason line, a revising reviewer may add
#   ---OBJECTIONS---
#   - severity: blocker|should-fix|nit
#     what_goes_wrong: <plain sentences: what breaks, for whom, when>
#     where: <section of the draft>
#     fix: <what the replacement spec changed>
# `objections` prints a JSON array ([] when the section is absent or unreadable). It never fails the parse: older
# responses and small models that skip the section keep working.
set -euo pipefail

response_file="${1:?usage: parse-status <response-file> [status|reason|spec|objections|all]}"
field="${2:-all}"

[[ -f "$response_file" ]] || { echo "error: response file not found: $response_file" >&2; exit 1; }

# Marker may sit on its own line or at the end of a Grok planning prefix
# (`...I'll check the HTTP client.---STATUS---`). Status and reason still
# have to be on their own lines after it.
grep -qE -e '^.*---STATUS---$' "$response_file" || {
  echo "error: missing ---STATUS--- marker in response" >&2
  exit 1
}

status="$(grep -m1 -E '^status: (approved|revise)$' "$response_file" | sed -E 's/^status: //')"
reason="$(grep -m1 -E '^reason: .+$' "$response_file" | sed -E 's/^reason: //' || true)"

[[ -n "$status" ]] || { echo "error: missing or invalid status line (expected 'status: approved' or 'status: revise')" >&2; exit 1; }
# Synthesize a fallback reason when the reviewer omitted it but provided a
# valid status — prevents local/small models that follow the status format but
# drop the reason field from causing a hard parse failure.
[[ -n "$reason" ]] || reason="(no reason provided by reviewer)"

spec_block=""
if [[ "$status" == "revise" ]]; then
  # A replacement spec describing a data format or envelope is a completely
  # ordinary thing to illustrate with a nested example code block -- stopping
  # capture at the *first* closing fence after ```spec (as this used to)
  # silently truncates the block right there instead, handing a corrupted,
  # mid-sentence spec to the rest of the pipeline with no error at all. The
  # negotiate prompt requires "the full replacement spec... then nothing
  # else", so the true closing fence is reliably the *last* bare ``` line in
  # the whole response, however many nested fences sit in between.
  start_line="$(grep -n -m1 -E '^```spec[[:space:]]*$' "$response_file" | cut -d: -f1 || true)"
  end_line=""
  if [[ -n "$start_line" ]]; then
    end_line="$(grep -n -E '^```[[:space:]]*$' "$response_file" | tail -1 | cut -d: -f1 || true)"
  fi
  if [[ -n "$start_line" && -n "$end_line" ]] && (( end_line > start_line )); then
    spec_block="$(sed -n "$((start_line + 1)),$((end_line - 1))p" "$response_file")"
  fi
  [[ -n "$spec_block" ]] || {
    echo "error: status: revise requires a fenced \`\`\`spec replacement block" >&2
    exit 1
  }
fi

# Plain-language objections: items between ---OBJECTIONS--- and the spec fence (or the next marker). Bash 3.2 safe.
parse_objections() {
  local on=0 line key val cur_key="" have=0 out="[]" count=0
  local sev="" what="" where_="" fix=""
  flush_item() {
    if [[ $have -eq 1 && $count -lt 10 ]]; then
      case "$(printf '%s' "$sev" | tr 'A-Z_ ' 'a-z--')" in
        blocker) sev="blocker" ;; should-fix|shouldfix) sev="should-fix" ;; nit) sev="nit" ;; *) sev="unrated" ;;
      esac
      out="$(jq -c --arg sev "$sev" --arg what "${what:0:600}" --arg where_ "${where_:0:300}" --arg fix "${fix:0:600}" \
        '. + [{severity: $sev, what_goes_wrong: $what, where: $where_, fix: $fix}]' <<<"$out")"
      count=$((count + 1))
    fi
    sev=""; what=""; where_=""; fix=""; cur_key=""; have=0
  }
  while IFS= read -r line; do
    if [[ $on -eq 0 ]]; then
      [[ "$line" =~ ^---OBJECTIONS---[[:space:]]*$ ]] && on=1
      continue
    fi
    [[ "$line" =~ ^\`\`\` ]] && break
    [[ "$line" =~ ^---[A-Z]+---[[:space:]]*$ ]] && break
    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(severity|what_goes_wrong|where|fix):[[:space:]]*(.*)$ ]]; then
      flush_item; key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"; have=1
    elif [[ "$line" =~ ^[[:space:]]*(severity|what_goes_wrong|where|fix):[[:space:]]*(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"; have=1
    elif [[ -n "${line//[[:space:]]/}" && -n "$cur_key" ]]; then
      key="$cur_key"; val="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//')"
      case "$key" in
        severity) sev="$sev $val" ;; what_goes_wrong) what="$what $val" ;; where) where_="$where_ $val" ;; fix) fix="$fix $val" ;;
      esac
      continue
    else
      continue
    fi
    cur_key="$key"
    case "$key" in
      severity) sev="$val" ;; what_goes_wrong) what="$val" ;; where) where_="$val" ;; fix) fix="$val" ;;
    esac
  done < "$response_file"
  flush_item
  printf '%s\n' "$out"
}

case "$field" in
  status)
    printf '%s\n' "$status"
    ;;
  reason)
    printf '%s\n' "$reason"
    ;;
  objections)
    parse_objections
    ;;
  spec)
    printf '%s\n' "$spec_block"
    ;;
  all)
    jq -n --arg status "$status" --arg reason "$reason" --arg spec "$spec_block" --argjson objections "$(parse_objections)" \
      '{status: $status, reason: $reason, spec: (if $spec == "" then null else $spec end), objections: $objections}'
    ;;
  *)
    echo "error: unknown field: $field (expected status, reason, spec, objections, or all)" >&2
    exit 1
    ;;
esac
