# /etc/e3d-mcp/pilot.env (mode 0640, root:e3dpilot). Never commit a filled-in copy.

# --- listen on loopback only; nginx terminates TLS in front ---
E3D_MCP_HOST=127.0.0.1
E3D_MCP_PORT=8787
E3D_MCP_STATE_DIR=/var/lib/e3d-mcp

# --- who may call: name:token pairs (the name is the budget principal). install.sh generates these. ---
E3D_MCP_AUTH_TOKENS=__GENERATED__

# --- what a caller can do ---
E3D_MCP_HTTP_TOOLS=e3d_debate,e3d_list_providers,e3d_usage
E3D_MCP_PROVIDERS=anthropic-api,openai-api
# Debate panel (hosted). E3D_MCP_ALLOWED_PROVIDERS limits every debate to these vendors. E3D_MCP_REQUIRED_PROVIDERS takes
# part in every debate, first, and its first entry writes the summary; when it is unavailable the debate is refused (nothing
# charged). Both lists must be inside the allowlist; the required list must match billing's PILOT_PANEL_REQUIRED. Unset = off.
# E3D_MCP_ALLOWED_PROVIDERS=anthropic-api,openai-api
# E3D_MCP_REQUIRED_PROVIDERS=anthropic-api

# --- spending limits PER TOKEN NAME (each name gets its own budget; there is no global cap, so keep the list short) ---
E3D_MCP_DAILY_CALLS=20
E3D_MCP_DAILY_EST_TOKENS=150000
E3D_MCP_RATE_PER_MIN=10
E3D_MCP_TIMEOUT_SEC=150
E3D_MCP_MAX_BODY_BYTES=65536

# --- model credentials: the operator's own keys, billed to you ---
ANTHROPIC_API_KEY=__PASTE_ANTHROPIC_KEY__
ANTHROPIC_API_MAX_TOKENS=1024
OPENAI_API_KEY=__PASTE_OPENAI_KEY__
OPENAI_API_MODEL=__PASTE_OPENAI_MODEL_NAME__
OPENAI_API_MAX_TOKENS=1024
# Optional extra vendor families (add gemini-api / xai-api to E3D_MCP_PROVIDERS to use them):
# GEMINI_API_KEY=__PASTE_GEMINI_KEY__
# GEMINI_API_MODEL=__PASTE_GEMINI_MODEL_NAME__
# XAI_API_KEY=__PASTE_XAI_KEY__
# XAI_API_MODEL=__PASTE_XAI_MODEL_NAME__
